@namespace RH_CM.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager Nav

@if (string.IsNullOrWhiteSpace(IframeSrc))
{
    <div class="alert alert-danger mb-0">
        Material URL could not be built. Please contact HR.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-file-pdf text-danger"></i>
                <div>
                    <div class="fw-bold mb-0">Course Material</div>
                    <small class="text-muted">
                        CourseId: @CourseId &nbsp;|&nbsp; LevelId: @LevelId
                        @if (CourseAssignmentId.HasValue && CourseAssignmentId.Value > 0)
                        {
                            <text>&nbsp;|&nbsp; Assignment: @CourseAssignmentId</text>
                        }
                    </small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (!string.IsNullOrWhiteSpace(EffectiveExamUrl))
                {
                    <!-- misma ventana -->
                    <a href="@EffectiveExamUrl" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit"></i> Take Exam
                    </a>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshIframe">
                    <i class="fas fa-sync-alt"></i> Reload
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <iframe id="pdfFrame"
                    src="@IframeSrc"
                    title="Course PDF"
                    style="width:100%; height:@HeightCss; border:0;"
                    loading="lazy">
            </iframe>
        </div>
    </div>
}

@code
{
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int LevelId { get; set; }
    [Parameter] public int? CourseAssignmentId { get; set; }

    /// <summary>
    /// Absolute/relative URL to Catalog/StreamPdfCourseMaterialByCourseLevel?courseId=..&levelId=..
    /// (Se recomienda que OpenPdfCourseMaterialByCourseLevel pase esta URL ya construida)
    /// </summary>
    [Parameter] public string? StreamUrl { get; set; }

    /// <summary>Optional: base URL to start the exam (e.g., "/Trainify/Exam") o ya con querys.</summary>
    [Parameter] public string? ExamUrl { get; set; }

    /// <summary>Viewer height, e.g. "78vh", "calc(100vh - 180px)".</summary>
    [Parameter] public string HeightCss { get; set; } = "78vh";

    private string IframeSrc { get; set; } = string.Empty;
    private string? EffectiveExamUrl { get; set; }

    protected override void OnParametersSet()
    {
        // ---- PDF ----
        var url = StreamUrl?.Trim();
        if (!string.IsNullOrWhiteSpace(url))
        {
            // Si es relativo, conviértelo a absoluto respecto a BaseUri
            if (!Uri.TryCreate(url, UriKind.Absolute, out _))
            {
                var abs = new Uri(new Uri(Nav.BaseUri), url);
                IframeSrc = abs.ToString();
            }
            else
            {
                IframeSrc = url!;
            }
        }
        else
        {
            var baseUri = Nav.BaseUri.TrimEnd('/');
            IframeSrc = $"{baseUri}/Catalog/StreamPdfCourseMaterialByCourseLevel?courseId={CourseId}&levelId={LevelId}";
        }

        // ---- Exam URL ----
        EffectiveExamUrl = BuildExamUrl(ExamUrl);
    }

    private string? BuildExamUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return null;

        // Normaliza a absoluto para manipularlo con UriBuilder si hace falta
        var baseUri = new Uri(Nav.BaseUri);
        var abs = Uri.TryCreate(raw, UriKind.Absolute, out var uAbs) ? uAbs : new Uri(baseUri, raw);

        // Asegura que tenga courseId/levelId; si ya vienen, los respeta.
        IDictionary<string, string?> dict = QueryHelpers.ParseQuery(abs.Query)
            .ToDictionary(k => k.Key, v => (string?)v.Value.ToString());

        if (!dict.ContainsKey("courseId")) dict["courseId"] = CourseId.ToString();
        if (!dict.ContainsKey("levelId")) dict["levelId"] = LevelId.ToString();

        // 👇 agrega CourseAssignmentId si lo tienes
        if (CourseAssignmentId.HasValue && CourseAssignmentId.Value > 0)
            dict["courseAssignmentId"] = CourseAssignmentId.Value.ToString();

        var cleanBase = abs.GetLeftPart(UriPartial.Path);
        return QueryHelpers.AddQueryString(cleanBase, dict);
    }

    private void RefreshIframe()
    {
        // Fuerza recarga del iframe agregando/sustituyendo un query param de timestamp
        var tick = DateTimeOffset.Now.ToUnixTimeMilliseconds();
        var qIndex = IframeSrc.IndexOf('?');
        string path = qIndex >= 0 ? IframeSrc[..qIndex] : IframeSrc;
        string query = qIndex >= 0 ? IframeSrc[qIndex..] : string.Empty;

        // quita _ts anterior si existía
        if (!string.IsNullOrEmpty(query))
        {
            var parts = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            var filtered = parts.Where(p => !p.StartsWith("_ts=", StringComparison.OrdinalIgnoreCase));
            query = string.Join('&', filtered);
            if (!string.IsNullOrEmpty(query))
                query = "?" + query;
        }

        var sep = string.IsNullOrEmpty(query) ? "?" : "&";
        IframeSrc = $"{path}{query}{sep}_ts={tick}";
    }
}
