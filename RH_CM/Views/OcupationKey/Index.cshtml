@model RH_CM.Service.DTOs.OcupationKey.OcupationDTOs

@{
    ViewData["Title"] = "Ocupation Codes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-occupation-key";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Ocupation Codes",
            IconClass = "fa-briefcase",
            HelpBullets = new List<string>
            {
                "Occupation codes link a position to the numeric code used for government/compliance reporting.",
                "Click \"Add Ocupation\" to assign a code to a position, or use the row actions to edit, toggle, or delete an existing one."
            }
        })" />
    </div>
</div>


<div id="tableContainer">
    <div class="card">

        <div class="card-body">
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addOcupationCode" title="Add Ocupation">
                    <i class="align-middle fas fa-plus-square"></i>  Add Ocupation

                </button>
            </div>
            @if (Model != null)
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th>ID</th>
                            <th>Position Name</th>
                            <th>Ocupation Code</th>
                            <th data-orderable="false">Actions</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OcupationsLists)
                        {
                            <tr>
                                <td>@detail.Id</td>
                                <td>@detail.PositionName</td>
                                <td>@detail.OcupationCode</td>

                                <td>
                                    <form asp-action="ToggleOcupationCode" asp-route-id="@detail.Id" method="post" class="d-inline" onsubmit=" return confirm('Are you sure you want to toggle availability?')">
                                        <button type="submit" class="btn @(detail.Available == 1 ? "btn-success" : "btn-secondary")" title="Toggle availability">
                                            <i class="align-middle fas @(detail.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        </form>

                                    <form asp-action="EditOcupationCode" asp-route-Id="@detail.Id" method="get" class="d-inline">
                                        <button type="submit" class="btn btn-warning" title="Edit">
                                            <i class="align-middle fas fa-edit"></i>
                                        </button>
                                    </form>

                                    <form asp-action="DeleteOcupationcode" asp-route-Id="@detail.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Ocupation Code?');">
                                        <button type="submit" class="btn btn-danger" title="Delete">
                                            <i class="align-middle fas fa-window-close"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>


<div class="modal fade" id="addOcupationCode" tabindex="-1" aria-labelledby="addOcupationCodeLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddOcupationCode" asp-controller="OcupationKey" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addOcupationCodeLabel">Add Ocupation Code</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
                </div>
                <div class="modal-body">
                    @* <input type="hidden" name="GroupId" value="@Model.GroupId" /> *@

                    <div class="row mb-3">
                        <!-- Select Position -->

                        <div class="col-md-6">
                            <label for="Position" class="form-label">Select Position</label>
                            <select id="Position" name="Position" class="form-select" required>
                                <option value="">-- Choose Position --</option>
                                @foreach (var position in Model?.PositionsList ?? Enumerable.Empty<RH_CM.Service.DTOs.OcupationKey.Positions>())
                                {
                                    <option value="@position.Position">@position.Position</option>
                                }
                            </select>
                        </div>

                        <!-- Enter Occupation Code -->
                        <div class="col-md-6">
                            <label for="OcupationCode" class="form-label">Enter Occupation Code</label>
                            <input type="number" id="OcupationCode" name="OcupationCode"
                                   class="form-control" min="1" required placeholder="Enter code" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" title="Add Ocupation">Add Ocupation</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 50,
                    lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]]
                });
            }

$('#addOcupationCode').on('shown.bs.modal', function () {
                $('#Position').select2({
                    placeholder: "-- Choose Position --",
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#addOcupationCode') //
                });
            });

        });
    </script>
}
