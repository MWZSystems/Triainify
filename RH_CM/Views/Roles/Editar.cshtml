@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Edit Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-3">
    <div class="col-12 col-md-10 col-lg-8">

        <div class="card border shadow-sm">

            <!-- Header with icon -->
            <div class="card-header bg-light border-bottom">
                <h3 class="card-title mb-0 fw-bold text-dark">
                    <i class="fas fa-user-tag me-2 text-secondary"></i>
                    EDIT ROLE
                </h3>
                <small class="text-muted">
                    Modify the name of the selected role.
                </small>
            </div>

            <div class="card-body">

                <form asp-controller="Roles" asp-action="Editar" method="post">

                    <input type="hidden" asp-for="Id" />

                    @* Show errors only when exist *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All"
                             class="alert alert-danger py-2 mb-3"
                             role="alert"></div>
                    }

                    <div class="row mt-3">
                        <div class="col-sm-8 offset-sm-2">

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">Role Name</label>
                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter the role name" />
                                <span asp-validation-for="Name"
                                      class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-end mt-4">
                                <button type="submit"
                                        class="btn btn-primary px-4" title="Save Changes">
                                    <i class="fas fa-save me-1"></i>
                                    Save Changes
                                </button>
                            </div>

                        </div>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
