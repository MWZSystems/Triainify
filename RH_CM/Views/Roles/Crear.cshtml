@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Create New Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h3 class="card-title text-center">Create New Role</h3>

        <form asp-controller="Roles" asp-action="Crear" method="post">
            <div class="text-danger" asp-validation-summary="All"></div>
            <div class="row mt-4">
                <div class="col-sm-6 offset-3">

                    <div class="mb-3">
                        <label asp-for="Name" class="col-md-3">Role Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter the role name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>


                    <div class="row">
                        <div class="col-sm-10 offset-2">
                            <button type="submit" class="btn btn-success w-75 btn-lg" title="Create Role">Create Role <i class="bi bi-arrow-right-circle-fill"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // DataTables initialization (this view doesn't seem to have a table, but the script is kept)
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });
});
    </script>
}