@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Administrator";
}

<h1 class="text-center">Role Administrator</h1>

<div class="row">
    <div class="col-sm-3 offset-9">
        <a asp-action="Crear" asp-controller="Roles" class="btn btn-primary w-100"><i class="align-middle fas fa-plus-square"></i> Create new Role</a>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
            
                    @if (Model.Count() > 0)
                    {
                        <table id="datatables-reponsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-primary">
                                <tr>
                                    <th>Id</th>
                                    <th>Nombre</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(m => item.Id)</td>
                                        <td>@Html.DisplayFor(m => item.Name)</td>
                                        <td>

                                            <div class="input-group mb-1">
                                                <a class="btn btn-primary" asp-controller="Roles" asp-action="Editar" asp-route-id="@item.Id"><i class="align-middle fas fa-edit"></i> Editar</a>
                                                <form asp-action="Borrar" asp-route-id="@item.Id">
                                                    <button type="submit" onclick="return confirm('Está seguro de borrar este registro?')" class="btn btn-danger"><i class="align-middle fas fa-window-close"></i> Borrar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    }
                    else
                    {
                        <p>No hay registros</p>
                    }
            </div>    
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            //Llamar a datatable
            $('#datatables-responsive').DataTable({
                responsive: true,
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 to 0 of 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "infoPostFix": "",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            // Mostrar mensaje de éxito en el modal
            if ("@TempData["Correcto"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["Correcto"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            // Mostrar mensaje de error en el modal
            if ("@TempData["Error"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["Error"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
}
