@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Administrator";
    ViewData["BodyClass"] = "page-roles";
}

<div class="row mb-3">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Role Administrator",
            IconClass = "fa-user-tag",
            HelpBullets = new List<string>
            {
                "Roles determine what each user can access across the app.",
                "Click \"Create New Role\" to add one, or use the row actions to rename or delete an existing role."
            }
        })" />
    </div>

    <div class="col-auto d-flex align-items-center gap-2">

        <!-- Create new role -->
        <a asp-action="Crear"
           asp-controller="Roles"
           class="btn btn-primary" title="Create New Role">
            <i class="align-middle fas fa-plus-square"></i> Create New Role
        </a>

        <a class="btn btn-outline-success" asp-action="ExportRolesFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>

        <!-- Toggle button to show/hide actions information -->
        <button class="btn btn-outline-info btn-sm"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#infoAlerts"
                aria-expanded="false"
                aria-controls="infoAlerts" title="Actions information">
            <i class="fas fa-info-circle"></i> Actions information
        </button>

    </div>
</div>

<!-- Outline alerts with description of each action (without delete) -->
<div class="collapse mb-3" id="infoAlerts">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Buttons</h5>
            <h6 class="card-subtitle text-muted">Description of main actions.</h6>
        </div>
        <div class="card-body">

            <!-- Create Role -->
            <div class="alert alert-primary alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" title="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-plus-square"></i>
                </div>
                <div class="alert-message">
                    <strong>Create new role:</strong> Opens the form to register a new role in the system.
                </div>
            </div>

            <!-- Edit Role -->
            <div class="alert alert-warning alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" title="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <div class="alert-message">
                    <strong>Edit role:</strong> Allows updating the name of the selected role.
                </div>
            </div>

        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                @if (Model.Any())
                {
                    <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                            <tr>
                                <th class="text-center no-export" data-orderable="false">Actions</th>
                                <th>Id</th>
                                <th>Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <!-- Edit Role (only button visible) -->
                                            <a class="btn btn-warning"
                                               asp-controller="Roles"
                                               asp-action="Editar"
                                               asp-route-id="@item.Id"
                                               title="Edit Role">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            @* Delete button hidden as requested
                                            <form asp-action="Borrar" asp-route-id="@item.Id" method="post">
                                                <button type="submit"
                                                        onclick="return confirm('Are you sure you want to delete this role?')"
                                                        class="btn btn-danger"
                                                        title="Delete Role">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                            *@

                                        </div>

                                    </td>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

});
    </script>
}
