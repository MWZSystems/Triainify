@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Administrator";
}

<h1 class="text-center">Role Administrator</h1>

<!-- Descripción de iconos -->
<div class="alert alert-info text-center">
    <strong>Note:</strong>
    <i class="fas fa-edit text-warning"></i> Edit role &nbsp; | &nbsp;
    <i class="fas fa-trash text-danger"></i> Delete role
</div>

<div class="row mb-3">
    <div class="col-sm-3 offset-9">
        <a asp-action="Crear" asp-controller="Roles" class="btn btn-primary w-100">
            <i class="align-middle fas fa-plus-square"></i> Create New Role
        </a>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                @if (Model.Any())
                {
                    <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                        <thead class="table-primary">
                            <tr>
                                <th>Id</th>
                                <th>Name</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <!-- Botón Editar (icono amarillo) -->
                                            <a class="btn btn-warning"
                                               asp-controller="Roles"
                                               asp-action="Editar"
                                               asp-route-id="@item.Id"
                                               title="Edit Role">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <!-- Botón Borrar (icono trash rojo) -->
                                            <form asp-action="Borrar" asp-route-id="@item.Id" method="post">
                                                <button type="submit"
                                                        onclick="return confirm('Are you sure you want to delete this role?')"
                                                        class="btn btn-danger"
                                                        title="Delete Role">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>

                                        </div>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            if ("@TempData["Correcto"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["Correcto"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if ("@TempData["Error"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["Error"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
