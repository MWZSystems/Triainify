@model RH_CM.Service.DTOs.Permissions.PermissionsDetailDTOs

@{
    ViewData["Title"] = "Group Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-permissions";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a asp-action="Index" asp-controller="Permissions" class="btn btn-secondary" title="Change Group">
            <i class="fas fa-rotate-left"></i> CHANGE GROUP
        </a>
    </div>
</div>


<div id="tableContainer">
    <div class="card">
        <div class="card-header">
            <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                <div class="p-3 fw-bold rounded fs-3">
                    Group ID: @Model.GroupId
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Group Name: @Model.GroupName
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addRoleModal" title="Add Role">
                    <i class="fas fa-plus"></i> Add Role
                </button>
            </div>
            @if (Model != null)
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th>Role ID</th>
                            <th>Role Name</th>
                            <th data-orderable="false">Action</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.Roles)
                        {
                            <tr>
                                <td>@detail.RoleId</td>
                                <td>@detail.RoleName</td>

                                <td>
                                    <form asp-action="DeleteRoleFromGroup" asp-route-RoleId="@detail.RoleId" asp-route-GroupId="@Model.GroupId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this role from this group?');">
                                        <button type="submit" class="btn btn-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>



 <div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddRoleToGroup" asp-controller="Permissions" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Add Role to Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="GroupId" value="@(Model?.GroupId ?? 0)" />

                    <div class="mb-3">
                        <label for="RoleId" class="form-label">Select Role</label>
                        <select id="RoleId" name="RoleId" class="form-select" required>
                            <option value="">-- Choose Role --</option>
                            @foreach (var role in Model?.RolesAvailable ?? Enumerable.Empty<RH_CM.Service.DTOs.Permissions.RolesDTOs>())
                            {
                                <option value="@role.RoleId">@role.RoleName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-success" title="Add">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 50,
                    lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]]
                });
            }

            // Solo success y error
});
    </script>
}
