@model List<RH_CM.Service.DTOs.Permissions.PermissionsIndexDTOs>

@{
    ViewData["Title"] = "Select Permissions Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">

        <div class="card border shadow-sm">

            <!-- Light header with icon, same style as the other modules -->
            <div class="card-header bg-light border-bottom">
                <h3 class="card-title mb-0 fw-bold text-dark">
                    <i class="fas fa-user-shield me-2 text-secondary"></i>
                    SELECT PERMISSIONS GROUP
                </h3>
                <small class="text-muted">
                    Choose a group to review available roles and permissions.
                </small>
            </div>

            <div class="card-body">

                <form asp-action="GroupDetail" method="get">

                    <div class="mb-3 col-md-8">
                        <label for="SelectedGroup" class="form-label fw-semibold">
                            Group <span class="text-danger">*</span>
                        </label>

                        <select id="SelectedGroup" name="SelectedGroup" class="form-control select2"
                                data-placeholder="-- Select Group --">
                            <option></option>
                            @foreach (var item in Model)
                            {
                                <option value="@item.Group">@item.Group</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary px-4" title="Continue">
                        Continue
                    </button>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Inicializa Select2
            $(".select2").select2({
                theme: 'bootstrap4',
                allowClear: true,
                width: '100%'
            });

});
    </script>
}
