@model List<RH_CM.Service.DTOs.Permissions.PermissionGroupSummaryDTOs>

@{
    ViewData["Title"] = "Permissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-permissions";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Permissions",
            IconClass = "fa-user-shield",
            HelpBullets = new List<string>
            {
                "A \"group\" controls which roles can open a specific controller/screen — this is what the \"ViewAccess\" check on every page reads.",
                "Click \"Create New Group\" to register a new screen, then click \"Manage\" to choose which roles can access it.",
                "The \"Roles with access\" column shows how many roles are currently granted a group — 0 means nobody but Administrador can open that screen."
            }
        })" />
    </div>
</div>

<div id="tableContainer">
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-end gap-2 mb-3">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createGroupModal" title="Create New Group">
                    <i class="align-middle fas fa-plus-square"></i> Create New Group
                </button>
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th data-orderable="false" class="no-export">Actions</th>
                            <th>Group Name</th>
                            <th>Controller</th>
                            <th>Roles with access</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-warning btn-sm" asp-action="GroupDetail" asp-route-SelectedGroup="@group.GroupKey" title="Manage roles for this group">
                                        <i class="fas fa-users-cog"></i>
                                    </a>
                                </td>
                                <td>@group.GroupName</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(group.ControllerName))
                                    {
                                        <span class="text-muted fst-italic">Not set</span>
                                    }
                                    else
                                    {
                                        <code>@group.ControllerName</code>
                                    }
                                </td>
                                <td>
                                    @if (group.RoleCount > 0)
                                    {
                                        <span class="badge bg-success">@group.RoleCount role@(group.RoleCount == 1 ? "" : "s")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No roles yet</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No permission groups found. Click "Create New Group" to add the first one.</p>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateGroup" asp-controller="Permissions" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createGroupModalLabel">Create New Permission Group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="groupName" class="form-label">Group Name</label>
                        <input type="text" id="groupName" name="groupName" class="form-control" required
                               placeholder="e.g. Department, Position, Course Assignments" />
                        <div class="form-text">A short, descriptive name so it's easy to find in the list.</div>
                    </div>
                    <div class="mb-3">
                        <label for="controllerName" class="form-label">Controller Name</label>
                        <input type="text" id="controllerName" name="controllerName" class="form-control"
                               placeholder="e.g. Catalog, HeadCount, OcupationKey" />
                        <div class="form-text">
                            The exact controller name behind the new screen (no "Controller" suffix). This is what
                            the "ViewAccess" check compares against on every request — match it exactly.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" title="Create Group">Create Group</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 20,
                    lengthMenu: [[10, 20, 25, 50, 100, -1], [10, 20, 25, 50, 100, "All"]],
                    stateSave: true,
                    dom: window.dtButtonsDom,
                    buttons: window.dtExportButtons()
                });
            }
        });
    </script>
}
