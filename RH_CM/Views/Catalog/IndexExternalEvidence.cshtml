@model IEnumerable<RH_CM.Service.DTOs.ExternalEvidenceDTOs>

@{
    ViewData["Title"] = "External Evidence";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-receipt"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateExternalEvidence" asp-route-type="PDF">
            <i class="align-middle fas fa-plus-square"></i> ADD NEW EVIDENCE
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <output class="spinner-border" style="width: 3rem; height: 3rem;" aria-live="polite">
        <span class="visually-hidden">Loading...</span>
    </output>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    @if (Model != null && Model.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-primary">
                                <tr>
                                    <th>#</th>
                                    <th>User Name</th>
                                    <th>Course Name</th>
                                    <th>Level</th>
                                    <th>Score</th>
                                    <th>Created Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ID</td>
                                        <td>@item.FullName</td>
                                        <td>@item.CourseName</td>
                                        <td>@item.LevelName</td>
                                        <td>@item.Score</td>
                                        <td>@item.CreateDate</td>
                                        <td>@item.Status</td>

                                        <td>
                                            <div class="text-center d-flex gap-1">

                                                <a class="btn btn-info" asp-action="ViewEvidenceMaterial" asp-route-id="@item.ID" target="_blank" title="View PDF">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a class="btn btn-primary" asp-action="DownloadEvidenceMaterial" asp-route-id="@item.ID" title="Download">
                                                    <i class="fas fa-download"></i>
                                                </a>

                                                <form asp-action="ToggleEvidenceMaterial" asp-route-id="@item.ID" method="post" style="display:inline;">
                                                    <button type="submit"
                                                            onclick="return confirm('Are you sure you want to toggle availability of this evidence material?')"
                                                            class="btn @(item.Status == "Enabled" ? "btn-success" : "btn-secondary")"
                                                            title="Toggle availability">
                                                        <i class="fas @(item.Status == "Enabled" ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                                    </button>
                                                </form>
                                                <a class="btn btn-warning" asp-action="EditEvidenceMaterial" asp-route-id="@item.ID" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>

                                                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                                {
                                                    <form asp-action="DeleteEvidenceMaterial" asp-route-id="@item.ID" method="post" style="display:inline;">
                                                        <button type="submit"
                                                                onclick="return confirm('Are you sure you want to delete this evidence material?')"
                                                                class="btn btn-danger"
                                                                title="Delete">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No records found</p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function() {
            $('#tableContainer').hide();
            $('#loader').show();

            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                initComplete: function() {
                    $('#loader').fadeOut(200, function() {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}