@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course Materials";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-course-materials";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="align-middle fas fa-file-pdf"></i> @ViewData["Title"]
        </h1>
    </div>

    <div class="col-auto">
        <a class="btn btn-facebook"
           asp-action="CreateCourseMaterial"
           asp-route-type="PDF">
            <i class="align-middle fas fa-plus-square"></i>
            CREATE PDF MATERIAL
        </a>

        <a class="btn btn-primary"
           asp-action="CreateCourseMaterial"
           asp-route-type="VIDEO">
            <i class="align-middle fas fa-video"></i>
            CREATE VIDEO MATERIAL
        </a>
    </div>
</div>

<div id="loader" class="text-center my-5">
    <div class="spinner-border"
         style="width: 3rem; height: 3rem;"
         role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <table id="datatables-responsive"
                               class="table table-striped table-hover align-middle"
                               style="width:100%">

                            <thead class="table-accent">
                                <tr>
                                    <th>Material Name</th>
                                    <th>Material Type</th>
                                    <th>Course</th>
                                    <th>Level</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.MaterialName</td>
                                        <td>@item.MaterialType</td>
                                        <td>@item.CourseName</td>
                                        <td>@item.LevelName</td>

                                        <td>
                                            <div class="text-center d-flex gap-1 justify-content-center">

                                                @if (item.MaterialType == "VIDEO")
                                                {
                                                    <a class="btn btn-info"
                                                       asp-action="ViewVideoMaterial"
                                                       asp-route-id="@item.PkCoursematerial"
                                                       title="View Video Material">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-info"
                                                       asp-action="ViewPdfCourseMaterial"
                                                       asp-route-id="@item.PkCoursematerial"
                                                       target="_blank"
                                                       title="View PDF">
                                                        <i class="fas fa-eye"></i>
                                                    </a>

                                                    <a class="btn btn-primary"
                                                       asp-action="DownloadCourseMaterial"
                                                       asp-route-id="@item.PkCoursematerial"
                                                       title="Download PDF">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                }

                                                <form asp-action="ToggleCourseMaterial"
                                                      asp-route-id="@item.PkCoursematerial"
                                                      method="post"
                                                      style="display:inline;">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            onclick="return confirm('Are you sure you want to toggle availability of this material?')"
                                                            class="btn @(item.Available == 1 ? "btn-success" : "btn-secondary")"
                                                            title="Toggle availability">
                                                        <i class="fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                                    </button>
                                                </form>

                                                @if (item.MaterialType == "VIDEO")
                                                {
                                                    <a class="btn btn-warning"
                                                       asp-action="EditVIDEOMaterial"
                                                       asp-route-id="@item.PkCoursematerial"
                                                       title="Edit Video Path">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-warning"
                                                       asp-action="EditPDFMaterial"
                                                       asp-route-id="@item.PkCoursematerial"
                                                       title="Edit PDF">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                }

                                                @if (User.Identity?.IsAuthenticated == true &&
                                                     User.IsInRole("Administrador"))
                                                {
                                                    <form asp-action="DeleteCourseMaterial"
                                                          asp-route-id="@item.PkCoursematerial"
                                                          method="post"
                                                          style="display:inline;">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                onclick="return confirm('Are you sure you want to delete this material?')"
                                                                class="btn btn-danger"
                                                                title="Delete">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No records found</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function() {
            $('#tableContainer').hide();
            $('#loader').show();

            const table = $('#datatables-responsive');

            if (table.length) {
                table.DataTable({
                    responsive: true,
                    order: [],
                    initComplete: function() {
                        $('#loader').fadeOut(200, function() {
                            $('#tableContainer').fadeIn(200);
                        });
                    }
                });
            } else {
                $('#loader').hide();
                $('#tableContainer').show();
            }

            const successMessage = @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["SuccessMessage"]?.ToString() ?? string.Empty));

            const errorMessage = @Html.Raw(
                                            System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["ErrorMessage"]?.ToString() ?? string.Empty));

            if (successMessage) {
                window.notyf?.open?.({
                    type: 'success',
                    message: successMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if (errorMessage) {
                window.notyf?.open?.({
                    type: 'error',
                    message: errorMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
