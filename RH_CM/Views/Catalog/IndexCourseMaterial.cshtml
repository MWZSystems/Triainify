@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course Materials";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Clase específica para esta vista
    ViewData["BodyClass"] = "page-course-materials";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="align-middle fas fa-file-pdf"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateCourseMaterial" asp-route-type="PDF">
            <i class="align-middle fas fa-plus-square"></i> CREATE PDF MATERIAL
        </a>
        <a class="btn btn-primary" asp-action="CreateCourseMaterial" asp-route-type="VIDEO">
            <i class="align-middle fas fa-video"></i> CREATE VIDEO MATERIAL
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover align-middle" style="width:100%">
                            <thead class="table-accent">
                                <tr>
                                    <th>Material Name</th>
                                    <th>Material Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.MaterialName</td>
                                        <td>@item.MaterialType</td>
                                        <td>
                                            <div class="text-center d-flex gap-1">
                                                @* Mostrar solo si el tipo NO es VIDEO *@
                                                @if (item.MaterialType != "VIDEO")
                                                {
                                                    <a class="btn btn-info"
                                                       asp-action="ViewPdfCourseMaterial"
                                                       asp-route-id="@item.PkCoursematerial"
                                                       target="_blank"
                                                       title="View PDF">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a class="btn btn-primary"
                                                       asp-action="DownloadCourseMaterial"
                                                       asp-route-id="@item.PkCoursematerial"
                                                       title="Download">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                }

                                                <form asp-action="ToggleCourseMaterial" asp-route-id="@item.PkCoursematerial" method="post" style="display:inline;">
                                                    <button type="submit"
                                                            onclick="return confirm('Are you sure you want to toggle availability of this material?')"
                                                            class="btn @(item.Available == 1 ? "btn-success" : "btn-secondary")"
                                                            title="Toggle availability">
                                                        <i class="fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                                    </button>
                                                </form>

                                                <a class="btn btn-warning"
                                                   asp-action="EditCourseMaterial"
                                                   asp-route-id="@item.PkCoursematerial"
                                                   asp-route-materialType="@item.MaterialType"
                                                   title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>

                                                @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                                                {
                                                    <form asp-action="DeleteCourseMaterial" asp-route-id="@item.PkCoursematerial" method="post" style="display:inline;">
                                                        <button type="submit"
                                                                onclick="return confirm('Are you sure you want to delete this material?')"
                                                                class="btn btn-danger"
                                                                title="Delete">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No records found</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#tableContainer').hide();
            $('#loader').show();

            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
