@model RH_CM.Models.CtCourse

@{
    ViewData["Title"] = "Create Course";
}

<h1 class="h3 mb-3 text-center">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Create Course</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateCourse">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- First Row: Divided into 4 columns -->
                        <div class="mb-2 col-md-3">
                            <label asp-for="ManagementSystem" class="form-label">Management System <span class="text-danger">*</span></label>
                            <select asp-for="ManagementSystem" class="form-control">
                                <option disabled selected>--- SELECT OPTION ---</option>
                                <option value="AMBIENTAL">AMBIENTAL</option>
                                <option value="CALIDAD">CALIDAD</option>
                                <option value="SEGURIDAD">SEGURIDAD</option>
                                <option value="OTROS">OTROS</option>
                            </select>
                            <span asp-validation-for="ManagementSystem" class="text-danger"></span>
                        </div>

                        <div class="mb-2 col-md-3">
                            <label asp-for="Idcourse" class="form-label">Course Code <span class="text-danger">*</span></label>
                            <input asp-for="Idcourse" class="form-control" />
                            <span asp-validation-for="Idcourse" class="text-danger"></span>
                        </div>

                        <div class="mb-2 col-md-3">
                            <label asp-for="CourseValidityDays" class="form-label">Course Validity Days <span class="text-danger">*</span></label>
                            <input asp-for="CourseValidityDays" type="number" class="form-control" min="0" />
                            <span asp-validation-for="CourseValidityDays" class="text-danger"></span>
                        </div>

                        <div class="mb-2 col-md-3">
                            <label asp-for="Revision" class="form-label">Revision <span class="text-danger">*</span></label>
                            <input asp-for="Revision" type="number" class="form-control" min="1" />
                            <span asp-validation-for="Revision" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="row">
                        <!-- Second Row: Single column -->
                        <div class="mb-3 col-md-12">
                            <label asp-for="CourseName" class="form-label">Course Name <span class="text-danger">*</span></label>
                            <input asp-for="CourseName" class="form-control" />
                            <span asp-validation-for="CourseName" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="col-12 text-end">
                        <a asp-action="IndexCourse" class="btn btn-secondary" onclick="return confirm('Are you sure you want to cancel without saving changes?')">
                            <i class="align-middle fas fa-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="align-middle fas fa-plus-square"></i> Create
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Mostrar mensajes de éxito y error si existen
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
}
