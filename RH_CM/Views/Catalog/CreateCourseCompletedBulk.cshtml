@{
    ViewData["Title"] = "Create Course Completed (Bulk)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var headcounts = (IEnumerable<dynamic>)ViewBag.Headcounts;   // filtrados por fkCourse
    var courses    = (IEnumerable<dynamic>)ViewBag.Courses;
    var statuses   = (IEnumerable<dynamic>)ViewBag.CourseStatus;
    var modes      = (IEnumerable<dynamic>)ViewBag.DeliveryModes;
    int selectedFkCourse = (int)(ViewBag.SelectedFkCourse ?? 0);
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">CREATE COURSE COMPLETED (BULK)</h1>
    </div>
</div>

<!-- Selección de curso (GET) -->
<div class="row mb-3">
    <div class="col-md-10 offset-md-1">
        <form method="get" asp-action="CreateCourseCompletedBulk" class="card card-body">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Course <span class="text-danger">*</span></label>
                    <select class="form-control" name="FkCourse" required id="FkCourse">
                        <option value="">-- Select Course --</option>
                        @foreach (var c in courses)
                        {
                            if (c.PkCourse == selectedFkCourse)
                            {
                                <option selected value="@c.PkCourse">@c.CourseName</option>
                            }
                            else
                            {
                                <option value="@c.PkCourse">@c.CourseName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4 text-end">
                    <button type="submit" class="btn btn-primary mt-3 mt-md-0">
                        <i class="fas fa-sync-alt"></i> Load People
                    </button>
                </div>
            </div>
            <small class="text-muted">La lista de personas de abajo se filtra por la <strong>posición</strong> y el <strong>curso</strong> seleccionado.</small>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Course Completed Details (Bulk)</h5>
                <h6 class="card-subtitle text-muted">
                    Selecciona múltiples <strong>Headcounts</strong>. El <em>Course Assignment</em> se resuelve automáticamente por posición y curso.
                </h6>
            </div>

            <div class="card-body">
                <form asp-action="CreateCourseCompletedBulk" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="FkCourse" value="@selectedFkCourse" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <!-- HEADCOUNTS (ya filtrados por curso) -->
                        <div class="mb-3 col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">Headcounts <span class="text-danger">*</span></label>
                                <div class="d-flex gap-2">
                                    <input id="searchHeadcounts" class="form-control form-control-sm" placeholder="Search" style="max-width: 190px;" />
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleAll('SelectedHeadcounts', true)">Select All</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll('SelectedHeadcounts', false)">Clear</button>
                                </div>
                            </div>

                            <div id="hcWrapper" class="border rounded p-2" style="max-height: 360px; overflow:auto">
                                @if (headcounts?.Any() == true)
                                {
                                    foreach (var h in headcounts)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input sel-hc" type="checkbox" name="SelectedHeadcounts" value="@h.PkHeadcount" id="hc_@h.PkHeadcount" />
                                            <label class="form-check-label" for="hc_@h.PkHeadcount">@h.Display</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted">No hay personas relacionadas por posición para este curso.</div>
                                }
                            </div>
                        </div>

                        <!-- METADATA -->
                        <div class="mb-3 col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Course Status <span class="text-danger">*</span></label>
                                <select class="form-control" name="FkCourseStatus" required>
                                    <option value="">-- Select Course Status --</option>
                                    @foreach (var s in statuses)
                                    {
                                        <option value="@s.PkCoursestatus">@s.DescriptionCoursestatus</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Delivery Mode <span class="text-danger">*</span></label>
                                <select class="form-control" name="FkDeliveryMode" required>
                                    <option value="">-- Select Delivery Mode --</option>
                                    @foreach (var d in modes)
                                    {
                                        <option value="@d.Id">@d.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Score (0–100) <span class="text-danger">*</span></label>
                                <input class="form-control" type="number" name="Score" min="0" max="100" step="1" value="100" required />
                            </div>
                        </div>
                    </div>

                    <!-- Contador -->
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <span class="badge bg-info text-dark me-2" id="badge-count-hc">Headcounts seleccionados: 0</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-end">
                            <a asp-action="IndexCourseCompleted" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="align-middle fas fa-plus-square"></i> CREATE BULK
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="card-footer text-muted small">
                Tip: los buscadores son insensibles a acentos y tratan <code>ñ</code> distinto de <code>n</code>.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        function toggleAll(name, check) {
            document.querySelectorAll(`input[name='${name}']`).forEach(el => { el.checked = check; });
            updateCounts();
        }
        function updateCounts() {
            const countHc = document.querySelectorAll("input[name='SelectedHeadcounts']:checked").length;
            document.getElementById("badge-count-hc").textContent = `Headcounts seleccionados: ${countHc}`;
        }
        function foldEs(str) {
            return (str ?? "")
                .toString()
                .toLocaleLowerCase("es")
                .normalize("NFD")
                .replace(/n\u0303/g, "ñ")
                .replace(/[\u0300-\u036f]/g, "");
        }
        function attachFilter(inputId, wrapperSelector) {
            const input = document.getElementById(inputId);
            const wrapper = document.querySelector(wrapperSelector);
            if (!input || !wrapper) return;
            input.addEventListener("input", () => {
                const q = foldEs(input.value);
                wrapper.querySelectorAll(".form-check").forEach(row => {
                    const label = row.querySelector("label");
                    const txt = foldEs(label ? label.textContent : "");
                    row.style.display = txt.includes(q) ? "" : "none";
                });
            });
        }
        attachFilter("searchHeadcounts", "#hcWrapper");
        document.addEventListener("change", (e) => {
            if (e.target && e.target.name === "SelectedHeadcounts") updateCounts();
        });
        $(document).ready(function () {
            updateCounts();
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open({ type: 'success', message: "@TempData["SuccessMessage"]", ripple: true, dismissible: true, position: { x: 'center', y: 'top' }, duration: 5000 });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open({ type: 'error', message: "@TempData["ErrorMessage"]", ripple: true, dismissible: true, position: { x: 'center', y: 'top' }, duration: 5000 });
            }
        });
    </script>
}
