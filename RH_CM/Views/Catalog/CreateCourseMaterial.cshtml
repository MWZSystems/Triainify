@model RH_CM.Models.CtCoursematerial

@{
    ViewData["Title"] = "Create Course Material";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var materialType = ViewBag.Type?.ToString()?.ToUpperInvariant() ?? "PDF";
    var courses = ViewBag.Courses as IEnumerable<dynamic>
        ?? Enumerable.Empty<dynamic>();
    var levels = ViewBag.LevelCourses as IEnumerable<dynamic>
        ?? Enumerable.Empty<dynamic>();
}

<h1 class="h3 mb-3 text-center">
    CREATE @materialType MATERIAL
</h1>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Material Details</h5>
                <h6 class="card-subtitle text-muted">
                    Fill in the fields; those marked with an asterisk (*) are required.
                </h6>
            </div>

            <div class="card-body">
                @if (materialType == "VIDEO")
                {
                    <form asp-action="CreateVideoMaterial" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <div class="row">
                            <div class="mb-2 col-md-4">
                                <label for="materialName" class="form-label">
                                    Material Name
                                    <span class="text-danger">*</span>
                                </label>

                                <input id="materialName"
                                       name="materialName"
                                       type="text"
                                       class="form-control"
                                       maxlength="250"
                                       placeholder="Enter material name"
                                       required />
                            </div>

                            <div class="mb-2 col-md-4">
                                <label for="fkCourse" class="form-label">
                                    Course
                                    <span class="text-danger">*</span>
                                </label>

                                <select id="fkCourse"
                                        name="fkCourse"
                                        class="form-control select2"
                                        required>
                                    <option value="" disabled selected>
                                        --- SELECT COURSE ---
                                    </option>

                                    @foreach (var course in courses)
                                    {
                                        <option value="@course.PkCourse">
                                            @course.CourseName
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-2 col-md-4">
                                <label for="fkLevelCourse" class="form-label">
                                    Level
                                    <span class="text-danger">*</span>
                                </label>

                                <select id="fkLevelCourse"
                                        name="fkLevelCourse"
                                        class="form-control select2"
                                        required>
                                    <option value="" disabled selected>
                                        --- SELECT LEVEL ---
                                    </option>

                                    @foreach (var level in levels)
                                    {
                                        <option value="@level.PkLevelcourse">
                                            @level.DescripctionLevel
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="mb-2 col-12">
                                <label for="filePath" class="form-label">
                                    Video Path
                                    <span class="text-danger">*</span>
                                </label>

                                <input id="filePath"
                                       name="filePath"
                                       type="text"
                                       class="form-control"
                                       placeholder="\\Server\Folder\Video.exe"
                                       required />

                                <small class="form-text text-muted">
                                    Enter the complete network path or URL.
                                </small>
                            </div>
                        </div>

                        <div class="col-12 text-end mt-3">
                            <a asp-action="IndexCourseMaterial"
                               class="btn btn-secondary"
                               onclick="return confirm('Are you sure you want to cancel without saving changes?')">
                                <i class="align-middle fas fa-arrow-left"></i>
                                CANCEL
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="align-middle fas fa-plus-square"></i>
                                CREATE VIDEO MATERIAL
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <form asp-action="CreatePDFMaterial"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <div class="row">
                            <div class="mb-2 col-md-6">
                                <label for="uploadedFiles" class="form-label">
                                    PDF File
                                    <span class="text-danger">*</span>
                                </label>

                                <input id="uploadedFiles"
                                       name="uploadedFiles"
                                       type="file"
                                       class="form-control"
                                       accept=".pdf"
                                       multiple
                                       required />
                            </div>

                            <div class="mb-2 col-md-3">
                                <label for="fkCourse" class="form-label">
                                    Course
                                </label>

                                <select id="fkCourse"
                                        name="fkCourse"
                                        class="form-control select2">
                                    <option value="0" selected>
                                        --- NOT ASSIGNED ---
                                    </option>

                                    @foreach (var course in courses)
                                    {
                                        <option value="@course.PkCourse">
                                            @course.CourseName
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-2 col-md-3">
                                <label for="fkLevelCourse" class="form-label">
                                    Level
                                </label>

                                <select id="fkLevelCourse"
                                        name="fkLevelCourse"
                                        class="form-control select2">
                                    <option value="0" selected>
                                        --- NOT ASSIGNED ---
                                    </option>

                                    @foreach (var level in levels)
                                    {
                                        <option value="@level.PkLevelcourse">
                                            @level.DescripctionLevel
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-12 text-end mt-3">
                            <a asp-action="IndexCourseMaterial"
                               class="btn btn-secondary"
                               onclick="return confirm('Are you sure you want to cancel without saving changes?')">
                                <i class="align-middle fas fa-arrow-left"></i>
                                CANCEL
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="align-middle fas fa-plus-square"></i>
                                UPLOAD PDF MATERIAL
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<input type="hidden"
       id="successMessage"
       value="@TempData["SuccessMessage"]" />

<input type="hidden"
       id="errorMessage"
       value="@TempData["ErrorMessage"]" />

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            $(".select2").select2({
                theme: "bootstrap4",
                placeholder: "Select an option",
                allowClear: true,
                width: "100%"
            });

            const successMessage =
                document.getElementById("successMessage")?.value ?? "";

            const errorMessage =
                document.getElementById("errorMessage")?.value ?? "";

            if (successMessage) {
                window.notyf?.open?.({
                    type: "success",
                    message: successMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: "center", y: "top" },
                    duration: 5000
                });
            }

            if (errorMessage) {
                window.notyf?.open?.({
                    type: "error",
                    message: errorMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: "center", y: "top" },
                    duration: 5000
                });
            }
        });
    </script>
}
