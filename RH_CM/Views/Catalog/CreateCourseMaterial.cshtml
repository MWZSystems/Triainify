@model RH_CM.Models.CtCoursematerial

@{
    ViewData["Title"] = "Create Course Material";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">CREATE COURSE MATERIAL</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">New Material Details</h5>
                <h6 class="card-subtitle text-muted">
                    Complete the fields below. Fields marked with an asterisk (*) are required.
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="CreateCourseMaterial" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- NameMaterial -->
                        <div class="mb-3 col-md-12">
                            <label asp-for="NameMaterial" class="form-label">
                                Material Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NameMaterial" class="form-control" />
                            <span asp-validation-for="NameMaterial" class="text-danger"></span>
                        </div>

                        <!-- Upload File -->
                        <div class="mb-3 col-md-12">
                            <label class="form-label">
                                Upload File (PDF) <span class="text-danger">*</span>
                            </label>
                            <input type="file" name="uploadedFile" class="form-control" accept=".pdf" required />
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="row mt-3">
                        <div class="col-12 text-end">
                            <a asp-action="IndexCourseMaterial" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Create
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(function () {
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
