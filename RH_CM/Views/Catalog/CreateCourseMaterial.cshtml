@model RH_CM.Models.CtCoursematerial

@{
    var type = ViewBag.Type as string;

    var courses = (IEnumerable<RH_CM.Models.CtCourse>)(ViewBag.Courses ?? Enumerable.Empty<RH_CM.Models.CtCourse>());
    var levels = (IEnumerable<RH_CM.Models.CtLevelcourse>)(ViewBag.LevelCourses ?? Enumerable.Empty<RH_CM.Models.CtLevelcourse>());

    ViewData["Title"] = "Create Course Material";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (type == "PDF")
{
    <!-- ======================= PDF ======================= -->
    <div class="row">
        <div class="col">
            <h1 class="h3 mb-3 text-center">CREATE PDF MATERIAL</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">New PDF Material Details</h5>
                    <h6 class="card-subtitle text-muted">
                        Upload one or more PDF files. The PDF Name will be the Material Name!
                    </h6>
                </div>

                <div class="card-body">
                    <form asp-action="CreatePDFMaterial" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- OPTIONAL ASSIGNMENT -->
                        <div class="row">
                            <div class="mb-3 col-md-6">
                                <label class="form-label">Course (optional)</label>
                                <select name="fkCourse" class="form-control select2"
                                        asp-items="@(new SelectList(courses, "PkCourse", "CourseName"))">
                                    <option value="0">-- Select Course --</option>
                                </select>
                            </div>

                            <div class="mb-3 col-md-6">
                                <label class="form-label">Level (optional)</label>
                                <select name="fkLevelCourse" class="form-control select2"
                                        asp-items="@(new SelectList(levels, "PkLevelcourse", "DescripctionLevel"))">
                                    <option value="0">-- Select Level --</option>
                                </select>
                            </div>
                        </div>

                        <!-- Upload Multiple Files -->
                        <div class="mb-3 col-md-12">
                            <label class="form-label">
                                Upload Files (PDF) <span class="text-danger">*</span>
                            </label>
                            <input type="file" name="uploadedFiles" class="form-control" accept=".pdf" multiple required />
                        </div>

                        <!-- Buttons -->
                        <div class="row mt-3">
                            <div class="col-12 text-end">
                                <a asp-action="IndexCourseMaterial" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Upload
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
}
else
{
    <!-- ======================= VIDEO ======================= -->
    <div class="row">
        <div class="col">
            <h1 class="h3 mb-3 text-center">CREATE VIDEO MATERIAL</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">New Video Material Details</h5>
                    <h6 class="card-subtitle text-muted">
                        Please paste the full video Path, include the Extension (.exe, .mp4, etc.)
                    </h6>
                </div>

                <div class="card-body">
                    <form asp-action="CreateVideoMaterial" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- OPTIONAL ASSIGNMENT -->
                        <div class="row">
                            <div class="mb-3 col-md-6">
                                <label class="form-label">Course (optional)</label>
                                <select name="fkCourse" class="form-control select2"
                                        asp-items="@(new SelectList(courses, "PkCourse", "CourseName"))">
                                    <option value="0">-- Select Course --</option>
                                </select>
                            </div>

                            <div class="mb-3 col-md-6">
                                <label class="form-label">Level (optional)</label>
                                <select name="fkLevelCourse" class="form-control select2"
                                        asp-items="@(new SelectList(levels, "PkLevelcourse", "DescripctionLevel"))">
                                    <option value="0">-- Select Level --</option>
                                </select>
                            </div>
                        </div>

                        <!-- Path -->
                        <div class="mb-3 col-md-12">
                            <label class="form-label">
                                Enter the full file path
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="filePath" class="form-control"
                                   placeholder="C:\Videos\curso1.mp4" required />
                        </div>

                        <!-- Buttons -->
                        <div class="row mt-3">
                            <div class="col-12 text-end">
                                <a asp-action="IndexCourseMaterial" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Create
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(function () {

            // Notificaciones
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            // Select2
            $(".select2").select2({
                theme: 'bootstrap4',
                placeholder: 'Select an option',
                allowClear: true
            });

        });
    </script>
}
