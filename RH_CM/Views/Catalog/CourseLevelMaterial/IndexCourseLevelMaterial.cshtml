@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course–Level–Material Links";
    ViewData["BodyClass"] = "page-course-level-material";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Course–Level–Material Links",
            IconClass = "fa-file-signature",
            HelpBullets = new List<string>
            {
                "Connects a Course + Level to the specific material (PDF or video) employees will study.",
                "This is what makes a material actually appear when an employee starts that course/level.",
                "Click \"Create New Link\" to add one; only one PDF and one video are allowed per course/level."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateCourseLevelMaterial" title="Create New Link">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW LINK
        </a>
        <a class="btn btn-success" asp-action="ExportCourseLevelMaterialToExcel" title="Export To Excel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Material</th>
                            <th>Available</th>
                            <th data-orderable="false">Actions</th>
                        </tr>
                    </thead>

                    <!-- Filtros por columna -->
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Material</th>
                            <th>Available</th>
                            <th></th>
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PkCourseLevelMaterial</td>
                                <td>@item.CourseName</td>
                                <td>@item.LevelDescription</td>
                                <td>@item.MaterialName</td>
                                <td>
                                    @{
                                        string availabilityText = item.Available == 1 ? "Yes" : "No";
                                    }
                                    @availabilityText
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <form asp-action="ToggleCourseLevelMaterial" asp-route-id="@item.PkCourseLevelMaterial" method="post" onsubmit="return confirm('Are you sure you want to toggle availability?')">
                                            <button type="submit" class="btn btn-sm @(item.Available == 1 ? "btn-success" : "btn-secondary")" title="Toggle availability">
                                                <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        </form>

                                        <a class="btn btn-sm btn-warning" asp-action="EditCourseLevelMaterial" asp-route-id="@item.PkCourseLevelMaterial" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                        {
                                            <form asp-action="DeleteCourseLevelMaterial" asp-route-id="@item.PkCourseLevelMaterial" method="post" onsubmit="return confirm('Are you sure you want to delete this link?')">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="align-middle fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Hide the table and show the loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Put inputs/selects in the footer before initializing DataTable
            // Indexes: 0:#, 1:Course, 2:Level, 3:Material, 4:Available, 5:Actions
            $('#datatables-responsive tfoot th').each(function (i) {
                switch (i) {
                    case 1: // Course
                    case 2: // Level
                    case 3: // Material
                        $(this).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(i).text() + '" />');
                        break;
                    case 4: // Available (exact Yes/No)
                        $(this).html(
                            '<select class="form-select form-select-sm">' +
                            '<option value="">(All)</option>' +
                            '<option value="^Yes$">Yes</option>' +
                            '<option value="^No$">No</option>' +
                            '</select>'
                        );
                        break;
                    default:
                        $(this).html('');
                        break;
                }
            });

            // Inicializar DataTable
            var table = $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                initComplete: function () {
                    var api = this.api();

                    // Inputs de texto: Course, Level, Material
                    [1, 2, 3].forEach(function (colIdx) {
                        $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    // Exact Yes/No select for Available
                    $('tfoot th').eq(4).find('select').on('change', function () {
                        api.column(4).search(this.value, true, false).draw(); // regex=true, smart=false
                    });

                    // Mostrar la tabla y ocultar el loader
                    $('#loader').fadeOut(150, function () {
                        $('#tableContainer').fadeIn(150);
                    });
                }
            });

            // Notificaciones
});
    </script>
}
