@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course–Level–Material Links";
    ViewData["BodyClass"] = "page-course-level-material";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Course–Level–Material Links",
            IconClass = "fa-file-signature",
            HelpBullets = new List<string>
            {
                "Connects a Course + Level to the specific material (PDF or video) employees will study.",
                "This is what makes a material actually appear when an employee starts that course/level.",
                "Click \"Create New Link\" to add one; only one PDF and one video are allowed per course/level."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateCourseLevelMaterial" title="Create New Link">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW LINK
        </a>
        <a class="btn btn-success" asp-action="ExportCourseLevelMaterialToExcel" title="Export To Excel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
        <a class="btn btn-outline-success" asp-action="ExportCourseLevelMaterialFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th data-orderable="false" class="no-export">Actions</th>
                            <th>#</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Material</th>
                            <th>Available</th>
                        </tr>
                    </thead>

                    <!-- Filtros por columna -->
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>#</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Material</th>
                            <th>Available</th>
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="dropdown row-actions-menu">
                                        <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="fas fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <form asp-action="ToggleCourseLevelMaterial" asp-route-id="@item.PkCourseLevelMaterial" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to toggle availability?">
                                                    <button type="submit" class="dropdown-item @(item.Available == 1 ? "text-success" : "text-secondary")">
                                                        <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>Toggle availability
                                                    </button>
                                                </form>
                                            </li>
                                            <li><a class="dropdown-item text-warning" asp-action="EditCourseLevelMaterial" asp-route-id="@item.PkCourseLevelMaterial"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="DeleteCourseLevelMaterial" asp-route-id="@item.PkCourseLevelMaterial" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this link?">
                                                        <button type="submit" class="dropdown-item text-danger"><i class="align-middle fas fa-trash-alt me-2"></i>Delete</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td>@item.PkCourseLevelMaterial</td>
                                <td>@item.CourseName</td>
                                <td>@item.LevelDescription</td>
                                <td>@item.MaterialName</td>
                                <td>
                                    @{
                                        string availabilityText = item.Available == 1 ? "Yes" : "No";
                                    }
                                    @availabilityText
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Hide the table and show the loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Put inputs/selects in the footer before initializing DataTable
            // Indexes: 0:Actions, 1:#, 2:Course, 3:Level, 4:Material, 5:Available
            $('#datatables-responsive tfoot th').each(function (i) {
                switch (i) {
                    case 2: // Course
                    case 3: // Level
                    case 4: // Material
                        $(this).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(i).text() + '" />');
                        break;
                    case 5: // Available (exact Yes/No)
                        $(this).html(
                            '<select class="form-select form-select-sm">' +
                            '<option value="">(All)</option>' +
                            '<option value="^Yes$">Yes</option>' +
                            '<option value="^No$">No</option>' +
                            '</select>'
                        );
                        break;
                    default:
                        $(this).html('');
                        break;
                }
            });

            // Inicializar DataTable
            var table = $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function () {
                    var api = this.api();

                    // Inputs de texto: Course, Level, Material
                    [2, 3, 4].forEach(function (colIdx) {
                        $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    // Exact Yes/No select for Available
                    $('tfoot th').eq(5).find('select').on('change', function () {
                        api.column(5).search(this.value, true, false).draw(); // regex=true, smart=false
                    });

                    // Mostrar la tabla y ocultar el loader
                    $('#loader').fadeOut(150, function () {
                        $('#tableContainer').fadeIn(150);
                    });
                }
            });

            // Notificaciones
});
    </script>
}
