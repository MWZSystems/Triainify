@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Tests";
    ViewData["BodyClass"] = "page-tests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Tests",
            IconClass = "fa-clipboard-list",
            HelpBullets = new List<string>
            {
                "The diagnostic/exam question bank for each course and level.",
                "Click \"Create New Test\" to write questions and options for a course/level that doesn't have one yet.",
                "A test that has already been answered by users can't be edited or deleted — disable it and create a new one instead."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateQuestions" title="Create New Test">
            <i class="fas fa-plus-square"></i> CREATE NEW TEST
        </a>
        <a class="btn btn-outline-success" asp-action="ExportTestFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Table container -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-accent">
                                <tr>
                                    <th data-orderable="false" class="no-export">Actions</th>
                                    <th>ID</th>
                                    <th>Test Name</th>
                                    <th>Course</th>
                                    <th>Level</th>
                                    @* <th>Created</th> *@
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="dropdown row-actions-menu">
                                                <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                                    <i class="fas fa-ellipsis-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <form asp-action="ToggleTest" asp-route-id="@item.Test.PkTest" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to toggle availability of this Test?">
                                                            <button type="submit" class="dropdown-item @(item.Test.Available == 1 ? "text-success" : "text-secondary")">
                                                                <i class="fas @(item.Test.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>Toggle availability
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li><a class="dropdown-item text-warning" asp-action="EditTest" asp-route-id="@item.Test.PkTest"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                                    <li><a class="dropdown-item text-info" asp-action="EditQuestions" asp-route-id="@item.Test.PkTest"><i class="fas fa-tasks me-2"></i>Edit questions</a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form asp-action="DeleteTest" asp-route-id="@item.Test.PkTest" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this test and all its questions and options?">
                                                            <button type="submit" class="dropdown-item text-danger"><i class="fas fa-trash me-2"></i>Delete</button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                        <td>@item.Test.PkTest</td>
                                        <td>@item.Test.TestName</td>
                                        <td>@item.CourseName</td>
                                        <td>@item.LevelDescription</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No tests found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#tableContainer').hide();
            $('#loader').show();

            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                pageLength: 20,
                lengthMenu: [[10, 20, 25, 50, 100, -1], [10, 20, 25, 50, 100, "All"]],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

});
    </script>
}
