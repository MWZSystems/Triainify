@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course Assignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-outdent"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-primary" asp-action="CreateCourseAssignmentBulk">
            <i class="align-middle fas fa-layer-group"></i> CREATE BULK
        </a>
        <a class="btn btn-facebook" asp-action="CreateCourseAssignment">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW
        </a>
        <a class="btn btn-danger" asp-action="IndexDeleteCourseassignments">
            <i class="align-middle fas fa-trash-alt"></i> DELETE BULK
        </a>
        <a class="btn btn-success" asp-action="ExportCourseAssignmentsToExcel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>Position</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Required</th>
                            <th>Delivery Mode</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <!-- Filtros por columna -->
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>Position</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Required</th>
                            <th>Delivery Mode</th>
                            <th></th>
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PkCourseAssignment</td>
                                <td>@item.PositionName</td>
                                <td>@item.CourseName</td>
                                <td>@item.RequiredCourseLevelDescription</td>
                                <td>@(item.Requiered ? "Yes" : "No")</td>
                                <td>@item.DeliveryModeDescription</td>

                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <form asp-action="ToggleCourseAssignment" asp-route-id="@item.PkCourseAssignment" method="post" onsubmit="return confirm('Are you sure you want to toggle the availability of this course assignment?')">
                                            <button type="submit" class="btn btn-sm @(item.Available == 1 ? "btn-success" : "btn-secondary")" title="Toggle availability">
                                                <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        </form>

                                        <a class="btn btn-sm btn-warning" asp-action="EditCourseAssignment" asp-route-id="@item.PkCourseAssignment" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                                        {
                                            <form asp-action="DeleteCourseAssignment" asp-route-id="@item.PkCourseAssignment" method="post" onsubmit="return confirm('Are you sure you want to delete this course assignment?')">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="align-middle fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Ocultar tabla y mostrar loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Colocar inputs/selects en el footer ANTES de inicializar DataTable
            // Índices de columnas: 0:#, 1:Position, 2:Course, 3:Level, 4:Required, 5:Delivery Mode, 6:Actions
            $('#datatables-responsive tfoot th').each(function (i) {
                switch (i) {
                    case 1: // Position
                    case 2: // Course
                    case 3: // Level
                        $(this).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(i).text() + '" />');
                        break;
                    case 4: // Required (Yes/No exacto)
                        $(this).html(
                            '<select class="form-select form-select-sm">' +
                            '<option value="">(All)</option>' +
                            '<option value="^Yes$">Yes</option>' +
                            '<option value="^No$">No</option>' +
                            '</select>'
                        );
                        break;
                    case 5: // Delivery Mode (select dinámico; se llenará en initComplete)
                        $(this).html('<select id="deliveryModeFilter" class="form-select form-select-sm"><option value="">(All)</option></select>');
                        break;
                    default: // # y Actions sin filtro
                        $(this).html('');
                        break;
                }
            });

            // Inicializar DataTable
            var table = $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                initComplete: function () {
                    var api = this.api();

                    // 1) Inputs de texto (Position, Course, Level)
                    [1, 2, 3].forEach(function (colIdx) {
                        $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    // 2) Select Yes/No exacto para Required
                    $('tfoot th').eq(4).find('select').on('change', function () {
                        api.column(4).search(this.value, true, false).draw(); // regex=true, smart=false
                    });

                    // 3) Select dinámico para Delivery Mode con valores únicos (exact match)
                    var deliveryColumn = api.column(5);
                    var $deliverySelect = $('#deliveryModeFilter');
                    var uniqueValues = [];
                    deliveryColumn.data().each(function (d) {
                        if (d && uniqueValues.indexOf(d) === -1) uniqueValues.push(d);
                    });
                    uniqueValues.sort().forEach(function (val) {
                        var esc = $.fn.dataTable.util.escapeRegex(val);
                        $deliverySelect.append('<option value="^' + esc + '$">' + val + '</option>');
                    });
                    $deliverySelect.on('change', function () {
                        deliveryColumn.search(this.value, true, false).draw();
                    });

                    // Ocultar loader y mostrar tabla cuando DataTable está listo
                    $('#loader').fadeOut(150, function () {
                        $('#tableContainer').fadeIn(150);
                    });
                }
            });

            // Notificaciones
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
