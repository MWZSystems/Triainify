@model IEnumerable<RH_CM.Models.CtPosition>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Position";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Mantén la clase para diferenciar la página (solo usa acento en tabla, no en botones)
    ViewData["BodyClass"] = "page-positions";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-chess-board"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <!-- Botón en AZUL, respetando tu color original -->
        <a class="btn btn-primary" asp-action="CreatePosition">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW POSITION
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla -->
<div id="tableContainer" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="datatables-pos" class="table table-striped table-hover align-middle" style="width:100%">
                        <thead class="table-accent">
                            <tr>
                                <th>@Html.DisplayNameFor(m => m.First().NamePosition)</th>
                                <th>@Html.DisplayNameFor(m => m.First().NamePositionEnglish)</th>
                                <th>Actions</th>
                            </tr>
                            <!-- Filtros por columna -->
                            <tr class="table-light">
                                <th><input class="form-control form-control-sm" placeholder="Position" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Position (EN)" /></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NamePosition</td>
                                    <td>@item.NamePositionEnglish</td>
                                    <td class="actions text-center">
                                        <!-- Botones se quedan en AZUL/AMARILLO/ROJO como tenías -->
                                        <a class="btn btn-warning btn-sm" asp-action="EditPosition" asp-route-id="@item.PkPosition" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                        {
                                            <form asp-action="DeleteConfirmedPosition" asp-route-id="@item.PkPosition" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this position?');">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="align-middle fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Position</th>
                                <th>Position (EN)</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function () {
            // Ocultamos tabla y mostramos loader
            $('#tableContainer').hide();
            $('#loader').show();

            const table = $('#datatables-pos').DataTable({
                responsive: true,
                order: [[0, 'asc']], // Ahora ordena por la columna NamePosition
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]],
                initComplete: function () {
                    const api = this.api();

                    // Filtros por texto: Position, Position (EN)
                    [0, 1].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notificaciones
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
