@model RH_CM.ViewModels.TestCreateViewModel

@{
    ViewData["Title"] = "Edit Test Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">EDIT TEST QUESTIONS</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Test Information</h5>
                <h6 class="card-subtitle text-muted">View-only details. Only text and correct answers can be edited.</h6>
            </div>
            <div class="card-body">
                <form asp-action="EditQuestions" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* FIX: estos campos son de solo lectura visualmente (no tienen "name" en el
                       <input readonly>), así que nunca viajaban de vuelta al servidor. Si una
                       validación fallaba, el controller devolvía la vista con TestName/FkCourse/
                       FkRequiredCourseLevels en null/0, mostrando "N/A" aunque las preguntas sí
                       se hubieran preservado. Con estos hidden el modelo viaja completo en cada
                       POST, así que el re-render tras un error queda idéntico a como estaba. *@
                    <input type="hidden" asp-for="TestName" />
                    <input type="hidden" asp-for="FkCourse" />
                    <input type="hidden" asp-for="FkRequiredCourseLevels" />

                    <!-- Read-only Test Info -->
                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label class="form-label">Test Name</label>
                            <input class="form-control" value="@Model.TestName" readonly />
                        </div>
                        <div class="mb-3 col-md-4">
                            <label class="form-label">Course</label>
                            <input class="form-control" value="@(Model.AvailableCourses?.FirstOrDefault(c => c.PkCourse == Model.FkCourse)?.CourseName ?? "N/A")" readonly />
                        </div>
                        <div class="mb-3 col-md-4">
                            <label class="form-label">Course Level</label>
                            <input class="form-control" value="@(Model.AvailableLevels?.FirstOrDefault(l => l.PkLevelcourse == Model.FkRequiredCourseLevels)?.DescripctionLevel ?? "N/A")" readonly />
                        </div>
                    </div>

                    <hr />

                    <!-- Editable Questions -->
                    <div id="questions-container">
                        @for (int q = 0; q < Model.Questions.Count; q++)
                        {
                            var question = Model.Questions[q];
                            var inputType = question.FkTypeOption == 1 ? "radio" : "checkbox";
                            var typeLabel = inputType == "radio" ? "Single choice" : "Multiple choice";

                            <div class="card mb-3 question-block border border-primary">
                                <div class="card-body">
                                    <h5>Question @(q + 1)</h5>

                                    <!-- Question Text -->
                                    <div class="mb-2">
                                        <input name="Questions[@q].QuestionText" class="form-control" value="@question.QuestionText" />
                                        <input type="hidden" name="Questions[@q].FkTypeOption" value="@question.FkTypeOption" />
                                    </div>

                                    <!-- Info type -->
                                    <div class="mb-2 text-muted small fst-italic">
                                        Option type: @typeLabel
                                    </div>

                                    <!-- Options -->
                                    <div class="options-container">
                                        @for (int o = 0; o < question.Options.Count; o++)
                                        {
                                            var opt = question.Options[o];

                                            <div class="input-group mb-2 align-items-center">
                                                <div class="input-group-text">
                                                    @if (inputType == "radio")
                                                    {
                                                        <!-- Radio único por pregunta -->
                                                        <input type="radio"
                                                               name="Questions[@q].SelectedOptionIndex"
                                                               value="@o"
                                                        @(opt.IsCorrect ? "checked" : "") />

                                                        <input type="hidden" name="Questions[@q].Options[@o].IsCorrect" value="@(opt.IsCorrect ? "true" : "false")" />
                                                    }
                                                    else
                                                    {
                                                        <!-- Checkbox individual -->
                                                        <input type="checkbox"
                                                               class="option-checkbox"
                                                               name="Questions[@q].Options[@o].IsCorrect"
                                                               value="true"
                                                        @(opt.IsCorrect ? "checked" : "") />
                                                    }
                                                </div>
                                                <input name="Questions[@q].Options[@o].OptionText"
                                                       class="form-control"
                                                       value="@opt.OptionText" />
                                            </div>
                                        }
                                    </div>
                                </div> <!-- /.card-body -->
                            </div> <!-- /.card -->
                        }
                    </div> <!-- /#questions-container -->

                    <div class="text-end mt-3">
                        <a asp-action="IndexTest" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div> <!-- /.card-body -->
        </div> <!-- /.card -->
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {

            var successMessage = '@TempData["SuccessMessage"]';
            var errorMessage = '@TempData["ErrorMessage"]';

            if (successMessage && successMessage !== "") {
                window.notyf.open({
                    type: 'success',
                    message: successMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if (errorMessage && errorMessage !== "") {
                window.notyf.open({
                    type: 'error',
                    message: errorMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            // Actualizar hidden de radios para que solo una opción quede en true
            $(document).on("change", "input[type=radio][name^='Questions'][name$='SelectedOptionIndex']", function() {
                const qIndex = $(this).closest(".question-block").index();
                const optionIndex = parseInt($(this).val());

                const options = $(this).closest(".options-container").find("input[type=hidden][name$='.IsCorrect']");
                options.val("false"); // todas en false
                options.eq(optionIndex).val("true"); // solo seleccionada en true
            });

        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
