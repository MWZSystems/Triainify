@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Supervisors";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Nuevo bodyclass para diferenciar esta pantalla
    ViewData["BodyClass"] = "page-supervisors";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-users-cog"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <!-- Botón en AZUL (igual que el original) -->
        <a class="btn btn-primary" asp-action="CreateSupervisor">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW SUPERVISOR
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla -->
<div id="tableContainer" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="datatables-sup" class="table table-striped table-hover align-middle" style="width:100%">
                        <thead class="table-accent">
                            <tr>
                                <th>Control Number</th>
                                <th>Full Name</th>
                                <th>Department</th>
                                <th>Position</th>
                                <th>Actions</th>
                            </tr>
                            <!-- Filtros por columna -->
                            <tr class="table-light">
                                <th><input class="form-control form-control-sm" placeholder="Control Number" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Full Name" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Department" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Position" /></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ControlNumber</td>
                                    <td>@item.FullName</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.PositionName</td>
                                    <td class="text-center">
                                        <form asp-action="ToggleSupervisor" asp-route-id="@item.PkSupervisorId" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to toggle availability of this supervisor?');">
                                            <button type="submit" class="btn btn-sm @(item.Available == 1 ? "btn-success" : "btn-secondary")" title="Toggle availability">
                                                <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        </form>

                                        <a class="btn btn-warning btn-sm" asp-action="EditSupervisor" asp-route-id="@item.PkSupervisorId" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                        {
                                            <form asp-action="DeleteSupervisor" asp-route-id="@item.PkSupervisorId" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this supervisor?');">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="align-middle fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Control Number</th>
                                <th>Full Name</th>
                                <th>Department</th>
                                <th>Position</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function () {
            // Ocultamos tabla y mostramos loader
            $('#tableContainer').hide();
            $('#loader').show();

            const table = $('#datatables-sup').DataTable({
                responsive: true,
                order: [[0, 'asc']],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]],
                language: {
                    decimal: "",
                    emptyTable: "No hay información",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    infoEmpty: "Mostrando 0 a 0 de 0 Entradas",
                    infoFiltered: "(Filtrado de _MAX_ total entradas)",
                    thousands: ",",
                    lengthMenu: "Mostrar _MENU_ Entradas",
                    loadingRecords: "Cargando...",
                    processing: "Procesando...",
                    search: "Buscar:",
                    zeroRecords: "Sin resultados encontrados",
                    paginate: { first: "Primero", last: "Último", next: "Siguiente", previous: "Anterior" }
                },
                initComplete: function () {
                    const api = this.api();

                    // Filtros de texto: Control Number, Full Name, Department, Position
                    [0, 1, 2, 3].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input')
                            .on('keyup change clear', function () {
                                if (api.column(colIdx).search() !== this.value) {
                                    api.column(colIdx).search(this.value).draw();
                                }
                            });
                    });

                    // Mostrar tabla
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notificaciones
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
