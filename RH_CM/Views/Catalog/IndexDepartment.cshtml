@model IEnumerable<RH_CM.Models.CtDepartment>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-store-alt"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateDepartment">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW DEPARTMENT
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla -->
<div id="tableContainer" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="datatables-dept" class="table table-striped table-hover align-middle" style="width:100%">
                        <thead class="table-primary">
                            <tr>
                                <th>@Html.DisplayNameFor(m => m.First().NameDeparment)</th>
                                <th>@Html.DisplayNameFor(m => m.First().Createuser)</th>
                                <th>@Html.DisplayNameFor(m => m.First().Createdate)</th>
                                <th>Actions</th>
                            </tr>
                            <!-- Filtros por columna -->
                            <tr class="table-light">
                                <th><input class="form-control form-control-sm" placeholder="Department" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Created by" /></th>
                                <th><input class="form-control form-control-sm" placeholder="YYYY-MM-DD" /></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NameDeparment</td>
                                    <td>@item.Createuser</td>
                                    <td>@item.Createdate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="actions text-center">
                                        <a class="btn btn-warning btn-sm" asp-action="EditDepartment" asp-route-id="@item.PkDepartment" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                        {
                                            <form asp-action="DeleteDepartment" asp-route-id="@item.PkDepartment" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this department?');">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="align-middle fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Department</th>
                                <th>Created by</th>
                                <th>Created date</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function () {
            // Ocultamos tabla y mostramos loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Inicializamos DataTable
            const table = $('#datatables-dept').DataTable({
                responsive: true,
                order: [[0, 'asc']], // ahora ordena por la columna Department
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                initComplete: function () {
                    const api = this.api();

                    // Filtros por columnas de texto (ahora son 3 columnas filtrables)
                    [0, 1, 2].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    // Mostrar tabla
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notificaciones
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
