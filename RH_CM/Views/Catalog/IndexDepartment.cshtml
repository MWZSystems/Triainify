@model IEnumerable<RH_CM.Models.CtDepartment>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center"><i class="align-middle fas fa-store-alt"></i> @ViewData["Title"]</h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateDepartment">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW DEPARTMENT
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    @if (Model.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-primary">
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.First().PkDepartment)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().NameDeparment)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().Createuser)</th>
                                    <th>@Html.DisplayNameFor(model => model.First().Createdate)</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.PkDepartment</td>
                                        <td>@item.NameDeparment</td>
                                        <td>@item.Createuser</td>
                                        <td>@item.Createdate</td>
                                        <td>
                                            @{
                                                string availabilityText = item.Available switch
                                                {
                                                    1 => "Habilitado",
                                                    0 => "Deshabilitado",
                                                    _ => "Deshabilitado"
                                                };
                                            }
                                            @availabilityText
                                        </td>
                                        <td>
                                            <div class="text-center">
                                                <form asp-action="ToggleDepartment" asp-route-id="@item.PkDepartment" method="post" style="display:inline;">
                                                    <button type="submit" onclick="return confirm('Are you sure you want to toggle the availability of this department?')" class="btn @(item.Available == 1 ? "btn-success" : "btn-secondary")">
                                                        <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                                        @(item.Available == 1 ? "Enable" : "Disable")
                                                    </button>
                                                </form>

                                                <a class="btn btn-warning" asp-action="EditDepartment" asp-route-id="@item.PkDepartment">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                @if (User.Identity.IsAuthenticated && (User.IsInRole("Administrador")))
                                                {
                                                    <form asp-action="DeleteDepartment" asp-route-id="@item.PkDepartment" method="post" style="display:inline;">
                                                        <button type="submit" onclick="return confirm('Are you sure you want to delete this department?')" class="btn btn-danger">
                                                            <i class="align-middle fas fa-trash-alt"></i>
                                                            Delete
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No records found</p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Ocultar tabla y mostrar loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Inicializar DataTable con traducción al español y sin orden automático
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                },
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notificaciones
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
}
