@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Supervisors";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // New bodyclass to differentiate this screen
    ViewData["BodyClass"] = "page-supervisors";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Supervisors",
            IconClass = "fa-users-cog",
            HelpBullets = new List<string>
            {
                "Links an employee (headcount) to a department and position as that team's supervisor.",
                "Click \"Create New Supervisor\" to add one. Only one active supervisor is allowed per employee/department combination."
            }
        })" />
    </div>
    <div class="col-auto">
        <!-- Blue button (same as the original) -->
        <a class="btn btn-primary" asp-action="CreateSupervisor" title="Create New Supervisor">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW SUPERVISOR
        </a>
        <a class="btn btn-outline-success" asp-action="ExportSupervisorFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla -->
<div id="tableContainer" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="datatables-sup" class="table table-striped table-hover align-middle" style="width:100%">
                        <thead class="table-accent">
                            <tr>
                                <th data-orderable="false" class="no-export">Actions</th>
                                <th>Control Number</th>
                                <th>Full Name</th>
                                <th>Department</th>
                                <th>Position</th>
                            </tr>
                            <!-- Filtros por columna -->
                            <tr class="table-light">
                                <th></th>
                                <th><input class="form-control form-control-sm" placeholder="Control Number" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Full Name" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Department" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Position" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        <div class="dropdown row-actions-menu">
                                            <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                                <i class="fas fa-ellipsis-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <form asp-action="ToggleSupervisor" asp-route-id="@item.PkSupervisorId" method="post" class="js-confirm-submit"
                                                          data-confirm-message="Are you sure you want to toggle availability of this supervisor?">
                                                        <button type="submit" class="dropdown-item @(item.Available == 1 ? "text-success" : "text-secondary")">
                                                            <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>Toggle availability
                                                        </button>
                                                    </form>
                                                </li>
                                                <li><a class="dropdown-item text-warning" asp-action="EditSupervisor" asp-route-id="@item.PkSupervisorId"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form asp-action="DeleteSupervisor" asp-route-id="@item.PkSupervisorId" method="post" class="js-confirm-submit"
                                                              data-confirm-message="Are you sure you want to delete this supervisor?">
                                                            <button type="submit" class="dropdown-item text-danger"><i class="align-middle fas fa-trash-alt me-2"></i>Delete</button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                    <td>@item.ControlNumber</td>
                                    <td>@item.FullName</td>
                                    <td>@item.DepartmentName</td>
                                    <td>@item.PositionName</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th>Control Number</th>
                                <th>Full Name</th>
                                <th>Department</th>
                                <th>Position</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function () {
            // Ocultamos tabla y mostramos loader
            $('#tableContainer').hide();
            $('#loader').show();

            const table = $('#datatables-sup').DataTable({
                responsive: true,
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function () {
                    const api = this.api();

                    // Filtros de texto: Control Number, Full Name, Department, Position
                    [1, 2, 3, 4].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input')
                            .on('keyup change clear', function () {
                                if (api.column(colIdx).search() !== this.value) {
                                    api.column(colIdx).search(this.value).draw();
                                }
                            });
                    });

                    // Show the table
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notificaciones
});
    </script>
}
