@model IEnumerable<RH_CM.Models.CtDepartment>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Departments";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Very important: activates the Departments coral palette
    ViewData["BodyClass"] = "page-departments";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Departments",
            IconClass = "fa-store-alt",
            HelpBullets = new List<string>
            {
                "The list of departments used to organize positions and employees.",
                "Click \"Create New Department\" to add one, or use the row actions to rename or enable/disable an existing department."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateDepartment" title="Create New Department">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW DEPARTMENT
        </a>
        <a class="btn btn-outline-success" asp-action="ExportDepartmentFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla -->
<div id="tableContainer" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="datatables-dept" class="table table-striped table-hover align-middle" style="width:100%">
                        <thead class="table-accent">
                            <tr>
                                <th data-orderable="false" class="no-export">Actions</th>
                                <th>@Html.DisplayNameFor(m => m.First().NameDeparment)</th>
                                <th>@Html.DisplayNameFor(m => m.First().Createuser)</th>
                                <th>@Html.DisplayNameFor(m => m.First().Createdate)</th>
                                <th>Status</th>
                            </tr>
                            <!-- Filtros por columna -->
                            <tr class="table-light">
                                <th></th>
                                <th><input class="form-control form-control-sm" placeholder="Department" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Created by" /></th>
                                <th><input class="form-control form-control-sm" placeholder="YYYY-MM-DD" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Enabled / Disabled" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="actions text-center">
                                        <div class="dropdown row-actions-menu">
                                            <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                                <i class="fas fa-ellipsis-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item text-warning" asp-action="EditDepartment" asp-route-id="@item.PkDepartment"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                                {
                                                    <li>
                                                        <form asp-action="ToggleDepartment" asp-route-id="@item.PkDepartment" method="post" class="js-confirm-submit"
                                                              data-confirm-message="@(item.Available == 1 ? "Disable this department? Active employees must be reassigned first." : "Enable this department?")">
                                                            <button type="submit" class="dropdown-item @(item.Available == 1 ? "text-success" : "text-secondary")">
                                                                <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>@(item.Available == 1 ? "Disable" : "Enable")
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form asp-action="DeleteDepartment" asp-route-id="@item.PkDepartment" method="post" class="js-confirm-submit"
                                                              data-confirm-message="Delete this department permanently? It will be blocked if any employee still references it.">
                                                            <button type="submit" class="dropdown-item text-danger"><i class="align-middle fas fa-trash-alt me-2"></i>Delete</button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                    <td>@item.NameDeparment</td>
                                    <td>@item.Createuser</td>
                                    <td>@item.Createdate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <span class="badge @(item.Available == 1 ? "bg-success" : "bg-secondary")">
                                            @(item.Available == 1 ? "Enabled" : "Disabled")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th>Department</th>
                                <th>Created by</th>
                                <th>Created date</th>
                                <th>Status</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function () {
            // Ocultamos tabla y mostramos loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Inicializamos DataTable (ahora la 1ª col es Department)
            const table = $('#datatables-dept').DataTable({
                responsive: true,
                order: [],
                pageLength: 20,
                lengthMenu: [[10, 20, 25, 50, 100, -1], [10, 20, 25, 50, 100, "All"]],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function () {
                    const api = this.api();

                    // Filtros por columnas de texto (3 columnas filtrables)
                    [1, 2, 3, 4].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    // Show the table
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notificaciones
});
    </script>
}
