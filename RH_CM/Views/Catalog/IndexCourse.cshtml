@model IEnumerable<RH_CM.Models.CtCourse>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "COURSE";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-courses";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="align-middle fas fa-book"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateCourse">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW COURSE
        </a>
    </div>
</div>

<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div id="tableContainer" style="display:none;">
    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="datatables-course" class="table table-striped table-hover align-middle" style="width:100%">
                        <thead class="table-accent">
                            <tr>
                                <th>@Html.DisplayNameFor(m => m.First().ManagementSystem)</th>
                                <th>Course</th>
                                <th>@Html.DisplayNameFor(m => m.First().CourseName)</th>
                                <th>@Html.DisplayNameFor(m => m.First().CourseValidityDays)</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                            <tr class="table-light">
                                <th><input class="form-control form-control-sm" placeholder="Management System" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Course ID" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Course Name" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Validity (days)" /></th>
                                <th><input class="form-control form-control-sm" placeholder="Available / Unavailable" /></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var nextAvailable = item.Available == 1 ? 0 : 1;
                                var actionText = item.Available == 1 ? "Disable" : "Enable";

                                <tr>
                                    <td>@item.ManagementSystem</td>
                                    <td>@item.Idcourse</td>
                                    <td>@item.CourseName</td>
                                    <td>@item.CourseValidityDays</td>
                                    <td>
                                        @if (item.Available == 1)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unavailable</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm @(item.Available == 1 ? "btn-success" : "btn-secondary") open-toggle-modal"
                                                    title="@actionText availability"
                                                    data-course-id="@item.PkCourse"
                                                    data-course-name="@item.CourseName"
                                                    data-course-code="@item.Idcourse"
                                                    data-current-available="@item.Available"
                                                    data-next-available="@nextAvailable">
                                                <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        }

                                        <a class="btn btn-warning btn-sm" asp-action="EditCourse" asp-route-id="@item.PkCourse" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                        {
                                            <form asp-action="DeleteCourse" asp-route-id="@item.PkCourse" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this course?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="align-middle fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Management System</th>
                                <th>Course ID</th>
                                <th>Course Name</th>
                                <th>Validity (days)</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="toggleCourseModal" tabindex="-1" role="dialog" aria-labelledby="toggleCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="ToggleCourse" method="post" id="toggleCourseForm">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="toggleCourseModalLabel">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                        Confirm Course Availability Change
                    </h5>
                    <button type="button" class="close btn-close" data-bs-dismiss="modal" aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id" id="modalCourseId" />
                    <input type="hidden" name="available" id="modalAvailable" />
                    <input type="hidden" name="applyToAssignments" id="modalApplyToAssignments" value="false" />

                    <div class="alert alert-warning" role="alert">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <i class="fas fa-exclamation-triangle fa-lg text-warning"></i>
                            </div>
                            <div>
                                <strong id="modalWarningTitle">Warning</strong>
                                <div class="mt-1" id="modalMainMessage"></div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <i class="fas fa-info-circle fa-lg text-info"></i>
                            </div>
                            <div>
                                <strong>Important information</strong>
                                <div class="mt-1" id="modalImpactMessage"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label fw-bold">Choose an option:</label>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="applyOption" id="applyOnlyCourse" value="false" checked>
                            <label class="form-check-label" for="applyOnlyCourse">
                                Apply only to this course
                            </label>
                        </div>

                        <div class="small text-muted ms-4 mb-3" id="onlyCourseHelpText">
                            This change will affect only the selected course.
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="applyOption" id="applyCourseAndAssignments" value="true">
                            <label class="form-check-label" for="applyCourseAndAssignments">
                                Apply to this course and all assigned courses by position
                            </label>
                        </div>

                        <div class="small text-muted ms-4" id="courseAssignmentsHelpText">
                            This change will also affect employees who receive this course according to their position.
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="confirmToggleButton">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#tableContainer').hide();
            $('#loader').show();

            const table = $('#datatables-course').DataTable({
                responsive: true,
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                initComplete: function () {
                    const api = this.api();

                    [0, 1, 2, 3, 4].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input')
                            .on('keyup change clear', function () {
                                if (api.column(colIdx).search() !== this.value) {
                                    api.column(colIdx).search(this.value).draw();
                                }
                            });
                    });

                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            const toggleCourseModalElement = document.getElementById('toggleCourseModal');
            const toggleCourseModal = new bootstrap.Modal(toggleCourseModalElement);

            $(document).on('click', '.open-toggle-modal', function () {
                const courseId = $(this).data('course-id');
                const courseName = $(this).data('course-name');
                const courseCode = $(this).data('course-code');
                const nextAvailable = parseInt($(this).data('next-available'));

                const isEnabling = nextAvailable === 1;
                const actionWord = isEnabling ? 'enable' : 'disable';
                const actionWordPast = isEnabling ? 'enabled' : 'disabled';

                $('#modalCourseId').val(courseId);
                $('#modalAvailable').val(nextAvailable);
                $('#modalApplyToAssignments').val('false');

                $('#applyOnlyCourse').prop('checked', true);
                $('#applyCourseAndAssignments').prop('checked', false);

                $('#modalMainMessage').html(
                    `You are about to <strong>${actionWord}</strong> the course <strong>${courseCode} - ${courseName}</strong>. Please make sure this is the change you want to apply.`
                );

                if (isEnabling) {
                    $('#modalImpactMessage').html(
                        `If you choose <strong>Apply only to this course</strong>, only this course will be enabled.<br><br>
                         If you choose <strong>Apply to this course and all assigned courses by position</strong>, employees who have this course assigned according to their position will see it again.`
                    );

                    $('#onlyCourseHelpText').text('Only the selected course will be enabled.');
                    $('#courseAssignmentsHelpText').text('Employees with this course assigned by position will see it again.');
                    $('#confirmToggleButton').text('Enable');
                } else {
                    $('#modalImpactMessage').html(
                        `If you choose <strong>Apply only to this course</strong>, only this course will be disabled.<br><br>
                         If you choose <strong>Apply to this course and all assigned courses by position</strong>, employees who have this course assigned according to their position will no longer see it.`
                    );

                    $('#onlyCourseHelpText').text('Only the selected course will be disabled.');
                    $('#courseAssignmentsHelpText').text('Employees with this course assigned by position will no longer see it.');
                    $('#confirmToggleButton').text('Disable');
                }

                toggleCourseModal.show();
            });

            $('input[name="applyOption"]').on('change', function () {
                $('#modalApplyToAssignments').val($(this).val());
            });

            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}