@model IEnumerable<RH_CM.Models.CtCourse>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager


@{
    ViewData["Title"] = "COURSE";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center"><i class="align-middle fas fa-book"></i> @ViewData["Title"]</h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateCourse">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW COURSE
        </a>
    </div>
</div>

<div class="row">

    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                @if (Model.Any())
                {
                    <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                        <thead class="table-primary">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.First().PkCourse)</th>
                                <th>@Html.DisplayNameFor(model => model.First().ManagementSystem)</th>
                                <th>@Html.DisplayNameFor(model => model.First().Idcourse)</th>
                                <th>@Html.DisplayNameFor(model => model.First().CourseName)</th>
                                <th>@Html.DisplayNameFor(model => model.First().CourseValidityDays)</th>
                                
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.PkCourse</td>
                                    <td>@item.ManagementSystem</td>
                                    <td>@item.Idcourse</td>
                                    <td>@item.CourseName</td>
                                    <td>@item.CourseValidityDays</td>
                                    
                                    <td>
                                        <div class="text-center">
                                            <!-- Botón para alternar disponibilidad -->
                                            <form asp-action="ToggleCourse" asp-route-id="@item.PkCourse" method="post" style="display:inline;">
                                                <button type="submit" onclick="return confirm('Are you sure you want to toggle the availability of this course?')" class="btn @(item.Available == 1 ? "btn-success" : "btn-secondary")">
                                                    <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                                </button>
                                            </form>

                                            <!-- Botón para editar curso -->
                                            <a class="btn btn-warning" asp-action="EditCourse" asp-route-id="@item.PkCourse">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            @if (User.Identity.IsAuthenticated && (User.IsInRole("Administrador")))
                                            {
                                                <!-- Botón para eliminar curso -->
                                                <form asp-action="DeleteCourse" asp-route-id="@item.PkCourse" method="post" style="display:inline;">
                                                    <button type="submit" onclick="return confirm('Are you sure you want to delete this course?')" class="btn btn-danger">
                                                        <i class="align-middle fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Inicializar DataTable con traducción al español y sin orden automático
            $('#datatables-responsive').DataTable({
                responsive: true,
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            // Mostrar mensajes de éxito y error
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
}

