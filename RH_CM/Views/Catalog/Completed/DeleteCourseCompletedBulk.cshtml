@using Microsoft.AspNetCore.Mvc.Rendering
@using RH_CM.ViewModels

@{
    ViewData["Title"] = "Delete Course Completed (Bulk)";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var rows = (IEnumerable<CourseCompletedRowDtoViewModel>)(ViewBag.CourseCompletedRows ?? new List<CourseCompletedRowDtoViewModel>());
    var courses = (IEnumerable<SelectListItem>)(ViewBag.Courses ?? new List<SelectListItem>());
    var levels = (IEnumerable<SelectListItem>)(ViewBag.Levels ?? new List<SelectListItem>());

    int selectedFkCourse = (int)(ViewBag.SelectedFkCourse ?? 0);
    int selectedFkLevel = (int)(ViewBag.SelectedFkLevel ?? 0);

    bool lockFilters = false;
    bool needFilters = (bool)(ViewBag.NeedFilters ?? (selectedFkCourse <= 0 || selectedFkLevel <= 0));
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">DELETE COURSE COMPLETED (BULK)</h1>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <form method="get" asp-action="DeleteCourseCompletedBulk" class="card card-body" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Course <span class="text-danger">*</span></label>
                    <select class="form-control select2"
                            name="fkCourse"
                            id="FkCourse"
                            @(lockFilters ? "disabled" : "")>
                        <option value="">-- Select Course --</option>
                        @foreach (var c in courses)
                        {
                            <option value="@c.Value" selected="@(c.Selected ? "selected" : null)">@c.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Required Level <span class="text-danger">*</span></label>
                    <select class="form-control select2"
                            name="fkLevel"
                            id="FkLevel"
                            @(lockFilters ? "disabled" : "")>
                        <option value="">-- Select Level --</option>
                        @foreach (var l in levels)
                        {
                            <option value="@l.Value" selected="@(l.Selected ? "selected" : null)">@l.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 align-self-end">
                    <button type="submit" class="btn btn-primary w-100" id="btnSearch" title="Search">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>

                <div class="col-md-2 align-self-end">
                    <a href="@Url.Action("DeleteCourseCompletedBulk")" class="btn btn-outline-secondary w-100" title="Clear">
                        <i class="fas fa-undo"></i> Clear
                    </a>
                </div>
            </div>

            @if (needFilters)
            {
                <div class="alert alert-warning mt-3 mb-0" role="alert">
                    You must select <strong>Course</strong> and <strong>Required Level</strong> to display results.
                </div>
            }
            else
            {
                <small class="text-muted mt-2 d-block">
                    You can refine the search by selecting a different course or level.
                </small>
            }
        </form>
    </div>
</div>

@if (!needFilters)
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0">Course Completed Found</h5>
                        <div class="card-subtitle text-muted">Select multiple records to delete.</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <input id="searchRows" class="form-control form-control-sm" placeholder="Search" style="max-width: 220px;" />
                        <span class="badge bg-info text-dark" id="badge-count-rows">Selected: 0</span>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-action="DeleteCourseCompletedBulk" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="FkCourse" value="@selectedFkCourse" />
                        <input type="hidden" name="FkLevel" value="@selectedFkLevel" />

                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:44px;">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   onclick="toggleAll('SelectedCourseCompletedIds', this.checked)" />
                                        </th>
                                        <th>Control #</th>
                                        <th>Name</th>
                                        <th>Course</th>
                                        <th>Level</th>
                                        <th>Status</th>
                                        <th>Mode</th>
                                        <th class="text-end">Score</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody id="rowsWrapper">
                                    @if (rows.Any())
                                    {
                                        foreach (var r in rows)
                                        {
                                            <tr class="data-row">
                                                <td>
                                                    <input class="form-check-input sel-row"
                                                           type="checkbox"
                                                           name="SelectedCourseCompletedIds"
                                                           value="@r.PkCourseCompleted"
                                                           onchange="updateCounts()" />
                                                </td>
                                                <td class="col-control">@r.HeadcountControlNumber</td>
                                                <td class="col-name">@r.HeadcountFullName</td>
                                                <td class="col-course">@r.CourseName</td>
                                                <td class="col-level">@r.LevelName</td>
                                                <td class="col-status">@r.StatusName</td>
                                                <td class="col-mode">@r.DeliveryModeName</td>
                                                <td class="col-score text-end">@r.Score</td>
                                                <td class="col-date">@r.CreateDate.ToString("yyyy-MM-dd")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-muted">No records were found with the selected filters.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="text-end">
                            <a asp-action="IndexCourseCompleted" class="btn btn-secondary" title="Cancel">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger" title="Delete Bulk">
                                <i class="fas fa-trash-alt"></i> DELETE BULK
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer text-muted small">
                    Tip: the search ignores accents and treats <code>ñ</code> differently from <code>n</code>.
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        function toggleAll(name, check) {
            document.querySelectorAll(`input[name='${name}']`).forEach(el => {
                el.checked = check;
            });
            updateCounts();
        }

        function updateCounts() {
            const count = document.querySelectorAll("input[name='SelectedCourseCompletedIds']:checked").length;
            const badge = document.getElementById('badge-count-rows');
            if (badge) {
                badge.textContent = `Selected: ${count}`;
            }
        }

        function foldEs(str) {
            return (str ?? '')
                .toString()
                .toLocaleLowerCase('es')
                .normalize('NFD')
                .replace(/n\u0303/g, 'ñ')
                .replace(/[\u0300-\u036f]/g, '');
        }

        function attachFilter(inputId, tbodySelector) {
            const input = document.getElementById(inputId);
            const tbody = document.querySelector(tbodySelector);

            if (!input || !tbody) return;

            input.addEventListener('input', () => {
                const q = foldEs(input.value);
                tbody.querySelectorAll('tr.data-row').forEach(row => {
                    const text = foldEs(row.innerText);
                    row.style.display = text.includes(q) ? '' : 'none';
                });
            });
        }

        function hasValue(v) {
            return v !== null && v !== undefined && v !== '' && v !== '0';
        }

        function toggleSearchButton() {
            const courseVal = $('#FkCourse').val();
            const levelVal = $('#FkLevel').val();
            const enabled = hasValue(courseVal) && hasValue(levelVal);
            $('#btnSearch').prop('disabled', !enabled);
        }

        $(document).ready(function () {
            updateCounts();
            attachFilter('searchRows', '#rowsWrapper');

            $('.select2').select2({
                theme: 'bootstrap4',
                placeholder: 'Select an option',
                allowClear: true,
                width: '100%'
            });

            // When course changes:
            // 1. Clear selected level
            // 2. Submit the form by GET
            // 3. Controller reloads only valid levels for that course
            $('#FkCourse').on('change', function () {
                $('#FkLevel').val('').trigger('change');
                $('#filterForm').submit();
            });

            $('#FkCourse, #FkLevel').on('change', function () {
                toggleSearchButton();
            });

            toggleSearchButton();

});
    </script>
}