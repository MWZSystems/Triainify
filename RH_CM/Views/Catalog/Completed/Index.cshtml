@model IEnumerable<RH_CM.ViewModels.CourseCompletedViewModel>

@{
    ViewData["Title"] = "Course Completed (Detail)";
    ViewData["BodyClass"] = "page-coursecompleted-detail";
}

<partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
{
    Title = "Course Completed (Detail)",
    IconClass = "fa-tasks",
    HelpBullets = new List<string>
    {
        "A row-by-row list of every course-completion record, with its status, delivery mode, and score.",
        "For a summarized, filterable view instead, see \"Course Completed\" (Summary) under Catalog."
    }
})" />

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>PK</th>
            <th>Assignment</th>
            <th>Status</th>
            <th>Delivery Mode</th>
            <th>Headcount</th>
            <th>Score</th>
            <th>Create User</th>
            <th>Create Date</th>
            <th>Last Update User</th>
            <th>Last Update Date</th>
            <th>Available</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PkCourseCompleted</td>
                <td>@item.FkCourseAssignment</td>
                <td>@item.FkCourseStatus</td>
                <td>@item.FkDeliveryMode</td>
                <td>@item.FkHeadcount</td>
                <td>@item.Score</td>
                <td>@item.CreateUser</td>
                <td>@item.CreateDate.ToString("yyyy-MM-dd")</td>
                <td>@item.LastUpdateUser</td>
                <td>@item.LastUpdateDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Avaialble</td>
            </tr>
        }
    </tbody>
</table>
