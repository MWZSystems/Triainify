@model RH_CM.ViewModels.SubmitTestViewModel

@{
    ViewData["Title"] = "Answer Test";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">TEST: @Model.TestName</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-body">
                <form asp-action="SubmitTest" method="post">
                    <input type="hidden" asp-for="FkTest" />

                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var question = Model.Questions[i];
                        var inputType = question.IsMultiple ? "checkbox" : "radio";

                        <div class="card mb-3 border border-primary">
                            <div class="card-body">
                                <h5>Question @(i + 1): @question.QuestionText</h5>

                                <input type="hidden" name="Questions[@i].FkQuestion" value="@question.FkQuestion" />
                                <input type="hidden" name="Questions[@i].QuestionText" value="@question.QuestionText" />
                                <input type="hidden" name="Questions[@i].IsMultiple" value="@question.IsMultiple" />

                                @for (int j = 0; j < question.Options.Count; j++)
                                {
                                    var option = question.Options[j];
                                    var inputId = $"q_{i}_opt_{j}";

                                    <div class="form-check">
                                        <input type="@inputType"
                                               class="form-check-input"
                                               id="@inputId"
                                               name="Questions[@i].Options[@j].IsSelected"
                                               value="true" />
                                        <input type="hidden" name="Questions[@i].Options[@j].FkOption" value="@option.FkOption" />
                                        <input type="hidden" name="Questions[@i].Options[@j].OptionText" value="@option.OptionText" />

                                        <label class="form-check-label" for="@inputId">
                                            @option.OptionText
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="text-end mt-3">
                        <a asp-action="IndexTest" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Submit Answers</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
