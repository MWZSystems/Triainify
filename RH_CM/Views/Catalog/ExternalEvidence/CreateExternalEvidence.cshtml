@model RH_CM.Service.DTOs.CreateExternalEvidenceDTOs

@using Microsoft.AspNetCore.Identity
@using RH_CM.Service.DTOs
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Create External Evidence";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var feedbackItems = ViewBag.FeedbackItems as List<ExternalEvidenceFeedbackItemDTOs>;
    bool hasFeedbackDetail = feedbackItems != null && feedbackItems.Any();

    // Read TempData once, here — unconditionally, regardless of which UI ends up using it.
    // TempData is only cleared when it's actually read during the request that receives it;
    // reading it inside a narrower "if" would leave it unread on some paths, and an unread
    // value survives into the NEXT page the user visits and pops up there instead of here.
    string successMessage = TempData["SuccessMessage"] as string ?? "";
    string errorMessage = TempData["ErrorMessage"] as string ?? "";
    bool hasError = !string.IsNullOrEmpty(errorMessage);
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">CREATE EXTERNAL EVIDENCE</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">External Evidence Details</h5>
                <h6 class="card-subtitle text-muted">
                    Please select <strong>User(s)</strong>, a <strong>Course</strong>, and a <strong>Level</strong>.
                    Then assign a <em>Score</em> between 0 and 100.
                </h6>
            </div>

            <div class="card-body">

                @if (hasError)
                {
                    <div class="alert alert-danger alert-outline alert-dismissible mb-3" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" title="Close"></button>
                        <div class="alert-icon">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="alert-message">
                            @if (hasFeedbackDetail)
                            {
                                var errorItems = feedbackItems!.Where(f => !f.Success).ToList();
                                var successItems = feedbackItems!.Where(f => f.Success).ToList();

                                <h4 class="alert-heading">
                                    @errorItems.Count of @feedbackItems!.Count selected record(s) could not be assigned
                                </h4>
                                <p class="mb-2">
                                    @if (successItems.Count > 0)
                                    {
                                        <text>@successItems.Count record(s) were added successfully. </text>
                                    }
                                    Review the detail below to see exactly which user, course, and level failed and why.
                                    This panel stays open until you close it — click the <strong>X</strong> above once you've reviewed it.
                                </p>
                                <hr>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-0 bg-white">
                                        <thead>
                                            <tr>
                                                <th>Control Number</th>
                                                <th>Full Name</th>
                                                <th>Position</th>
                                                <th>Course</th>
                                                <th>Level</th>
                                                <th>Result</th>
                                                <th>Detail</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in feedbackItems!)
                                            {
                                                <tr class="@(item.Success ? "table-success" : "table-danger")">
                                                    <td>@item.ControlNumber</td>
                                                    <td>@item.FullName</td>
                                                    <td>@item.PositionName</td>
                                                    <td>@item.CourseName</td>
                                                    <td>@item.Level</td>
                                                    <td>
                                                        @if (item.Success)
                                                        {
                                                            <span class="badge bg-success">Added</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">Not added</span>
                                                        }
                                                    </td>
                                                    <td>@item.FeedBackComment</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <h4 class="alert-heading">@errorMessage</h4>
                                <p class="mb-0">
                                    This panel stays open until you close it — click the <strong>X</strong> above once you've reviewed it.
                                </p>
                            }
                        </div>
                    </div>
                }

                <form asp-action="CreateExternalEvidence" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- COURSE + LEVEL en fila -->
                    <div class="row mb-3">
                        <!-- COURSE -->
                        <div class="col-md-6">
                            <label for="SelectedCourse" class="form-label fw-bold">Course <span class="text-danger">*</span></label>
                            <select id="SelectedCourse" class="form-control select2" name="SelectedCourse" required>
                                <option value="">-- Select Course --</option>
                                @if (Model.Course != null && Model.Course.Any())
                                {
                                    foreach (var c in Model.Course)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- LEVEL -->
                        <div class="col-md-6">
                            <label for="SelectedLevel" class="form-label fw-bold">Level <span class="text-danger">*</span></label>
                            <select id="SelectedLevel" class="form-control" name="SelectedLevel" required>
                                <option value="">-- Select Level --</option>
                                @if (Model.Level != null && Model.Level.Any())
                                {
                                    foreach (var l in Model.Level)
                                    {
                                        <option value="@l">@l</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- USERS -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold mb-0" id="usersGroupLabel">Users <span class="text-danger">*</span></label>
                            <div>
                                <label for="searchUsers" class="visually-hidden">Search User</label>
                                <input id="searchUsers" class="form-control form-control-sm" placeholder="Search User..." style="max-width: 200px;" />
                            </div>
                        </div>

                        <div id="userWrapper" class="border rounded p-2" role="group" aria-labelledby="usersGroupLabel" style="max-height: 300px; overflow:auto">
                            @if (Model.User != null && Model.User.Any())
                            {
                                foreach (var u in Model.User)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input sel-user" type="checkbox" name="SelectedUsers" value="@u" id="user_@u" />
                                        <label class="form-check-label" for="user_@u">@u</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No users available.</p>
                            }
                        </div>
                    </div>

                    <!-- SCORE -->
                    <div class="mb-3">
                        <label for="Score" class="form-label fw-bold">Score <span class="text-danger">*</span></label>
                        <input id="Score"
                               type="number"
                               name="Score"
                               class="form-control"
                               step="0.01"
                               min="0.00"
                               max="100.00"
                               placeholder="0.00 - 100.00"
                               required />
                        <small class="form-text text-muted">Allowed range: 0.00 – 100.00</small>
                    </div>

                    <!-- Upload only one File -->
                    <div class="mb-3 col-md-12">
                        <label for="uploadedFile" class="form-label">
                            Upload File (PDF) <span class="text-danger">*</span>
                        </label>
                        <input id="uploadedFile" type="file" name="uploadedFile" class="form-control" accept=".pdf" required />
                    </div>

                    <!-- ACTIONS -->
                    <div class="text-end">
                        <a asp-action="IndexExternalEvidence" class="btn btn-secondary" title="Cancel">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary" title="Save">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // --- Accent-insensitive search filter for Users ---
        function foldEs(str) {
            return (str ?? "")
                .toString()
                .toLocaleLowerCase("es")
                .normalize("NFD")
                .replace(/n\u0303/g, "\u00f1") // \u00f1 aware
                .replace(/[\u0300-\u036f]/g, ""); // remove other diacritics
        }

        // Select2
        $('.select2').select2({ theme: 'bootstrap4', placeholder: 'Select an option', allowClear: true });

        document.getElementById("searchUsers")?.addEventListener("input", function() {
            const q = foldEs(this.value);
            document.querySelectorAll("#userWrapper .form-check").forEach(row => {
                const label = row.querySelector("label");
                const txt = foldEs(label ? label.textContent : "");
                row.style.display = txt.includes(q) ? "" : "none";
            });
        });
    </script>
}