@model IEnumerable<RH_CM.Service.DTOs.ExternalEvidenceDTOs>

@{
    ViewData["Title"] = "External Evidence";
    ViewData["BodyClass"] = "page-external-evidence";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "External Evidence",
            IconClass = "fa-receipt",
            HelpBullets = new List<string>
            {
                "Proof of training completed outside the system (an external certificate or PDF) attached to an employee's record.",
                "Click \"Add New Evidence\" to upload a PDF and link it to the employee and course it supports."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateExternalEvidence" asp-route-type="PDF" title="Add New Evidence">
            <i class="align-middle fas fa-plus-square"></i> ADD NEW EVIDENCE
        </a>
        <a class="btn btn-outline-success" asp-action="ExportExternalEvidenceFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <output class="spinner-border" style="width: 3rem; height: 3rem;" aria-live="polite">
        <span class="visually-hidden">Loading...</span>
    </output>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-accent">
                                <tr>
                                    <th data-orderable="false" class="no-export">Actions</th>
                                    <th>#</th>
                                    <th>User Name</th>
                                    <th>Course Name</th>
                                    <th>Level</th>
                                    <th>Score</th>
                                    <th>Created Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="dropdown row-actions-menu">
                                                <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                                    <i class="fas fa-ellipsis-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item text-info" asp-action="ViewEvidenceMaterial" asp-route-id="@item.ID" target="_blank"><i class="fas fa-eye me-2"></i>View PDF</a></li>
                                                    <li><a class="dropdown-item text-info" asp-action="DownloadEvidenceMaterial" asp-route-id="@item.ID"><i class="fas fa-download me-2"></i>Download</a></li>
                                                    <li>
                                                        <form asp-action="ToggleEvidenceMaterial" asp-route-id="@item.ID" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to toggle availability of this evidence material?">
                                                            <button type="submit" class="dropdown-item @(item.Status == "Enabled" ? "text-success" : "text-secondary")">
                                                                <i class="fas @(item.Status == "Enabled" ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>@(item.Status == "Enabled" ? "Disable" : "Enable")
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li><a class="dropdown-item text-warning" asp-action="EditEvidenceMaterial" asp-route-id="@item.ID"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form asp-action="DeleteEvidenceMaterial" asp-route-id="@item.ID" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this evidence material?">
                                                                <button type="submit" class="dropdown-item text-danger"><i class="fas fa-trash-alt me-2"></i>Delete</button>
                                                            </form>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                        <td>@item.ID</td>
                                        <td>@item.FullName</td>
                                        <td>@item.CourseName</td>
                                        <td>@item.LevelName</td>
                                        <td>@item.Score</td>
                                        <td>@item.CreateDate</td>
                                        <td>@item.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <p>No records found</p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function() {
            $('#tableContainer').hide();
            $('#loader').show();

            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                pageLength: 20,
                lengthMenu: [[10, 20, 25, 50, 100, -1], [10, 20, 25, 50, 100, "All"]],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function() {
                    $('#loader').fadeOut(200, function() {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

});
    </script>
}
