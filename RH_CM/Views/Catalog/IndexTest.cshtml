@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Tests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center"><i class="fas fa-clipboard-list"></i> @ViewData["Title"]</h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateQuestions">
            <i class="fas fa-plus-square"></i> CREATE NEW TEST
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Table container -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-primary">
                                <tr>
                                    <th>ID</th>
                                    <th>Test Name</th>
                                    <th>Course</th>
                                    <th>Level</th>
                                    <th>Actions</th>
                                    @* <th>Created</th> *@
                                    @* <th>Actions</th> *@
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Test.PkTest</td>
                                        <td>@item.Test.TestName</td>
                                        <td>@item.CourseName</td>
                                        <td>@item.LevelDescription</td>
                                        @* <td>@(item.Test.Available == 1 ? "Enabled" : "Disabled")</td> *@
                                        @* <td>@item.Test.Createdate.ToString("dd/MM/yyyy")</td> *@
                                        <td>
                                            <a class="btn btn-warning" asp-action="EditTest" asp-route-id="@item.Test.PkTest">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            
                                            <a class="btn btn-info" asp-action="EditQuestions" asp-route-id="@item.Test.PkTest">
                                                <i class="fas fa-tasks"></i> 
                                            </a>

                                            <form asp-action="DeleteTest" asp-route-id="@item.Test.PkTest" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this test and all its questions and options?');">
                                                <button type="submit" class="btn btn-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No tests found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#tableContainer').hide();
            $('#loader').show();

            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                },
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            if ("@TempData["SuccessMessage"]") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
