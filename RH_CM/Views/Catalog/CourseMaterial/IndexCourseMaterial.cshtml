@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course Materials";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-course-materials";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Course Materials",
            IconClass = "fa-file-pdf",
            HelpBullets = new List<string>
            {
                "The library of PDF and video materials employees study before taking a course's exam.",
                "Use \"Create PDF Material\" to upload a file, or \"Create Video Material\" to link an external video URL.",
                "A material only becomes visible to employees once it's linked to a Course + Level (see \"Course–Level–Material\")."
            }
        })" />
    </div>

    <div class="col-auto">
        <a class="btn btn-facebook"
           asp-action="CreateCourseMaterial"
           asp-route-type="PDF" title="Create Pdf Material">
            <i class="align-middle fas fa-plus-square"></i>
            CREATE PDF MATERIAL
        </a>

        <a class="btn btn-primary"
           asp-action="CreateCourseMaterial"
           asp-route-type="VIDEO" title="Create Video Material">
            <i class="align-middle fas fa-video"></i>
            CREATE VIDEO MATERIAL
        </a>
        <a class="btn btn-outline-success" asp-action="ExportCourseMaterialFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<div id="loader" class="text-center my-5">
    <div class="spinner-border"
         style="width: 3rem; height: 3rem;"
         role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <table id="datatables-responsive"
                               class="table table-striped table-hover align-middle"
                               style="width:100%">

                            <thead class="table-accent">
                                <tr>
                                    <th data-orderable="false" class="no-export">Actions</th>
                                    <th>Material Name</th>
                                    <th>Material Type</th>
                                    <th>Course</th>
                                    <th>Level</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="dropdown row-actions-menu">
                                                <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                                    <i class="fas fa-ellipsis-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    @if (item.MaterialType == "VIDEO")
                                                    {
                                                        <li><a class="dropdown-item text-info" asp-action="ViewVideoMaterial" asp-route-id="@item.PkCoursematerial"><i class="fas fa-eye me-2"></i>View Video Material</a></li>
                                                    }
                                                    else
                                                    {
                                                        <li><a class="dropdown-item text-info" asp-action="ViewPdfCourseMaterial" asp-route-id="@item.PkCoursematerial" target="_blank"><i class="fas fa-eye me-2"></i>View PDF</a></li>
                                                        <li><a class="dropdown-item text-info" asp-action="DownloadCourseMaterial" asp-route-id="@item.PkCoursematerial"><i class="fas fa-download me-2"></i>Download PDF</a></li>
                                                    }
                                                    <li>
                                                        <form asp-action="ToggleCourseMaterial" asp-route-id="@item.PkCoursematerial" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to toggle availability of this material?">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item @(item.Available == 1 ? "text-success" : "text-secondary")">
                                                                <i class="fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>Toggle availability
                                                            </button>
                                                        </form>
                                                    </li>
                                                    @if (item.MaterialType == "VIDEO")
                                                    {
                                                        <li><a class="dropdown-item text-warning" asp-action="EditVIDEOMaterial" asp-route-id="@item.PkCoursematerial"><i class="fas fa-edit me-2"></i>Edit Video Path</a></li>
                                                    }
                                                    else
                                                    {
                                                        <li><a class="dropdown-item text-warning" asp-action="EditPDFMaterial" asp-route-id="@item.PkCoursematerial"><i class="fas fa-edit me-2"></i>Edit PDF</a></li>
                                                    }
                                                    @if (User.Identity?.IsAuthenticated == true &&
                                                         User.IsInRole("Administrador"))
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form asp-action="DeleteCourseMaterial" asp-route-id="@item.PkCoursematerial" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this material?">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="dropdown-item text-danger"><i class="fas fa-trash-alt me-2"></i>Delete</button>
                                                            </form>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                        <td>@item.MaterialName</td>
                                        <td>@item.MaterialType</td>
                                        <td>@item.CourseName</td>
                                        <td>@item.LevelName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No records found</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function() {
            $('#tableContainer').hide();
            $('#loader').show();

            const table = $('#datatables-responsive');

            if (table.length) {
                table.DataTable({
                    responsive: true,
                    order: [],
                    stateSave: true,
                    dom: window.dtButtonsDom,
                    buttons: window.dtExportButtons(),
                    initComplete: function() {
                        $('#loader').fadeOut(200, function() {
                            $('#tableContainer').fadeIn(200);
                        });
                    }
                });
            } else {
                $('#loader').hide();
                $('#tableContainer').show();
            }

        });
    </script>
}
