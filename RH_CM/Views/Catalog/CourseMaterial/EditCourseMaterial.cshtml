@model RH_CM.Models.CtCoursematerial

@{
    ViewData["Title"] = "Edit Course Material";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var assignedCourses = ViewBag.AssignedCourses as IEnumerable<string>
        ?? Enumerable.Empty<string>();
}

@if (Model.MaterialType == "PDF")
{
    <h1 class="h3 mb-3 text-center">
        EDIT PDF MATERIAL - ID: @Model.PkCoursematerial
    </h1>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Edit Material Details</h5>
                    <h6 class="card-subtitle text-muted">
                        Upload a new PDF only when the current file needs to be replaced.
                    </h6>
                </div>

                <div class="card-body">
                    <form asp-action="EditPDFMaterial"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.PkCoursematerial)

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <div class="row">
                            <div class="mb-2 col-md-12">
                                <label for="uploadedFile" class="form-label">
                                    Upload New File (PDF)
                                </label>

                                <input id="uploadedFile"
                                       type="file"
                                       name="uploadedFile"
                                       class="form-control"
                                       accept=".pdf" />

                                <small class="form-text text-muted">
                                    Leave empty to keep the current file.
                                </small>
                            </div>
                        </div>

                        <div class="col-12 text-end mt-3">
                            <a asp-action="IndexCourseMaterial"
                               class="btn btn-secondary"
                               onclick="return confirm('Are you sure you want to cancel without saving changes?')" title="Cancel">
                                <i class="align-middle fas fa-arrow-left"></i>
                                CANCEL
                            </a>

                            <button type="submit" class="btn btn-primary" title="Update Pdf Material">
                                <i class="align-middle fas fa-save"></i>
                                UPDATE PDF MATERIAL
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h1 class="h3 mb-3 text-center">
        EDIT VIDEO MATERIAL - ID: @Model.PkCoursematerial
    </h1>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Edit Video Material Details</h5>
                    <h6 class="card-subtitle text-muted">
                        Only the video path can be modified.
                    </h6>
                </div>

                <div class="card-body">
                    <form asp-action="EditVIDEOMaterial" method="post">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.PkCoursematerial)

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <div class="row">
                            <div class="mb-2 col-md-4">
                                <label asp-for="NameMaterial" class="form-label">
                                    Material Name
                                </label>

                                <input asp-for="NameMaterial"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="mb-2 col-md-4">
                                <div id="assignedCoursesLabel"
                                     class="form-label">
                                    Assigned Courses
                                </div>

                                <select id="assignedCourses"
                                        class="form-control select2"
                                        aria-labelledby="assignedCoursesLabel"
                                        disabled>
                                    @if (assignedCourses.Any())
                                    {
                                        @foreach (var courseName in assignedCourses)
                                        {
                                            <option selected>@courseName</option>
                                        }
                                    }
                                    else
                                    {
                                        <option selected>Not Assigned</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-2 col-md-4">
                                <label for="filePath" class="form-label">
                                    Video Path
                                    <span class="text-danger">*</span>
                                </label>

                                <input id="filePath"
                                       name="filePath"
                                       type="text"
                                       class="form-control"
                                       value="@Model.UrlPath"
                                       required />
                            </div>
                        </div>

                        <div class="col-12 text-end mt-3">
                            <a asp-action="IndexCourseMaterial"
                               class="btn btn-secondary"
                               onclick="return confirm('Are you sure you want to cancel without saving changes?')" title="Cancel">
                                <i class="align-middle fas fa-arrow-left"></i>
                                CANCEL
                            </a>

                            <button type="submit" class="btn btn-primary" title="Update Video Path">
                                <i class="align-middle fas fa-save"></i>
                                UPDATE VIDEO PATH
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            $(".select2").select2({
                theme: "bootstrap4",
                placeholder: "Select an option",
                allowClear: true,
                width: "100%"
            });

        });
    </script>
}
