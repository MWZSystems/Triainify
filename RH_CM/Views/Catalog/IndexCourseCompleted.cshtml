@model IEnumerable<RH_CM.ViewModels.CourseCompletedSummaryItemViewModel>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course Completed (Summary)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Ajuste general para fuente y tabla */
    .card-body {
        font-size: 1.05rem; /* ligeramente más grande para mejor lectura */
    }

    #tbl-coursecompleted thead th {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: center; /* Encabezados centrados */
    }

    /* Estilo general para celdas del body */
    #tbl-coursecompleted tbody td {
        font-size: 1.05rem;
        padding: 12px 8px;
        text-align: center; /* Centramos todas las columnas */
    }

        /* Course a la izquierda */
        #tbl-coursecompleted tbody td.col-course {
            text-align: left !important;
        }

    #tbl-coursecompleted tbody tr:hover {
        background-color: #f1f5f9; /* tono claro al pasar el mouse */
    }

    /* Total columna centrada y destacada */
    #tbl-coursecompleted td.col-total {
        font-weight: 600;
        text-align: center !important;
    }

    /* Botones en el header */
    .header-actions .btn {
        font-size: 0.9rem;
        padding: 6px 12px;
    }
</style>

<div class="row mb-3">
    <div class="col">
        <h1 class="h3 mb-0 text-center">
            <i class="align-middle fas fa-outdent"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto d-flex gap-2 header-actions">
        <a class="btn btn-primary" asp-action="CreateCourseCompletedBulk">
            <i class="align-middle fas fa-layer-group"></i> CREATE BULK
        </a>
        <a class="btn btn-facebook" asp-action="CreateCourseCompleted">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW
        </a>
        <a class="btn btn-danger" asp-action="DeleteCourseCompletedBulk">
            <i class="align-middle fas fa-trash-alt"></i> DELETE BULK
        </a>
        <a class="btn btn-success" asp-action="ExportCourseCompletedToExcel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table id="tbl-coursecompleted" class="table table-hover align-middle table-bordered" style="width:100%">
                    <thead class="table-primary">
                        <tr>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Delivery</th>
                            <th>Status</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="col-course">@x.CourseName</td>
                                <td>@x.LevelName</td>
                                <td>@x.DeliveryModeName</td>
                                <td>@x.Course_Status</td>
                                <td class="col-total">@x.TotalCompletions</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="mb-0 text-muted">No records found</p>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            $('#tbl-coursecompleted').DataTable({
                responsive: true,
                order: [[0, 'asc'], [1, 'asc'], [2, 'asc'], [3, 'asc']],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]],
                language: {
                    search: "Filter:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_",
                    paginate: {
                        previous: "&laquo;",
                        next: "&raquo;"
                    }
                }
            });

            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    duration: 5000,
                    position: { x: 'center', y: 'top' }
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    duration: 5000,
                    position: { x: 'center', y: 'top' }
                });
            }
        });
    </script>
}
