@model RH_CM.Models.CtCourseassignment

@{
    ViewData["Title"] = "Create Course Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">CREATE COURSE ASSIGNMENT</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Course Assignment Details</h5>
                <h6 class="card-subtitle text-muted">Fill in the fields below. Fields marked with an asterisk (*) are required.</h6>
            </div>
            <div class="card-body">
                <form asp-action="CreateCourseAssignment" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- First Row -->
                    <div class="row">
                        <div class="mb-3 col-md-2">
                            <label asp-for="FkPosition" class="form-label">Position <span class="text-danger">*</span></label>
                            <select asp-for="FkPosition" class="form-control select2" asp-items="@(new SelectList(ViewBag.Positions, "PkPosition", "NamePosition"))">
                                <option value="">-- Select Position --</option>
                            </select>
                            <span asp-validation-for="FkPosition" class="text-danger"></span>
                        </div>

                        <div class="mb-3 col-md-3">
                            <label asp-for="FkCourse" class="form-label">Course <span class="text-danger">*</span></label>
                            <select asp-for="FkCourse" class="form-control select2" asp-items="@(new SelectList(ViewBag.Courses, "PkCourse", "CourseName"))">
                                <option value="">-- Select Course --</option>
                            </select>
                            <span asp-validation-for="FkCourse" class="text-danger"></span>
                        </div>

                        <div class="mb-3 col-md-2">
                            <label asp-for="FkRequiredCourseLevels" class="form-label">Course Level <span class="text-danger">*</span></label>
                            <select asp-for="FkRequiredCourseLevels" class="form-control select2" asp-items="@(new SelectList(ViewBag.LevelCourses, "PkLevelcourse", "DescripctionLevel"))">
                                <option value="">-- Select Level --</option>
                            </select>
                            <span asp-validation-for="FkRequiredCourseLevels" class="text-danger"></span>
                        </div>

                        <div class="mb-3 col-md-2">
                            <label asp-for="FkDeliveryMode" class="form-label">Delivery Mode <span class="text-danger">*</span></label>
                            <select asp-for="FkDeliveryMode" class="form-control select2" asp-items="@(new SelectList(ViewBag.DeliveryModes, "PkDeliverymode", "DescriptionDeliverymode"))">
                                <option value="">-- Select Delivery Mode --</option>
                            </select>
                            <span asp-validation-for="FkDeliveryMode" class="text-danger"></span>
                        </div>

                        <div class="mb-3 col-md-3">
                            <label asp-for="Requiered" class="form-label">Required</label>
                            <div class="form-check">
                                <input asp-for="Requiered" class="form-check-input" type="checkbox" />
                                <label asp-for="Requiered" class="form-check-label">Is Required?</label>
                            </div>
                            <span asp-validation-for="Requiered" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Submit and Cancel Buttons -->
                    <div class="row">
                        <div class="col-12 text-end">
                            <a asp-action="IndexCourseassignments" class="btn btn-secondary" title="Cancel">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" title="Create">
                                <i class="align-middle fas fa-plus-square"></i> CREATE
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {

            // Initialize Select2 for all dropdowns
            $(".select2").select2({
                theme: 'bootstrap4',
                placeholder: 'Select an option',
                allowClear: true
            });

});
    </script>
}