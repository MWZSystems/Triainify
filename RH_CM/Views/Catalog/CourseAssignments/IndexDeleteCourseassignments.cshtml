@model IEnumerable<RH_CM.ViewModels.CourseAssignmentListItemViewModel>

@{
    ViewData["Title"] = "Delete Course Assignments (Bulk)";
    ViewData["BodyClass"] = "page-course-assignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Delete Course Assignments (Bulk)",
            IconClass = "fa-trash-alt",
            HelpBullets = new List<string>
            {
                "Filter the list by column, check the rows you want to remove, then click \"Delete selected\".",
                "This permanently removes those course assignments — use it carefully, there's no undo.",
                "Go back to \"Course Assignments\" from the menu to create new ones instead."
            }
        })" />
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card border border-danger">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-0">Assignments list</h5>
                    <h6 class="card-subtitle text-muted">
                        Filter by column and select rows to <strong>Delete selected</strong>.
                    </h6>
                </div>
                <div class="text-end">
                    <a asp-action="IndexCourseassignments" class="btn btn-primary" title="Back To Course Assignments">
                        <i class="align-middle fas fa-outdent"></i> BACK TO COURSE ASSIGNMENTS
                    </a>
                    <a class="btn btn-outline-success" asp-action="ExportCourseAssignmentsFullData" title="Export the complete database data for this catalog, for validation purposes">
                        <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
                    </a>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="DeleteCourseAssignmentsBulk" method="post" id="bulkDeleteForm" class="js-confirm-submit" data-confirm-message="Delete the selected records?">
                    @Html.AntiForgeryToken()

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="submit" class="btn btn-danger" id="btnDelete"
                                disabled title="Delete selected">
                            <i class="fas fa-trash-alt"></i> Delete selected
                            <span class="badge bg-light text-dark ms-2" id="selectedCount">0</span>
                        </button>

                        <button type="button" class="btn btn-outline-secondary" id="btnClearSelection" title="Clear selection">
                            Clear selection
                        </button>

                        <button type="button" class="btn btn-outline-secondary" id="btnClearFilters" title="Clear filters">
                            Clear filters
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-sm align-middle mb-0" id="assignmentsTable">
                            <thead class="table-danger">
                                <tr>
                                    <th style="width:48px; text-align:center;">Sel.</th>
                                    <th>Position</th>
                                    <th>Course</th>
                                    <th>Level</th>
                                    <th>Level ID</th> <!-- NEW -->
                                    <th>Required</th>
                                    <th>Available</th>
                                    <th>Delivery</th>
                                </tr>
                                <!-- Filter row -->
                                <tr class="table-warning">
                                    <th></th>
                                    <th>
                                        <input id="filterPosition" class="form-control form-control-sm" placeholder="Filter Position" />
                                    </th>
                                    <th>
                                        <input id="filterCourse" class="form-control form-control-sm" placeholder="Filter Course" />
                                    </th>
                                    <th>
                                        <input id="filterLevel" class="form-control form-control-sm" placeholder="Filter Level" />
                                    </th>
                                    <th>
                                        <input id="filterLevelId" type="number" class="form-control form-control-sm" placeholder="ID" />
                                    </th>
                                    <th>
                                        <select id="filterRequired" class="form-select form-select-sm">
                                            <option value="">(All)</option>
                                            <option value="yes">Yes</option>
                                            <option value="no">No</option>
                                        </select>
                                    </th>
                                    <th>
                                        <div class="d-flex gap-1">
                                            <input id="filterAvailMin" type="number" class="form-control form-control-sm" placeholder="Min" style="max-width:90px;" />
                                            <input id="filterAvailMax" type="number" class="form-control form-control-sm" placeholder="Max" style="max-width:90px;" />
                                        </div>
                                    </th>
                                    <th>
                                        <input id="filterDelivery" class="form-control form-control-sm" placeholder="Filter Delivery" />
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td style="text-align:center;">
                                                <input type="checkbox" name="selectedIds" value="@item.PkCourseAssignment" class="row-check form-check-input" />
                                            </td>
                                            <td class="col-position">@item.PositionName</td>
                                            <td class="col-course">@item.CourseName</td>
                                            <td class="col-level">@item.RequiredCourseLevelDescription</td>
                                            <td class="col-level-id">@item.FkRequiredCourseLevels</td> <!-- NEW -->
                                            <td class="col-required">@(item.Requiered ? "Yes" : "No")</td>
                                            <td class="col-available">@item.Available</td>
                                            <td class="col-delivery">@item.DeliveryModeDescription</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center">No records found.</td> <!-- 8 columns -->
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>

            <div class="card-footer text-muted small">
                Tip: you can combine per-column filters with selection to delete in bulk.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Notyf notifications
        $(document).ready(function () {
});

        // Selection & counter
        (function () {
            const btnDelete = document.getElementById('btnDelete');
            const btnClearSelection = document.getElementById('btnClearSelection');
            const selectedCount = document.getElementById('selectedCount');

            const updateSelectionState = () => {
                const checks = document.querySelectorAll('input.row-check');
                let selected = 0;
                checks.forEach(c => selected += c.checked ? 1 : 0);
                selectedCount.textContent = selected;
                btnDelete.disabled = selected === 0;
            };

            const clearSelection = () => {
                document.querySelectorAll('input.row-check').forEach(c => c.checked = false);
                updateSelectionState();
            };

            document.addEventListener('change', (e) => {
                if (e.target.classList.contains('row-check')) {
                    updateSelectionState();
                }
            });

            if (btnClearSelection) btnClearSelection.addEventListener('click', clearSelection);

            updateSelectionState();
        })();

        // Client-side column filters
        (function () {
            const tb = document.querySelector('#assignmentsTable tbody');

            const el = id => document.getElementById(id);
            const fPosition   = el('filterPosition');
            const fCourse     = el('filterCourse');
            const fLevel      = el('filterLevel');
            const fLevelId    = el('filterLevelId');   // NEW
            const fRequired   = el('filterRequired');
            const fAvailMin   = el('filterAvailMin');
            const fAvailMax   = el('filterAvailMax');
            const fDelivery   = el('filterDelivery');
            const btnClearFilters = el('btnClearFilters');

            const norm = s => (s ?? '').toString().trim().toLowerCase();

            function passText(cellText, filterText) {
                return norm(cellText).includes(norm(filterText));
            }

            function passRequired(cellText, filterVal) {
                if (!filterVal) return true; // (All)
                const v = norm(cellText);
                return (filterVal === 'yes' && v === 'yes') || (filterVal === 'no' && v === 'no');
            }

            function passNumber(cellText, minStr, maxStr) {
                const n = parseFloat((cellText ?? '').toString().replace(',', '.'));
                if (isNaN(n)) return false; // non-numeric cell => hide
                const hasMin = (minStr ?? '') !== '';
                const hasMax = (maxStr ?? '') !== '';
                const min = hasMin ? parseFloat(minStr) : -Infinity;
                const max = hasMax ? parseFloat(maxStr) : Infinity;
                if (hasMin && isNaN(min)) return true; // ignore bad min
                if (hasMax && isNaN(max)) return true; // ignore bad max
                return n >= min && n <= max;
            }

            // Exact numeric match (for Level ID)
            function passNumberEquals(cellText, filterVal) {
                if ((filterVal ?? '') === '') return true;
                const a = parseInt((cellText ?? '').toString(), 10);
                const b = parseInt(filterVal, 10);
                if (isNaN(a) || isNaN(b)) return false;
                return a === b;
            }

            function applyFilters() {
                const rows = tb.querySelectorAll('tr');

                rows.forEach(tr => {
                    const tPosition  = tr.querySelector('.col-position')?.textContent ?? '';
                    const tCourse    = tr.querySelector('.col-course')?.textContent ?? '';
                    const tLevel     = tr.querySelector('.col-level')?.textContent ?? '';
                    const tLevelId   = tr.querySelector('.col-level-id')?.textContent ?? ''; // NEW
                    const tRequired  = tr.querySelector('.col-required')?.textContent ?? '';
                    const tAvailable = tr.querySelector('.col-available')?.textContent ?? '';
                    const tDelivery  = tr.querySelector('.col-delivery')?.textContent ?? '';

                    const ok =
                        passText(tPosition, fPosition.value) &&
                        passText(tCourse, fCourse.value) &&
                        passText(tLevel, fLevel.value) &&
                        passNumberEquals(tLevelId, fLevelId.value) &&   // NEW
                        passRequired(tRequired, fRequired.value) &&
                        passNumber(tAvailable, fAvailMin.value, fAvailMax.value) &&
                        passText(tDelivery, fDelivery.value);

                    tr.style.display = ok ? '' : 'none';
                });
            }

            // Listeners
            [fPosition, fCourse, fLevel, fDelivery].forEach(input => {
                input?.addEventListener('input', applyFilters);
            });
            fLevelId?.addEventListener('input', applyFilters); // NEW
            fRequired?.addEventListener('change', applyFilters);
            fAvailMin?.addEventListener('input', applyFilters);
            fAvailMax?.addEventListener('input', applyFilters);

            btnClearFilters?.addEventListener('click', () => {
                [fPosition, fCourse, fLevel, fDelivery].forEach(i => i.value = '');
                if (fLevelId) fLevelId.value = '';              // NEW
                fRequired.value = '';
                fAvailMin.value = '';
                fAvailMax.value = '';
                applyFilters();
            });

            // Initial
            applyFilters();
        })();
    </script>
}
