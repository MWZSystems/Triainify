@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course Assignments";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Specific class to activate the lavender-gray style
    ViewData["BodyClass"] = "page-course-assignments";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Course Assignments",
            IconClass = "fa-outdent",
            HelpBullets = new List<string>
            {
                "Defines which courses are required for each position, at which level, and how they're delivered.",
                "Use \"Create New\" for a single assignment, or \"Create Bulk\" to assign several courses to several positions at once.",
                "\"Delete Bulk\" opens a separate screen to remove multiple assignments in one go."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-primary" asp-action="CreateCourseAssignmentBulk" title="Create Bulk">
            <i class="align-middle fas fa-layer-group"></i> CREATE BULK
        </a>
        <a class="btn btn-facebook" asp-action="CreateCourseAssignment" title="Create New">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW
        </a>
        <a class="btn btn-danger" asp-action="IndexDeleteCourseassignments" title="Delete Bulk">
            <i class="align-middle fas fa-trash-alt"></i> DELETE BULK
        </a>
        <a class="btn btn-success" asp-action="ExportCourseAssignmentsToExcel" title="Export To Excel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
        <a class="btn btn-outline-success" asp-action="ExportCourseAssignmentsFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th data-orderable="false" class="no-export">Actions</th>
                            <th>#</th>
                            <th>Position</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Required</th>
                            <th>Delivery Mode</th>
                        </tr>
                    </thead>

                    <tfoot>
                        <tr>
                            <th></th>
                            <th>#</th>
                            <th>Position</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Required</th>
                            <th>Delivery Mode</th>
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="dropdown row-actions-menu">
                                        <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="fas fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <form asp-action="ToggleCourseAssignment" asp-route-id="@item.PkCourseAssignment" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to toggle the availability of this course assignment?">
                                                    <button type="submit" class="dropdown-item @(item.Available == 1 ? "text-success" : "text-secondary")">
                                                        <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>Toggle availability
                                                    </button>
                                                </form>
                                            </li>
                                            <li><a class="dropdown-item text-warning" asp-action="EditCourseAssignment" asp-route-id="@item.PkCourseAssignment"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="DeleteCourseAssignment" asp-route-id="@item.PkCourseAssignment" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this course assignment?">
                                                        <button type="submit" class="dropdown-item text-danger"><i class="align-middle fas fa-trash-alt me-2"></i>Delete</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td>@item.PkCourseAssignment</td>
                                <td>@item.PositionName</td>
                                <td>@item.CourseName</td>
                                <td>@item.RequiredCourseLevelDescription</td>
                                <td>@(item.Requiered ? "Yes" : "No")</td>
                                <td>@item.DeliveryModeDescription</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#tableContainer').hide();
            $('#loader').show();

            $('#datatables-responsive tfoot th').each(function (i) {
                switch (i) {
                    case 2:
                    case 3:
                    case 4:
                        $(this).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(i).text() + '" />');
                        break;
                    case 5:
                        $(this).html(
                            '<select class="form-select form-select-sm">' +
                            '<option value="">(All)</option>' +
                            '<option value="^Yes$">Yes</option>' +
                            '<option value="^No$">No</option>' +
                            '</select>'
                        );
                        break;
                    case 6:
                        $(this).html('<select id="deliveryModeFilter" class="form-select form-select-sm"><option value="">(All)</option></select>');
                        break;
                    default:
                        $(this).html('');
                        break;
                }
            });

            var table = $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function () {
                    var api = this.api();

                    [2, 3, 4].forEach(function (colIdx) {
                        $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    $('tfoot th').eq(5).find('select').on('change', function () {
                        api.column(5).search(this.value, true, false).draw();
                    });

                    var deliveryColumn = api.column(6);
                    var $deliverySelect = $('#deliveryModeFilter');
                    var uniqueValues = [];
                    deliveryColumn.data().each(function (d) {
                        if (d && uniqueValues.indexOf(d) === -1) uniqueValues.push(d);
                    });
                    uniqueValues.sort().forEach(function (val) {
                        var esc = $.fn.dataTable.util.escapeRegex(val);
                        $deliverySelect.append('<option value="^' + esc + '$">' + val + '</option>');
                    });
                    $deliverySelect.on('change', function () {
                        deliveryColumn.search(this.value, true, false).draw();
                    });

                    $('#loader').fadeOut(150, function () {
                        $('#tableContainer').fadeIn(150);
                    });
                }
            });

});
    </script>
}
