@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-10 text-center">

            <h1 class="display-5 fw-bold mb-2">
                <i class="fas fa-graduation-cap me-2 text-primary"></i>
                Welcome to <span class="text-primary">Trainify</span>
            </h1>

            <p class="lead mb-4">
                A modern training platform designed to strengthen skills, track certifications,
                and support professional development across your workforce.
            </p>

            <img src="~/assets/dist/img/icons/home256.png"
                 alt="Trainify logo"
                 class="img-fluid mb-4"
                 style="max-width: 140px;">
        </div>
    </div>

    <!-- MAIN ACTION BUTTONS -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 text-center d-flex flex-column flex-sm-row gap-3 justify-content-center">

            <!-- START TRAINING -->
            <a asp-controller="Trainify"
               asp-action="LearningTrainify"
               class="btn btn-primary btn-lg px-4">
                <i class="fas fa-graduation-cap me-2"></i>
                Start my training
            </a>

            <!-- VIEW TRAINING MATRIX -->
            <a asp-controller="Trainify"
               asp-action="MatrizbyEmployee"
               class="btn btn-outline-secondary btn-lg px-4">
                <i class="fas fa-id-card-alt me-2"></i>
                Matrix by Employee
            </a>
        </div>
    </div>

    <!-- FEATURES -->
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body text-center text-md-start">

                    <h5 class="card-title mb-3">
                        <i class="fas fa-lightbulb me-2 text-warning"></i>
                        Training Highlights
                    </h5>

                    <div class="row text-muted small">

                        <div class="col-md-4 mb-3">
                            <p class="fw-semibold mb-1">
                                <i class="fas fa-user-graduate me-1 text-primary"></i>
                                Training-focused
                            </p>
                            <p class="mb-0">Designed for continuous learning and skill development.</p>
                        </div>

                        <div class="col-md-4 mb-3">
                            <p class="fw-semibold mb-1">
                                <i class="fas fa-shield-alt me-1 text-success"></i>
                                Compliance-ready
                            </p>
                            <p class="mb-0">Track required courses, renewals, and certifications.</p>
                        </div>

                        <div class="col-md-4">
                            <p class="fw-semibold mb-1">
                                <i class="fas fa-chart-line me-1 text-danger"></i>
                                Real-time visibility
                            </p>
                            <p class="mb-0">Identify pending, expiring, and completed trainings instantly.</p>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
