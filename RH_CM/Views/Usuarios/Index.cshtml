@model IEnumerable<RH_CM.ViewModels.AppUsuario>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "User administrator";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-users-cog"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-controller="Usuarios" asp-action="Crear">
            <i class="align-middle fas fa-user-plus"></i> CREATE NEW USER
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    @if (Model != null && Model.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-primary">
                                <tr>
                                    <th>@Html.DisplayNameFor(m => m.First().UserName)</th>
                                    @* <th>@Html.DisplayNameFor(m => m.First().Email)</th> *@
                                    <th>Nombre completo</th>
                                    <th>@Html.DisplayNameFor(m => m.First().Rol)</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(_ => item.UserName)</td>
                                        @* <td>@Html.DisplayFor(_ => item.Email)</td> *@
                                        <td>@($"{item.Names} {item.LastName}")</td>
                                        <td>@Html.DisplayFor(_ => item.Rol)</td>
                                        <td>
                                            <div class="text-center">
                                                <form asp-controller="Usuarios" asp-action="Borrar" asp-route-idUsuario="@item.Id" method="post" style="display:inline;">
                                                    <a class="btn btn-warning" asp-controller="Usuarios" asp-action="Editar" asp-route-id="@item.Id">
                                                        <i class="fas fa-edit"></i> Editar
                                                    </a>

                                                    <!-- Asignar claims -->
                                                    <a class="btn btn-success" asp-controller="Usuarios" asp-action="AdministrarClaimsUsuario" asp-route-idUsuario="@item.Id" style="cursor:pointer;">
                                                        <i class="fas fa-user-shield"></i> Permisos/Claims
                                                    </a>

                                                    @if (item.LockoutEnd == null || item.LockoutEnd < DateTime.Now)
                                                    {
                                                        <!-- Bloquear -->
                                                        <button asp-controller="Usuarios" asp-action="BloquearDesbloquear" asp-route-idUsuario="@item.Id" class="btn btn-outline-light" style="cursor:pointer">
                                                            <i class="fas fa-user-lock"></i> <strong>Bloquear</strong>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <!-- Desbloquear -->
                                                        <button asp-controller="Usuarios" asp-action="BloquearDesbloquear" asp-route-idUsuario="@item.Id" class="btn btn-warning" style="cursor:pointer">
                                                            <i class="fas fa-unlock"></i> <strong>Desbloquear</strong>
                                                        </button>
                                                    }

                                                    <button type="submit" onclick="return confirm('¿Está seguro de querer borrar este registro?')" class="btn btn-danger">
                                                        <i class="align-middle fas fa-trash-alt"></i> Borrar
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p>No hay registros</p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Ocultar tabla y mostrar loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Inicializar DataTable con traducción al español y sin orden automático
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [], // sin orden automático, respeta el orden del servidor
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                },
                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notificaciones (acepta tanto Correcto/Error como SuccessMessage/ErrorMessage)
            var ok = "@(TempData["Correcto"] ?? TempData["SuccessMessage"])";
            var err = "@(TempData["Error"] ?? TempData["ErrorMessage"])";

            if (ok && ok !== "") {
                window.notyf.open({
                    type: 'success',
                    message: ok,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if (err && err !== "") {
                window.notyf.open({
                    type: 'error',
                    message: err,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
