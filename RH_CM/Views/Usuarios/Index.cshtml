@model IEnumerable<RH_CM.ViewModels.AppUsuario>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "User administrator";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-users-cog"></i> @ViewData["Title"]
        </h1>
    </div>

    <div class="col-auto d-flex align-items-center gap-2">

        <!-- Create new user -->
        <a class="btn btn-facebook"
           asp-controller="Usuarios"
           asp-action="Crear">
            <i class="align-middle fas fa-user-plus"></i> CREATE NEW USER
        </a>

        <!-- Toggle button to show/hide actions information -->
        <button class="btn btn-outline-info btn-sm"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#infoAlerts"
                aria-expanded="false"
                aria-controls="infoAlerts">
            <i class="fas fa-info-circle"></i> Actions information
        </button>

    </div>
</div>


<!-- Outline alerts with description of each action (without delete) -->
<div class="collapse mb-3" id="infoAlerts">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Buttons</h5>
            <h6 class="card-subtitle text-muted">Description of main actions.</h6>
        </div>
        <div class="card-body">

            <!-- Create User -->
            <div class="alert alert-primary alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div class="alert-message">
                    <strong>Create new user:</strong> Opens the form to register a new user in the system.
                </div>
            </div>

            <!-- Edit User -->
            <div class="alert alert-warning alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <div class="alert-message">
                    <strong>Edit user:</strong> Allows updating the information of the selected user.
                </div>
            </div>

            <!-- Claims / Permissions -->
            <div class="alert alert-success alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="alert-message">
                    <strong>Manage permissions / claims:</strong> Assigns or updates user permissions to access different modules.
                </div>
            </div>

            <!-- Lock User -->
            <div class="alert alert-secondary alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-user-lock"></i>
                </div>
                <div class="alert-message">
                    <strong>Lock user:</strong> Temporarily prevents the user from logging into the system.
                </div>
            </div>

            <!-- Unlock User -->
            <div class="alert alert-warning alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-unlock"></i>
                </div>
                <div class="alert-message">
                    <strong>Unlock user:</strong> Restores the user’s ability to log into the system.
                </div>
            </div>

            <!-- Toggle Available -->
            <div class="alert alert-info alert-outline alert-dismissible mb-3" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <div class="alert-icon">
                    <i class="fas fa-toggle-on"></i>
                </div>
                <div class="alert-message">
                    <strong>Toggle available:</strong> Marks the user as available or unavailable in the system.
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Table wrapped in hidden container -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    @if (Model != null && Model.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                            <thead class="table-primary">
                                <tr>
                                    <th>@Html.DisplayNameFor(m => m.First().UserName)</th>
                                    @* <th>@Html.DisplayNameFor(m => m.First().Email)</th> *@
                                    <th>Full Name</th>
                                    <th>@Html.DisplayNameFor(m => m.First().Rol)</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(_ => item.UserName)</td>
                                        @* <td>@Html.DisplayFor(_ => item.Email)</td> *@
                                        <td>@($"{item.Names} {item.LastName}")</td>
                                        <td>@Html.DisplayFor(_ => item.Rol)</td>
                                        <td>
                                            <div class="text-center">
                                                <form asp-controller="Usuarios" asp-action="Borrar" asp-route-idUsuario="@item.Id" method="post" style="display:inline;">

                                                    <!-- View details -->
                                                    <a class="btn btn-info"
                                                       asp-controller="Usuarios"
                                                       asp-action="UserDetail"
                                                       asp-route-id="@item.Id"
                                                       title="View details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>

                                                    <!-- Edit user -->
                                                    <a class="btn btn-warning"
                                                       asp-controller="Usuarios"
                                                       asp-action="Editar"
                                                       asp-route-id="@item.Id"
                                                       title="Edit user">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    <!-- Assign claims -->
                                                    <a class="btn btn-success"
                                                       asp-controller="Usuarios"
                                                       asp-action="AdministrarClaimsUsuario"
                                                       asp-route-idUsuario="@item.Id"
                                                       style="cursor:pointer;"
                                                       title="Manage permissions / claims">
                                                        <i class="fas fa-user-shield"></i>
                                                    </a>

                                                    <!-- Lock / Unlock -->
                                                    @if (item.LockoutEnd == null || item.LockoutEnd < DateTime.Now)
                                                    {
                                                        <!-- Lock -->
                                                        <button asp-controller="Usuarios"
                                                                asp-action="BloquearDesbloquear"
                                                                asp-route-idUsuario="@item.Id"
                                                                class="btn btn-light"
                                                                title="Lock user">
                                                            <i class="fas fa-user-lock"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <!-- Unlock -->
                                                        <button asp-controller="Usuarios"
                                                                asp-action="BloquearDesbloquear"
                                                                asp-route-idUsuario="@item.Id"
                                                                class="btn btn-warning"
                                                                title="Unlock user">
                                                            <i class="fas fa-unlock"></i>
                                                        </button>
                                                    }

                                                    <!-- Toggle Available -->
                                                    @if (item.Available == 1)
                                                    {
                                                        <button asp-controller="Usuarios"
                                                                asp-action="ToggleAvailable"
                                                                asp-route-idUsuario="@item.Id"
                                                                class="btn btn-outline-success"
                                                                title="Mark as unavailable">
                                                            <i class="fas fa-toggle-on"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button asp-controller="Usuarios"
                                                                asp-action="ToggleAvailable"
                                                                asp-route-idUsuario="@item.Id"
                                                                class="btn btn-outline-secondary"
                                                                title="Mark as available">
                                                            <i class="fas fa-toggle-off"></i>
                                                        </button>
                                                    }

                                                    @* Delete button hidden as requested
                                                    <button type="submit"
                                                            onclick="return confirm('Are you sure you want to delete this record?')"
                                                            class="btn btn-danger">
                                                        <i class="align-middle fas fa-trash-alt"></i>
                                                    </button>
                                                    *@
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p>No records available.</p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {

            // Hide table and show loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Initialize DataTable WITHOUT language and without automatic ordering
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [], // keeps server order

                initComplete: function () {
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

            // Notifications (Success and Error)
            var ok = "@(TempData["Correcto"] ?? TempData["SuccessMessage"])";
            var err = "@(TempData["Error"] ?? TempData["ErrorMessage"])";

            if (ok && ok !== "") {
                window.notyf.open({
                    type: 'success',
                    message: ok,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if (err && err !== "") {
                window.notyf.open({
                    type: 'error',
                    message: err,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

        });
    </script>
}
