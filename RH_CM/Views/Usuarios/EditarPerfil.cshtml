@model RH_CM.ViewModels.AppUsuario

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card border">
    <div class="card-header text-center">
        <h3 class="card-title"><strong>Edit Profile</strong></h3>
    </div>
    <div class="card-body">
        <form asp-controller="Usuarios" asp-action="EditarPerfil" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="text-danger" asp-validation-summary="All"></div>

                <div class="mb-3 col-md-6">
                    <label asp-for="Ntuser" class="form-label"></label>
                    <input asp-for="Ntuser" class="form-control" placeholder="Ingresa tu nombre" />
                    <span asp-validation-for="Ntuser" class="text-danger"></span>
                </div>

                <div class="mb-3 col-md-6">
                    <label asp-for="EmployeeNumber" class="form-label"></label>
                    <input asp-for="EmployeeNumber" type="text" class="form-control" placeholder="Numero Empleado">
                    <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                </div>

                <div class="mb-3 col-md-6">
                    <label asp-for="Names" class="form-label"></label>
                    <input asp-for="Names" type="text" class="form-control" placeholder="Nombre(s)">
                    <span asp-validation-for="Names" class="text-danger"></span>
                </div>

                <div class="mb-3 col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" type="text" class="form-control" placeholder="Apellidos">
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="mb-3 col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="Ingresa tu email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-10 offset-2">

                    <button type="submit" class="btn btn-success w-75 btn-lg"><i class="fas fa-check"></i> Editar </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

