@model RH_CM.ViewModels.AppUsuario

@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="h3 mb-3 text-center">Create User</h1>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Create User</h5>
            </div>

            <div class="card-body">
                <form asp-controller="Usuarios" asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <!-- Row: UserName & Email -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserName" class="form-label">User Name <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Row: Names & LastName -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Names" class="form-label">Names <span class="text-danger">*</span></label>
                            <input asp-for="Names" class="form-control" />
                            <span asp-validation-for="Names" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Role (form-group como en tu ejemplo) -->
                    <div class="form-group">
                        <label asp-for="IdRol" class="form-label"></label>
                        <select asp-for="IdRol" asp-items="Model.ListaRoles" class="form-control">
                            <option value="" disabled selected>--Seleccionar Rol--</option>
                        </select>
                        <span asp-validation-for="IdRol" class="text-danger"></span>
                    </div>

                    @*
                       If you're going to create with a password, uncomment this block and add the
                       corresponding fields to your ViewModel or use an auxiliary model.
                    <div class="row mt-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="Password" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control" />
                        </div>
                    </div>
                    *@

                    <!-- Actions -->
                    <div class="col-12 text-end">
                        <a asp-action="Index" class="btn btn-secondary js-confirm-link"
                           data-confirm-message="Are you sure you want to cancel without saving changes?" title="Cancel">
                            <i class="align-middle fas fa-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary" title="Save">
                            <i class="align-middle fas fa-save"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

}
