@model RH_CM.ViewModels.AppUsuario

@{
    ViewData["Title"] = "User Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isLocked = Model.LockoutEnd != null && Model.LockoutEnd > DateTime.Now;
}

<h1 class="h3 mb-3 text-center">User Detail</h1>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">User Detail</h5>
                <h6 class="card-subtitle text-muted">
                    Read-only view of this user's information.
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="mb-2 col-md-4">
                        <label class="form-label">User Name</label>
                        <input type="text" value="@Model.UserName" class="form-control" disabled />
                    </div>
                    <div class="mb-2 col-md-4">
                        <label class="form-label">Email</label>
                        <input type="text" value="@Model.Email" class="form-control" disabled />
                    </div>
                    <div class="mb-2 col-md-4">
                        <label class="form-label">Role</label>
                        <input type="text" value="@Model.Rol" class="form-control" disabled />
                    </div>
                </div>
                <div class="row">
                    <div class="mb-2 col-md-4">
                        <label class="form-label">Names</label>
                        <input type="text" value="@Model.Names" class="form-control" disabled />
                    </div>
                    <div class="mb-2 col-md-4">
                        <label class="form-label">Last Name</label>
                        <input type="text" value="@Model.LastName" class="form-control" disabled />
                    </div>
                    <div class="mb-2 col-md-4">
                        <label class="form-label">Employee Number</label>
                        <input type="text" value="@Model.EmployeeNumber" class="form-control" disabled />
                    </div>
                </div>
                <div class="row">
                    <div class="mb-2 col-md-4">
                        <label class="form-label">NT User</label>
                        <input type="text" value="@Model.Ntuser" class="form-control" disabled />
                    </div>
                    <div class="mb-2 col-md-4">
                        <label class="form-label d-block">Status</label>
                        @if (Model.Available == 1)
                        {
                            <span class="status-pill status-pill-success">Available</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill-muted">Unavailable</span>
                        }
                    </div>
                    <div class="mb-2 col-md-4">
                        <label class="form-label d-block">Lock Status</label>
                        @if (isLocked)
                        {
                            <span class="status-pill status-pill-danger">Locked until @Model.LockoutEnd?.ToString("g")</span>
                        }
                        else
                        {
                            <span class="status-pill status-pill-success">Unlocked</span>
                        }
                    </div>
                </div>
                <div class="row">
                    <div class="mb-2 col-md-4">
                        <label class="form-label">Created Date</label>
                        <input type="text" value="@Model.CreateDate.ToShortDateString()" class="form-control" disabled />
                    </div>
                </div>
                <div class="col-12 text-end">
                    <a asp-action="Index" class="btn btn-secondary" title="Back">
                        <i class="align-middle fas fa-arrow-left"></i> BACK
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

