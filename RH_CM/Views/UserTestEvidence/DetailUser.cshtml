@model RH_CM.Service.DTOs.UserTestEvidence.DetailDTOs

@{
    ViewData["Title"] = "User Exams & Evidences";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["BodyClass"] = "page-evidence-by-user";

    int totalCourses = @Model.Details.Count;
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="fas fa-list-check"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-success" asp-action="ExportEvidencesByUser" asp-route-id="@Model.ControlNumber" title="Export To Excel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>


<div id="tableContainer">
    <div class="card">
        <div class="card-header">
            <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                <div class="p-3 fw-bold rounded fs-3">
                    Control Number: @Model.ControlNumber
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Full Name: @Model.FullName
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Position: @Model.Position
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Total Courses: @Model.Details.Count
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Details.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th data-orderable="false" class="no-export">Action</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Delivery</th>
                            <th>Diagnostic Score</th>
                            <th>Exam Score</th>
                            <th>Completed Date</th>
                            <th>Exam ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.Details)
                        {
                            <tr>
                                <td>
                                    <div class="dropdown row-actions-menu">
                                        <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="fas fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @if (detail.Delivery?.Contains("extern", StringComparison.OrdinalIgnoreCase) == true)
                                            {
                                                <li><a class="dropdown-item text-info" asp-action="EvidenceReview" asp-route-id="@detail.PkCourseMovement" target="_blank"><i class="fas fa-eye me-2"></i>View Diagnostic</a></li>
                                                <li><a class="dropdown-item text-warning" asp-action="DC3PdfDownload" asp-route-ControlNumber="@Model.ControlNumber" asp-route-Course="@detail.Course" asp-route-CompletedDate="@detail.CompletedDate" asp-route-bywho="Admin" target="_blank"><i class="fas fa-eye me-2"></i>DC3</a></li>
                                            }
                                            else
                                            {
                                                <li><a class="dropdown-item text-info" asp-action="DiagnosticExamReview" asp-route-id="@detail.ExamsID" asp-route-controlNumber="@Model.ControlNumber" target="_blank"><i class="fas fa-bars me-2"></i>View Diagnostic</a></li>
                                                <li><a class="dropdown-item text-info" asp-action="ExamReview" asp-route-id="@detail.ExamsID" asp-route-controlNumber="@Model.ControlNumber" target="_blank"><i class="fas fa-list-check me-2"></i>View Exam</a></li>
                                                <li><a class="dropdown-item text-warning" asp-action="DC3PdfDownload" asp-route-ControlNumber="@Model.ControlNumber" asp-route-Course="@detail.Course" asp-route-CompletedDate="@detail.CompletedDate" asp-route-bywho="Admin" target="_blank"><i class="fas fa-eye me-2"></i>DC3</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="DeleteExams" asp-route-id="@detail.ExamsID" asp-route-controlNumber="@Model.ControlNumber" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this Exams? This action cannot be undone">
                                                        <button type="submit" class="dropdown-item text-danger"><i class="fas fa-trash me-2"></i>Delete</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td>@detail.Course</td>
                                <td>@detail.Level</td>
                                <td>@detail.Delivery</td>
                                <td>@detail.DiagnosticScore</td>
                                <td>
                                    @(detail.Delivery?.Contains("extern", StringComparison.OrdinalIgnoreCase) == true
                                                                ? "NA"
                                                                : detail.FinalExamScore)
                                </td>
                                <td>@detail.CompletedDate</td>
                                <td>
                                    @(detail.Delivery?.Contains("extern", StringComparison.OrdinalIgnoreCase) == true
                                                                ? "NA"
                                                                : detail.ExamsID)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 20,
                    lengthMenu: [[10, 20, 25, 50, 100, -1], [10, 20, 25, 50, 100, "All"]],
                    stateSave: true,
                    dom: window.dtButtonsDom,
                    buttons: window.dtExportButtons()
                });
            }

            // Solo success y error
});
    </script>
}
