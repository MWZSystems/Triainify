@model RH_CM.Service.DTOs.UserTestEvidence.DetailDTOs

@{
    ViewData["Title"] = "User Exams & Evidences";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["BodyClass"] = "page-matrix-position";

    int totalCourses = @Model.Details.Count;
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="fas fa-list-check"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-success" asp-action="ExportEvidencesByUser" asp-route-id="@Model.ControlNumber">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>


<div id="tableContainer">
    <div class="card">
        <div class="card-header">
            <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                <div class="p-3 fw-bold rounded fs-3">
                    Control Number: @Model.ControlNumber
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Full Name: @Model.FullName
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Position: @Model.Position
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Total Courses: @Model.Details.Count
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Details.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-primary">
                        <tr>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Delivery</th>
                            <th>Diagnostic Score</th>
                            <th>Exam Score</th>
                            <th>Completed Date</th>
                            <th>Exam ID</th>
                            <th>Action</th>
  
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.Details)
                        {
                            <tr>
                                <td>@detail.Course</td>
                                <td>@detail.Level</td>
                                <td>@detail.Delivery</td>
                                <td>@detail.DiagnosticScore</td>

                                @* <td>@detail.FinalExamScore</td> *@
                                <td>
                                    @(detail.Delivery?.Contains("extern", StringComparison.OrdinalIgnoreCase) == true
                                                                ? "NA"
                                                                : detail.FinalExamScore)
                                </td>
                                <td>@detail.CompletedDate</td>

                                @* <td>@detail.ExamsID</td> *@
                                <td>
                                    @(detail.Delivery?.Contains("extern", StringComparison.OrdinalIgnoreCase) == true
                                                                ? "NA"
                                                                : detail.ExamsID)
                                </td>

                                <td>
                                    @* @if (@detail.FinalExamScore == "NA") *@
                                    @if (detail.Delivery?.Contains("extern", StringComparison.OrdinalIgnoreCase) == true)
                                    {
                                        <a class="btn btn-info"
                                           asp-action="EvidenceReview"
                                           asp-route-id="@detail.PkCourseMovement"
                                           target="_blank"
                                           title="View Diagnostic">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a class="btn btn-warning"
                                           asp-action="DC3PdfDownload"
                                           asp-route-ControlNumber="@Model.ControlNumber"
                                           asp-route-Course="@detail.Course"
                                           asp-route-CompletedDate="@detail.CompletedDate"
                                           asp-route-bywho="Admin"
                                           target="_blank"
                                           title="DC3">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                    }
                                    else
                                    {
                                        <a class="btn btn-info"
                                           asp-action="DiagnosticExamReview"
                                           asp-route-id="@detail.ExamsID"
                                           target="_blank"
                                           title="View Diagnostic">
                                            <i class="fas fa-bars"></i>
                                        </a>

                                        <a class="btn btn-info"
                                           asp-action="ExamReview"
                                           asp-route-id="@detail.ExamsID"
                                           target="_blank"
                                           title="View Exam">
                                            <i class="fas fa-list-check"></i>
                                        </a>

                                        <a class="btn btn-warning"
                                           asp-action="DC3PdfDownload"
                                           asp-route-ControlNumber="@Model.ControlNumber"
                                           asp-route-Course="@detail.Course"
                                           asp-route-CompletedDate="@detail.CompletedDate"
                                           asp-route-bywho="Admin"
                                           target="_blank"
                                           title="DC3">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <form asp-action="DeleteExams" asp-route-id="@detail.ExamsID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Exams? This action cannot be undone');">
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 50,
                    lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]],
                    dom: 'lfrtip' // length menu, filter, processing, table, info, pagination
                });
            }

            // Solo success y error
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}