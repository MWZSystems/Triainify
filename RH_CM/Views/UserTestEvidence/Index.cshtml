@model IEnumerable<RH_CM.Service.DTOs.UserTestEvidence.UserDTOs>
@{
    ViewData["Title"] = "Evidence By User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-file-archive"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-success" asp-action="ExportMassiveEvidencesByUser">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-primary">
                        <tr>
                            <th>Control Number</th>
                            <th>Full Name</th>
                            <th>Position</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <!-- Filtros por columna -->
                    <tfoot>
                        <tr>
                            <th>Control Number</th>
                            <th>Full Name</th>
                            <th>Position</th>
                            <th></th>
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ControlNumber</td>
                                <td>@item.FullName</td>
                                <td>@item.Position</td>
                                <td>
                                    <a class="btn btn-info"
                                       asp-action="DetailUser"
                                       asp-route-id="@item.ControlNumber"
                                       target="_blank"
                                       title="View Detail">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Inicializar DataTable solo si hay filas
            if (@(Model != null && Model.Any() ? "true" : "false")) {
                var table = $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    initComplete: function () {
                        var api = this.api();

                        // Inputs de texto: Course, Level, Material
                        [1, 2, 3].forEach(function (colIdx) {
                            $('tfoot th').eq(colIdx).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(colIdx).text() + '" />');
                            $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                                if (api.column(colIdx).search() !== this.value) {
                                    api.column(colIdx).search(this.value).draw();
                                }
                            });
                        });

                        // Mostrar la tabla y ocultar el loader
                        $('#loader').fadeOut(150, function () {
                            $('#tableContainer').fadeIn(150);
                        });
                    }
                });
            } else {
                // Si no hay datos, simplemente ocultar loader y mostrar mensaje
                $('#loader').fadeOut(150, function () {
                    $('#tableContainer').fadeIn(150);
                });
            }

             // Solo success y error
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}


