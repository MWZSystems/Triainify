@model IEnumerable<RH_CM.Service.DTOs.UserTestEvidence.UserDTOs>
@{
    ViewData["Title"] = "Evidence By User";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-evidence-by-user";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Evidence By User",
            IconClass = "fa-file-archive",
            HelpBullets = new List<string>
            {
                "Shows each user's diagnostic and exam history, with links to review individual attempts.",
                "Click \"Export To Excel\" to download the full list."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-success" asp-action="ExportMassiveEvidencesByUser" title="Export To Excel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th>Control Number</th>
                            <th>Full Name</th>
                            <th>Position</th>
                            <th data-orderable="false">Actions</th>
                        </tr>
                    </thead>

                    <!-- Filtros por columna -->
                    <tfoot>
                        <tr>
                            <th>Control Number</th>
                            <th>Full Name</th>
                            <th>Position</th>
                            <th></th>
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ControlNumber</td>
                                <td>@item.FullName</td>
                                <td>@item.Position</td>
                                <td>
                                    <a class="btn btn-info"
                                       asp-action="DetailUser"
                                       asp-route-id="@item.ControlNumber"
                                       target="_blank"
                                       title="View Detail">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Initialize DataTable only if there are rows
            if (@(Model != null && Model.Any() ? "true" : "false")) {
                var table = $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    initComplete: function () {
                        var api = this.api();

                        // Inputs de texto: Course, Level, Material
                        [1, 2, 3].forEach(function (colIdx) {
                            $('tfoot th').eq(colIdx).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(colIdx).text() + '" />');
                            $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                                if (api.column(colIdx).search() !== this.value) {
                                    api.column(colIdx).search(this.value).draw();
                                }
                            });
                        });

                        // Mostrar la tabla y ocultar el loader
                        $('#loader').fadeOut(150, function () {
                            $('#tableContainer').fadeIn(150);
                        });
                    }
                });
            } else {
                // If there's no data, simply hide the loader and show the message
                $('#loader').fadeOut(150, function () {
                    $('#tableContainer').fadeIn(150);
                });
            }

             // Solo success y error
});
    </script>
}


