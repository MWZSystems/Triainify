@model RH_CM.ViewModels.IndexHeadCountListViewModel

@{
    ViewData["Title"] = "Headcount Available";
    ViewData["BodyClass"] = "page-headcount-available";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Headcount Available",
            IconClass = "fa-user-check",
            HelpBullets = new List<string>
            {
                "The full list of currently active employees in the headcount catalog.",
                "Use \"Export to Excel\" to download it, or the row actions to view/edit an employee's record."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateHeadCount" title="Create New Onboarding">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW ONBOARDING
        </a>
        <a class="btn btn-success" asp-action="ExportHeadCountToExcel" title="Export To Excel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <output class="spinner-border" style="width: 3rem; height: 3rem;" aria-live="polite">
        <span class="visually-hidden">Loading...</span>
    </output>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">

                    @if (Model.SyHeadCount.Any())
                    {
                        <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                                <tr>
                                    <th>Control Number</th>
                                    <th>Names</th>
                                    <th>Last Name</th>
                                    <th>Second Name</th>
                                    <th>Level</th>
                                    <th>Shift</th>
                                    <th>Start_Date</th>
                                    <th>Department</th>
                                    <th>Position</th>
                                    <th>Birthdate</th>
                                    <th>Age</th>
                                    <th>Curp</th>
                                    <th>RFC</th>
                                    <th>Social Security</th>
                                    <th>Sex</th>
                                    <th>Marital Status</th>
                                    <th>Phone 1</th>
                                    <th>Phone 2</th>
                                    <th>Email</th>
                                    <th>Education Level</th>
                                    <th>Specialization</th>
                                    <th>Street</th>
                                    <th>Neighborhood</th>
                                    <th>City</th>
                                    <th>Zip Code</th>
                                    <th>Zip CodeSAT</th>
                                    @* <th>Available</th> *@
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SyHeadCount)
                                {
                                    <tr>
                                        <td>@item.ControlNumber</td>
                                        <td>@item.Names</td>
                                        <td>@item.LastName</td>
                                        <td>@item.SecondName</td>
                                        <td>@item.LevelEmployee</td>
                                        <td>@item.ShiftWork</td>
                                        <td>@item.StarDate.ToShortDateString()</td>
                                        <td>@Model.Departments.FirstOrDefault(d => d.PkDepartment == item.FkDepartment)?.NameDeparment</td>
                                        <td>@Model.Positions.FirstOrDefault(p => p.PkPosition == item.FkPosition)?.NamePosition</td>
                                        <td>@item.Birthdate.ToShortDateString()</td>
                                        <td>@Model.HeadCountAges.GetValueOrDefault(item.PkHeadcount, 0)</td>
                                        <td>@item.Curp</td>
                                        <td>@item.Rfc</td>
                                        <td>@item.SocialSecurity</td>
                                        <td>@item.Sex</td>
                                        <td>@item.MaritalStatus</td>
                                        <td>@item.Phone1</td>
                                        <td>@item.Phone2</td>
                                        <td>@item.Email</td>
                                        <td>@item.EducationLevel</td>
                                        <td>@item.Specialization</td>
                                        <td>@item.Street</td>
                                        <td>@item.Neighborhood</td>
                                        <td>@item.City</td>
                                        <td>@item.ZipCode</td>
                                        <td>@item.ZipCodesat</td>
                                        @* <td>@item.Available</td> *@
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No records found</p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function() {
            // Hide the table and show the loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Initialize DataTable
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [[0, 'asc']],
                initComplete: function() {
                    $('#loader').fadeOut(200, function() {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

});
    </script>
}
