@model RH_CM.ViewModels.IndexHeadCountListViewModel

@{
    ViewData["Title"] = "Headcount Available";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center"><i class="align-middle fas fa-user-check"></i> @ViewData["Title"]</h1>
    </div>
    <div class="col-auto">
        <a class="btn btn-facebook" asp-action="CreateHeadCount">
            <i class="align-middle fas fa-plus-square"></i> CREATE NEW ONBOARDING
        </a>
        <a class="btn btn-success" asp-action="ExportHeadCountToExcel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                @if (Model.SyHeadCounts.Any())
                {
                    <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                        <thead class="table-primary">
                            <tr>
                                <th>Control Number</th>
                                <th>Names</th>
                                <th>Last Name</th>
                                <th>Second Name</th>
                                <th>Level</th>
                                <th>Shift</th>
                                <th>Start_Date</th>
                                <th>Department</th>
                                <th>Position</th>
                                @* <th>Supervisor</th> *@
                                <th>Birthdate</th>
                                <th>Age</th> <!-- Agregar columna de Edad -->
                                <th>Curp</th>
                                <th>RFC</th>
                                <th>Social Security</th>
                                <th>Sex</th>
                                <th>Marital Status</th>
                                <th>Phone 1</th>
                                <th>Phone 2</th>
                                <th>Email</th>
                                <th>Education Level</th>
                                <th>Specialization</th>
                                <th>Street</th>
                                <th>Neighborhood</th>
                                <th>City</th>
                                <th>Zip Code</th>
                                <th>Zip CodeSAT</th>
                                <th>Available</th>
                                @* <th>Actions</th> *@
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SyHeadCounts)
                            {
                                <tr>
                                    <td>@item.ControlNumber</td>
                                    <td>@item.Names</td>
                                    <td>@item.LastName</td>
                                    <td>@item.SecondName</td>
                                    <td>@item.LevelEmployee</td>
                                    <td>@item.ShiftWork</td>
                                    <td>@item.StarDate.ToShortDateString()</td>
                                    <td>@Model.Departments.FirstOrDefault(d => d.PkDepartment == item.FkDepartment)?.NameDeparment</td>
                                    <td>@Model.Positions.FirstOrDefault(p => p.PkPosition == item.FkPosition)?.NamePosition</td>
                                    @* <td>
                                        @if (item.Supervisor != 0)
                                        {
                                            var supervisor = Model.SyHeadCounts.FirstOrDefault(p => p.PkHeadcount == item.Supervisor);
                                            if (supervisor != null)
                                            {
                                                @($"{supervisor.Names} {supervisor.LastName} {supervisor.SecondName}")
                                            }
                                            else
                                            {
                                                @("Supervisor no encontrado")
                                            }
                                        }
                                        else
                                        {
                                            @("Sin Asignar")
                                        }
                                    </td> *@
                                    <td>@item.Birthdate.ToShortDateString()</td>
                                    <td>@Model.HeadCountAges.GetValueOrDefault(item.PkHeadcount, 0)</td> <!-- Mostrar edad -->
                                    <td>@item.Curp</td>
                                    <td>@item.Rfc</td>
                                    <td>@item.SocialSecurity</td>
                                    <td>@item.Sex</td>
                                    <td>@item.MaritalStatus</td>
                                    <td>@item.Phone1</td>
                                    <td>@item.Phone2</td>
                                    <td>@item.Email</td>
                                    <td>@item.EducationLevel</td>
                                    <td>@item.Specialization</td>

                                    <td>@item.Street</td>
                                    <td>@item.Neighborhood</td>
                                    <td>@item.City</td>
                                    <td>@item.ZipCode</td>
                                    <td>@item.ZipCodesat</td>
                                    <td>@item.Available</td>
                                    
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Inicializar DataTable con traducción al español
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [[0, 'asc']], // Ordenar por 'Control Number' (índice 0) de forma ascendente
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            // Mostrar mensajes de éxito y error
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
}
