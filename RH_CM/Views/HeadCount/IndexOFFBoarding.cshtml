@model RH_CM.ViewModels.IndexHeadCountListViewModel

@{
    ViewData["Title"] = "Offboarding";
    ViewData["BodyClass"] = "page-offboarding";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Offboarding",
            IconClass = "fa-user-minus",
            HelpBullets = new List<string>
            {
                "Employees who have been offboarded (deactivated) from the headcount catalog.",
                "To reactivate someone, open their record from \"Headcount Unavailable\" and toggle availability back on."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-outline-success" asp-action="ExportHeadCountFullData" title="Export the complete database data for this catalog, for validation purposes">
            <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div id="loader" class="text-center my-4 text-light">
            <div class="spinner-border" style="width:3rem;height:3rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        @if (Model?.SyHeadCount != null && Model.SyHeadCount.Any())
        {
            <div class="table-responsive" id="tableContainer" style="display:none;">
                <table id="datatables-hc" class="table table-striped table-hover align-middle" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th data-orderable="false" class="no-export">Actions</th>
                            <th>Control Number</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Position</th>
                        </tr>
                        <tr class="filter-row">
                            <th></th>
                            <th><input class="form-control form-control-sm" placeholder="Control Number" /></th>
                            <th><input class="form-control form-control-sm" placeholder="Name" /></th>
                            <th><input class="form-control form-control-sm" placeholder="Department" /></th>
                            <th><input class="form-control form-control-sm" placeholder="Position" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SyHeadCount)
                        {
                            var deptName = Model.Departments.FirstOrDefault(d => d.PkDepartment == item.FkDepartment)?.NameDeparment;
                            var posName = Model.Positions.FirstOrDefault(p => p.PkPosition == item.FkPosition)?.NamePosition;

                            <tr>
                                <td class="text-center">
                                    <form asp-action="ToggleAvailabilityHeadCount"
                                          asp-route-id="@item.PkHeadcount"
                                          method="post" class="d-inline js-confirm-submit"
                                          data-confirm-message="Are you sure you want to toggle the availability of this head count?">
                                        <button type="submit" class="btn @(item.Available == 1 ? "btn-success" : "btn-secondary")" title="Toggle availability">
                                            <i class="align-middle fas @(item.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                        </button>
                                    </form>
                                </td>
                                <td>@item.ControlNumber</td>
                                <td>@item.Names @item.LastName @item.SecondName</td>
                                <td>@deptName</td>
                                <td>@posName</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th>Control Number</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Position</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <p class="mb-0">No records found</p>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const table = $('#datatables-hc').DataTable({
                responsive: true,
                order: [[1, 'asc']],
                pageLength: 20,
                lengthMenu: [[10, 20, 25, 50, 100, -1], [10, 20, 25, 50, 100, "All"]],
                stateSave: true,
                dom: window.dtButtonsDom,
                buttons: window.dtExportButtons(),
                initComplete: function () {
                    const api = this.api();
                    [1,2,3,4].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input')
                            .on('keyup change clear', function () {
                                if (api.column(colIdx).search() !== this.value) {
                                    api.column(colIdx).search(this.value).draw();
                                }
                            });
                    });
                    $('#loader').fadeOut(200, function () {
                        $('#tableContainer').fadeIn(200);
                    });
                }
            });

});
    </script>
}
