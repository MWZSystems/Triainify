@model RH_CM.Service.DTOs.ThematicCourseDTOs

@{
    ViewData["Title"] = "Thematic Course Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-matrix-position";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="fas fa-map"></i> @ViewData["Title"]
        </h1>
    </div>
    @* <div class="col-auto">
        <a asp-action="Index" asp-controller="Permissions" class="btn btn-secondary">
            <i class="fas fa-rotate-left"></i> CHANGE GROUP
        </a>
    </div> *@
</div>


<div id="tableContainer">
    <div class="card">
        @* <div class="card-header">
            <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                <div class="p-3 fw-bold rounded fs-3">
                    Group ID: @Model.GroupId
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Group Name: @Model.GroupName
                </div>
            </div>
        </div> *@
        <div class="card-body">
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addThematicCourse">
                    <i class="fas fa-plus"></i> Add Thematic - Course
                </button>
            </div>
            @if (Model != null)
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Thematic Name</th>
                            <th>Thematic Code</th>
                            <th>Course</th>
                            <th>Actions</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.ThematicCourses)
                        {
                            <tr>
                                <td>@detail.Id</td>
                                <td>@detail.ThematicName</td>
                                <td>@detail.ThematicCode</td>
                                <td>@detail.CourseName</td>

                                <td>
                                    <form asp-action="EditThematicCourse" asp-route-Id="@detail.Id" method="get" class="d-inline">
                                        <button type="submit" class="btn btn-warning">
                                            <i class="align-middle fas fa-edit"></i>
                                        </button>
                                    </form>

                                    <form asp-action="DeleteThematicCourse" asp-route-Id="@detail.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Thematic Course link?');">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="align-middle fas fa-window-close"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>



<div class="modal fade" id="addThematicCourse" tabindex="-1" aria-labelledby="addThematicCourseLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddThematicCourse" asp-controller="ThematicCourse" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addThematicCourseLabel">Add Thematic Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @* <input type="hidden" name="GroupId" value="@Model.GroupId" /> *@

                    <div class="row mb-3">
                        <!-- Select Thematic -->
                        <div class="col-md-6">
                            <label for="ThematicArea" class="form-label">Select Thematic Area</label>
                            <select id="ThematicArea" name="ThematicArea" class="form-select" required>
                                <option value="">-- Choose Thematic Area --</option>
                                @foreach (var ThematicArea in Model.Thematics)
                                {
                                    <option value="@ThematicArea.Thematics">@ThematicArea.Thematics</option>
                                }
                            </select>
                        </div>

                        <!-- Enter Occupation Code -->
                        <div class="col-md-6">
                            <label for="Course" class="form-label">Select Course</label>
                            <select id="Course" name="Course" class="form-select" required>
                                <option value="">-- Choose Course --</option>
                                @foreach (var Course in Model.Courses)
                                {
                                    <option value="@Course.Courses">@Course.Courses</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 50,
                    lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]]
                });
            }

            // Solo success y error
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
