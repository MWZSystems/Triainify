@model RH_CM.Service.DTOs.ThematicCourseDTOs

@{
    ViewData["Title"] = "Thematic Course Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-thematic-course";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Thematic Course Assignment",
            IconClass = "fa-map",
            HelpBullets = new List<string>
            {
                "Links each thematic area to the courses that belong to it.",
                "Click \"Add Thematic - Course\" to create a new link, or use the row actions to edit or toggle an existing one."
            }
        })" />
    </div>
</div>


<div id="tableContainer">
    <div class="card">
        @* <div class="card-header">
            <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                <div class="p-3 fw-bold rounded fs-3">
                    Group ID: @Model.GroupId
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Group Name: @Model.GroupName
                </div>
            </div>
        </div> *@
        <div class="card-body">
            <div class="d-flex justify-content-end gap-2 mb-3">
                <a class="btn btn-outline-success" asp-action="ExportThematicCourseFullData" title="Export the complete database data for this catalog, for validation purposes">
                    <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
                </a>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addThematicCourse" title="Add Thematic - Course">
                    <i class="align-middle fas fa-plus-square"></i> Add Thematic - Course
                </button>
            </div>
            @if (Model != null)
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th data-orderable="false" class="no-export">Actions</th>
                            <th>ID</th>
                            <th>Thematic Name</th>
                            <th>Thematic Code</th>
                            <th>Course</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.ThematicCourses)
                        {
                            <tr>
                                <td>
                                    <div class="dropdown row-actions-menu">
                                        <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="fas fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <form asp-action="EditThematicCourse" asp-route-Id="@detail.Id" method="get">
                                                    <button type="submit" class="dropdown-item text-warning"><i class="align-middle fas fa-edit me-2"></i>Edit</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="ToggleThematicCourse" asp-route-id="@detail.Id" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to toggle availability?">
                                                    <button type="submit" class="dropdown-item @(detail.Available == 1 ? "text-success" : "text-secondary")">
                                                        <i class="align-middle fas @(detail.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>Toggle availability
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="DeleteThematicCourse" asp-route-Id="@detail.Id" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this Thematic Course link?">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="align-middle fas fa-window-close me-2"></i>Delete</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                                <td>@detail.Id</td>
                                <td>@detail.ThematicName</td>
                                <td>@detail.ThematicCode</td>
                                <td>@detail.CourseName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>



<div class="modal fade" id="addThematicCourse" tabindex="-1" aria-labelledby="addThematicCourseLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddThematicCourse" asp-controller="ThematicCourse" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addThematicCourseLabel">Add Thematic Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
                </div>
                <div class="modal-body">
                    @* <input type="hidden" name="GroupId" value="@Model.GroupId" /> *@

                    <div class="row mb-3">
                        <!-- Select Thematic -->
                        <div class="col-md-6">
                            <label for="ThematicArea" class="form-label">Select Thematic Area</label>
                            <select id="ThematicArea" name="ThematicArea" class="form-select" required>
                                <option value="">-- Choose Thematic Area --</option>
                                @foreach (var ThematicArea in Model?.Thematics ?? Enumerable.Empty<RH_CM.Service.DTOs.Thematic>())
                                {
                                    <option value="@ThematicArea.Thematics">@ThematicArea.Thematics</option>
                                }
                            </select>
                        </div>

                        <!-- Enter Occupation Code -->
                        <div class="col-md-6">
                            <label for="Course" class="form-label">Select Course</label>
                            <select id="Course" name="Course" class="form-select" required>
                                <option value="">-- Choose Course --</option>
                                @foreach (var Course in Model?.Courses ?? Enumerable.Empty<RH_CM.Service.DTOs.Course>())
                                {
                                    <option value="@Course.Courses">@Course.Courses</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" title="Add Thematic - Course">Add Thematic - Course</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 20,
                    lengthMenu: [[10, 20, 25, 50, 100, -1], [10, 20, 25, 50, 100, "All"]],
                    stateSave: true,
                    dom: window.dtButtonsDom,
                    buttons: window.dtExportButtons()
                });
            }

            // Solo success y error
$('#addThematicCourse').on('shown.bs.modal', function () {
                $('#ThematicArea').select2({
                    placeholder: "-- Select Thematic Area --",
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#addThematicCourse') //
                });

                 $('#Course').select2({
                    placeholder: "-- Choose Course --",
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#addThematicCourse') //
                });
            });
        });
    </script>
}
