@model RH_CM.ViewModels.RecuperaPasswordViewModel

@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="card border shadow-sm">

            <!-- Header claro con ícono igual al otro menú -->
            <div class="card-header bg-light border-bottom">
                <h3 class="card-title mb-0 fw-bold text-dark">
                    <i class="fas fa-user-plus me-2 text-secondary"></i>
                    RESET PASSWORD
                </h3>
                <small class="text-muted">
                    Enter your information to reset your password.
                </small>
            </div>

            <div class="card-body">

                <form asp-controller="Cuentas" asp-action="ResetPassword" method="post">

                    @* Mostrar validación solo si hay errores *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All"
                             class="alert alert-danger py-2 mb-3"
                             role="alert"></div>
                    }

                    <div class="row mt-3">
                        <div class="col-12">

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label fw-semibold">Username</label>
                                <input asp-for="UserName" class="form-control" placeholder="Enter your username" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter the new password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm the new password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success px-4 btn-lg">
                            <i class="fas fa-check me-1"></i> Change password
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Mostrar mensaje de éxito en el modal
            if ("@TempData["Correcto"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["Correcto"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            // Mostrar mensaje de error en el modal
            if ("@TempData["Error"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["Error"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
}
