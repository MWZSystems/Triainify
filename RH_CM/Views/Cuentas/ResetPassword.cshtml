@model RH_CM.ViewModels.RecuperaPasswordViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="card border shadow-sm">

            <!-- Header -->
            <div class="card-header bg-light border-bottom">
                <h3 class="card-title mb-0 fw-bold text-dark">
                    <i class="fas fa-lock-open me-2 text-secondary"></i>
                    RESET PASSWORD
                </h3>
                <small class="text-muted">
                    Enter your information to reset your password.
                </small>
            </div>

            <div class="card-body">

                <form asp-controller="Cuentas" asp-action="ResetPassword" method="post">

                    @* Validation summary *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All"
                             class="alert alert-danger py-2 mb-3"
                             role="alert"></div>
                    }

                    <div class="row mt-3">
                        <div class="col-12">

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label fw-semibold">Username</label>
                                <input asp-for="UserName"
                                       class="form-control"
                                       placeholder="Enter your username" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter the new password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       placeholder="Confirm the new password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end">
                        <button type="submit"
                                class="btn btn-primary px-4">
                            <i class="fas fa-save me-1"></i>
                            Save Changes
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // Messages from TempData serialized
            var successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]));
            var errorMessage   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]));

            if (window.notyf && successMessage) {
                window.notyf.open({
                    type: 'success',
                    message: successMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if (window.notyf && errorMessage) {
                window.notyf.open({
                    type: 'error',
                    message: errorMessage,
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}

