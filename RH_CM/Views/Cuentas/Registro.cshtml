@model RH_CM.ViewModels.RegistroViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Responsive Bootstrap 5 Admin &amp; Dashboard Template">
    <meta name="author" content="Bootlab">

    <title>RH</title>
    <!-- Remove this after purchasing -->
    <link rel="stylesheet" href="~/Assets/dist/css/light.css" asp-append-version="true" />
    <link rel="shortcut icon" href="~/Assets/dist/img/favicon.ico">
</head>

<body data-theme="default" data-layout="fluid" data-sidebar-position="left" data-sidebar-behavior="sticky">
    <div class="main d-flex justify-content-center w-100">
        <main class="content d-flex p-0">
            <div class="container d-flex flex-column">
                <div class="row h-100">
                    <div class="col-sm-10 col-md-8 col-lg-6 mx-auto d-table h-100">
                        <div class="d-table-cell align-middle">

                            <div class="text-center mt-4">
                                <h1 class="h2">Welcome RH System</h1>
                            </div>
                            <div class="card border">
                                <div class="card-header text-center">
                                    <h3 class="card-title"><strong>Register</strong></h3>
                                </div>
                                <div class="card-body">
                                    <form asp-controller="Cuentas" asp-action="Registro" method="post">
                                        <div class="row">
                                            <div class="text-danger" asp-validation-summary="All"></div>

                                            <div class="mb-3 col-md-6">
                                                <label asp-for="Ntuser" class="form-label"></label>
                                                <input asp-for="Ntuser" class="form-control" placeholder="Ingresa tu nombre" />
                                                <span asp-validation-for="Ntuser" class="text-danger"></span>
                                            </div>

                                            <div class="mb-3 col-md-6">
                                                <label asp-for="EmployeeNumber" class="form-label"></label>
                                                <input asp-for="EmployeeNumber" type="text" class="form-control" placeholder="Numero Empleado">
                                                <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                                            </div>

                                            <div class="mb-3 col-md-6">
                                                <label asp-for="Names" class="form-label"></label>
                                                <input asp-for="Names" type="text" class="form-control" placeholder="Nombre(s)" oninput="this.value = this.value.toUpperCase()">
                                                <span asp-validation-for="Names" class="text-danger"></span>
                                            </div>

                                            <div class="mb-3 col-md-6">
                                                <label asp-for="LastName" class="form-label"></label>
                                                <input asp-for="LastName" type="text" class="form-control" placeholder="Apellidos" oninput="this.value = this.value.toUpperCase()">
                                                <span asp-validation-for="LastName" class="text-danger"></span>
                                            </div>

                                            <div class="mb-3 col-md-6">
                                                <label asp-for="Email" class="form-label"></label>
                                                <input asp-for="Email" class="form-control" placeholder="Ingresa tu email" />
                                                <span asp-validation-for="Email" class="text-danger"></span>
                                            </div>

                                            <div class="mb-3 col-md-6">
                                                <label asp-for="Password" class="form-label"></label>
                                                <input asp-for="Password" class="form-control" placeholder="Ingresa la contraseña" />
                                                <span asp-validation-for="Password" class="text-danger"></span>
                                            </div>

                                            <div class="mb-3 col-md-6">
                                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Ingresa la confirmación de contraseña" />
                                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-sm-10 offset-2">
                                                <button type="submit" class="btn btn-success w-75 btn-lg">Registrarse</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="~/assets/dist/js/app.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Ensure input fields only allow uppercase letters
            document.querySelectorAll('input[asp-for="Names"], input[asp-for="LastName"]').forEach(function (element) {
                element.addEventListener('input', function () {
                    this.value = this.value.toUpperCase();
                });
            });

            // Handle success and error notifications
            if ("@TempData["Correcto"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["Correcto"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            if ("@TempData["Error"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["Error"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}