@model RH_CM.ViewModels.AccesoViewModel
@inject IConfiguration Configuration
@using System.Text.Json

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Trainify Login</title>
    <link rel="stylesheet" href="~/Assets/dist/css/light.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />
    <link rel="stylesheet" href="~/Assets/dist/css/theme-uupm.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/dist/css/LoadingOverlay.css" asp-append-version="true" />
    <link rel="shortcut icon" href="~/Assets/favicon.ico">

    <style>
        body {
            background-image: url('@Url.Content("~/Assets/WallpaperBackground.jpeg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        .login-wrapper {
            background: rgba(255, 255, 255, 0.85);
            border-radius: 15px;
            box-shadow: 0 0 18px rgba(0, 0, 0, 0.4);
            padding: 30px 20px;
        }
    </style>
</head>

<body class="d-flex align-items-center justify-content-center min-vh-100">

    <div id="pageLoadingOverlay" class="page-loading-overlay" aria-hidden="true">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-sm-10 col-md-8 col-lg-5">

                <div class="login-wrapper">

                    <!-- Header -->
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-1">
                            <i class="fas fa-graduation-cap text-primary me-2"></i>
                            Trainify
                        </h1>
                        <p class="text-muted mb-0">Sign in to your account to continue</p>
                    </div>

                    <!-- Card -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">

                            <div class="text-center mb-3">
                                <img src="~/Assets/dist/img/avatars/user.png"
                                     alt="Login"
                                     class="img-fluid rounded-circle"
                                     style="width: 80px; height: 80px; object-fit: cover;" />
                            </div>

                            <form asp-controller="Cuentas" asp-action="Acceso" method="post">

                                <!-- Validation summary (ModelState) -->
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                                <!-- Username -->
                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label fw-semibold"></label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text">
                                            <i class="fas fa-user"></i>
                                        </span>
                                        <input asp-for="UserName"
                                               class="form-control"
                                               placeholder="Enter your username" />
                                    </div>
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>

                                <!-- Password -->
                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label fw-semibold"></label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text">
                                            <i class="fas fa-lock"></i>
                                        </span>
                                        <input asp-for="Password"
                                               type="password"
                                               class="form-control"
                                               placeholder="Enter your password" />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <!-- Button -->
                                <div class="d-grid mt-3">
                                    <button class="btn btn-primary btn-lg" title="Login">
                                        <i class="fas fa-sign-in-alt me-1"></i>
                                        Login
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>

                    <!-- Version -->
                    <div class="text-center text-muted small mt-3">
                        <i class="fas fa-code-branch me-1"></i>
                        Version @Configuration["AppSettings:ApplicationVersion"]
                    </div>

                </div>

            </div>
        </div>
    </div>

    <script src="~/Assets/dist/js/app.js"></script>
    <script src="~/Assets/dist/js/loading-overlay.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/Assets/dist/js/sweetalert-helpers.js"></script>

    @* Validation and SweetAlert2 *@
    <partial name="_ValidationScriptsPartial" />

    @if (Context.Request.Query["expired"] == "true")
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (window.swalToast) {
                    window.swalToast('Session has expired. Please Log In.', 'danger');
                }
            });
        </script>
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var successMessage = @Html.Raw(JsonSerializer.Serialize(TempData["SuccessMessage"]));
            var errorMessage   = @Html.Raw(JsonSerializer.Serialize(TempData["ErrorMessage"]));

            if (window.swalToast && successMessage) {
                window.swalToast(successMessage, 'success');
            }

            if (window.swalToast && errorMessage) {
                window.swalToast(errorMessage, 'danger');
            }
        });
    </script>
</body>
</html>
