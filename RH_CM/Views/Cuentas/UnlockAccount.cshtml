@model RH_CM.ViewModels.UnlockAccountViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Unlock account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="card border shadow-sm">

            <!-- Header -->
            <div class="card-header bg-light border-bottom">
                <h3 class="card-title mb-0 fw-bold text-dark">
                    <i class="fas fa-retweet me-2 text-secondary"></i>
                    UNLOCK ACCOUNT
                </h3>
                <small class="text-muted">
                    Enter the username of the account you want to unlock.
                </small>
            </div>

            <div class="card-body">

                <form asp-controller="Cuentas" asp-action="UnlockAccount" method="post">

                    @* Validation summary *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All"
                             class="alert alert-danger py-2 mb-3"
                             role="alert"></div>
                    }

                    <div class="row mt-3">
                        <div class="col-12">

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label fw-semibold">Username</label>
                                <input asp-for="UserName"
                                       class="form-control"
                                       placeholder="Enter the username to unlock" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end">
                        <button type="submit"
                                class="btn btn-primary px-4" title="Unlock Account">
                            <i class="fas fa-unlock me-1"></i>
                            Unlock Account
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
