@model RH_CM.Models.AspNetUser

@{
    ViewData["Title"] = "UNLOCK ACCOUNT";
}

<h1 class="h3 mb-3 text-center"><i class="align-middle fas fa-retweet"></i> @ViewData["Title"]</h1>

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-header">
                <h5 class="card-title">UNLOCK USER ACCOUNT</h5>
                <h6 class="card-subtitle text-muted">
                    Enter the Username or NT Username to unlock the account.
                </h6>
            </div>

            <div class="card-body">
                <form asp-action="UnlockAccount" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="mb-2 col-md-4">
                            <label asp-for="UserName" class="form-label">
                                Username <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   asp-for="UserName"
                                   class="form-control"
                                   placeholder="Enter the username" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-2 col-md-4">
                            <label asp-for="Ntuser" class="form-label">
                                NT Username
                            </label>
                            <input type="text"
                                   asp-for="Ntuser"
                                   class="form-control"
                                   placeholder="Enter the NT username (optional)" />
                            <span asp-validation-for="Ntuser" class="text-danger"></span>
                        </div>

                        <div class="mb-2 col-md-4">
                            <label class="form-label">Notes</label>
                            <input type="text"
                                   class="form-control"
                                   value="This will clear LockoutEnd and reset failed attempts."
                                   readonly />
                        </div>
                    </div>

                    <div class="col-12 text-end mt-3">
                        <a asp-action="Acceso"
                           asp-controller="Cuentas"
                           class="btn btn-secondary"
                           onclick="return confirm('Are you sure you want to cancel?')">
                            <i class="align-middle fas fa-arrow-left"></i> CANCEL
                        </a>

                        <button type="submit"
                                class="btn btn-primary"
                                onclick="return confirm('Are you sure you want to unlock this account?')">
                            <i class="align-middle fas fa-retweet"></i> UNLOCK ACCOUNT
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Show success / warning / error messages
        if ("@TempData["SuccessMessage"]" !== "") {
            window.notyf.open({
                type: 'success',
                message: "@TempData["SuccessMessage"]",
                ripple: true,
                dismissible: true,
                position: { x: 'center', y: 'top' },
                duration: 5000
            });
        }

        if ("@TempData["WarningMessage"]" !== "") {
            window.notyf.open({
                type: 'warning',
                message: "@TempData["WarningMessage"]",
                ripple: true,
                dismissible: true,
                position: { x: 'center', y: 'top' },
                duration: 5000
            });
        }

        if ("@TempData["ErrorMessage"]" !== "") {
            window.notyf.open({
                type: 'error',
                message: "@TempData["ErrorMessage"]",
                ripple: true,
                dismissible: true,
                position: { x: 'center', y: 'top' },
                duration: 5000
            });
        }
    });
</script>
