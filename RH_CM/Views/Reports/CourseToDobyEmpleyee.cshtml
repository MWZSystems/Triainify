@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course pending to do";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-file-pdf"></i> @ViewData["Title"]
        </h1>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                @if (Model.Any())
                {
                    <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                        <thead class="table-primary">
                            <tr>
                                <th>#</th>
                                <th>Course</th>
                                <th>Level</th>
                                <th>Date Completed</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Aquí agregas las filas directamente -->
                            <tr>
                                <td>1</td>
                                <td>Curso Ecologia</td>
                                <td>1</td>
                                <td></td>
                                <td>Falta Realizar</td>
                                <td>
                                    <div class="text-center">
                                        <a class="btn btn-info" asp-controller="Catalog" asp-action="ViewPdfCourseMaterial" asp-route-id="1" target="_blank">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a class="btn btn-outline-warning" asp-action="TestQuestions">
                                            <i class="fas fa-pencil"></i>
                                        </a>

                                        <a class="btn btn-warning" asp-action="TestQuestions2">
                                            <i class="fas fa-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Curso ISO 14001</td>
                                <td>3</td>
                                <td>Julio/20/2024</td>
                                <td>Por Caducar</td>
                                <td>
                                    <div class="text-center">
                                        <a class="btn btn-info" asp-controller="Catalog" asp-action="ViewPdfCourseMaterial" asp-route-id="2" target="_blank">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a class="btn btn-outline-warning" asp-action="TestQuestions">
                                            <i class="fas fa-pencil"></i>
                                        </a>

                                        <a class="btn btn-warning" asp-action="TestQuestions2">
                                            <i class="fas fa-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>CURSO NOM-006.STPS MANEJO DE CARGAS</td>
                                <td>1</td>
                                <td>Julio/14/2025</td>
                                <td>Completado</td>
                                <td>
                                    <div class="text-center">
                                        <a class="btn btn-info" asp-controller="Catalog" asp-action="ViewPdfCourseMaterial" asp-route-id="3" target="_blank">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a class="btn btn-outline-warning" asp-action="TestQuestions">
                                            <i class="fas fa-pencil"></i>
                                        </a>

                                        <a class="btn btn-warning" asp-action="TestQuestions2">
                                            <i class="fas fa-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>
}
