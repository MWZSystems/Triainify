@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course pending to do";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-file-pdf"></i> @ViewData["Title"]
        </h1>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                @if (Model != null && Model.Any())
                {
                    <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                        <thead class="table-primary">
                            <tr>
                                <th>#</th>
                                <th>Material Name</th>
                                <th>Created By</th>
                                <th>Created At</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.PkCoursematerial</td>
                                    <td>@item.MaterialName</td>
                                    <td>@item.Createuser</td>
                                    <td>@(item.Createdate is DateTime dt ? dt.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                    <td>
                                        @{
                                            string availabilityText = item.Available switch
                                            {
                                                1 => "Enabled",
                                                0 => "Disabled",
                                                _ => "Disabled"
                                            };
                                        }
                                        @availabilityText
                                    </td>
                                    <td>
                                        <div class="text-center d-flex gap-1">
                                            <a class="btn btn-info"
                                               asp-controller="Catalog"
                                               asp-action="ViewPdfCourseMaterial"
                                               asp-route-id="@item.PkCoursematerial"
                                               target="_blank"
                                               title="View PDF">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a class="btn btn-primary"
                                               asp-controller="Catalog"
                                               asp-action="DownloadCourseMaterial"
                                               asp-route-id="@item.PkCoursematerial"
                                               title="Download">
                                                <i class="fas fa-download"></i>
                                            </a>

                                            <!-- Si tienes un examen asociado, ajusta routes -->
                                            <a class="btn btn-outline-warning" asp-action="TestQuestions" title="Take test">
                                                <i class="fas fa-pencil"></i>
                                            </a>
                                            <a class="btn btn-warning" asp-action="TestQuestions2" title="Take test (alt)">
                                                <i class="fas fa-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
