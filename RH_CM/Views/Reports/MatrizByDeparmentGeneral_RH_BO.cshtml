<script>
	document.addEventListener("DOMContentLoaded", function() {
		// Bar chart
		new Chart(document.getElementById("chartjs-dashboard-bar-devices"), {
			type: "bar",
				data: {
		labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
		datasets: [
			{
				label: "Goals Met",
				backgroundColor: "rgba(40, 167, 69, 0.7)", // Verde
				borderColor: "rgba(40, 167, 69, 1)",
				hoverBackgroundColor: "rgba(40, 167, 69, 0.9)",
				hoverBorderColor: "rgba(40, 167, 69, 1)",
				data: [75, 82, 69, 88, 70, 90, 76, 85, 92, 78, 80, 87],
				barPercentage: .5,
				categoryPercentage: .5
			},
			{
				label: "Goals Not Met",
				backgroundColor: "rgba(220, 53, 69, 0.7)", // Rojo
				borderColor: "rgba(220, 53, 69, 1)",
				hoverBackgroundColor: "rgba(220, 53, 69, 0.9)",
				hoverBorderColor: "rgba(220, 53, 69, 1)",
				data: [25, 18, 31, 12, 30, 10, 24, 15, 8, 22, 20, 13],
				barPercentage: .5,
				categoryPercentage: .5
			}
		]
	},
	options: {
		maintainAspectRatio: false,
		cornerRadius: 15,
		legend: {
			display: true,
			labels: {
				boxWidth: 20
			}
		},
		scales: {
			yAxes: [{
				gridLines: {
					display: false
				},
				ticks: {
					beginAtZero: true,
					max: 100,
					stepSize: 20,
					callback: function(value) {
						return value + "%";
					}
				},
				stacked: true
			}],
			xAxes: [{
				gridLines: {
					color: "transparent"
				},
				stacked: true
			}]
		},
		tooltips: {
			callbacks: {
				label: function(tooltipItem, data) {
					const dataset = data.datasets[tooltipItem.datasetIndex];
					return dataset.label + ": " + tooltipItem.yLabel + "%";
				}
			}
		}
	}

		});
	});
</script>

<script>
	document.addEventListener("DOMContentLoaded", function() {
		new Chart(document.getElementById("chartjs-dashboard-pie"), {
			type: "pie",
			data: {
				labels: ["Completed", "Pending", "Expiring Soon", "Permanent", "Scheduled"],
				datasets: [{
					data: [78, 31, 17, 21, 24],
					backgroundColor: [
						"#198754", // Completed (bg-success)
						"#dc3545", // Pending (bg-danger)
						"#ffc107", // Expiring Soon (bg-warning)
						"#0d6efd", // Permanent (bg-primary)
						"#212529"  // Scheduled (bg-dark)
					],
					borderWidth: 5,
					borderColor: "#ffffff"
				}]
			},
			options: {
				responsive: !window.MSInputMethodContext,
				maintainAspectRatio: false,
				cutoutPercentage: 70,
				legend: {
					display: true,
					position: "bottom"
				},
				tooltips: {
					callbacks: {
						label: function(tooltipItem, data) {
							const dataset = data.datasets[tooltipItem.datasetIndex];
							const label = data.labels[tooltipItem.index];
							const value = dataset.data[tooltipItem.index];
							return label + ": " + value;
						}
					}
				}
			}
		});
	});
</script>

