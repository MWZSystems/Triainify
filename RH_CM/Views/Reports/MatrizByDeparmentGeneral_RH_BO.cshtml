<script>
	$(document).ready(function () {
		// Inicializar DataTable con traducción al español y sin orden automático
		$('#datatables-responsive').DataTable({
			responsive: true,
			order: []
		});

		// Mostrar mensajes de éxito
		if ('@TempData["SuccessMessage"]' !== '') {
			window.notyf.open({
				type: 'success',
				message: '@TempData["SuccessMessage"]',
				ripple: true,
				dismissible: true,
				position: {
					x: 'center',
					y: 'top'
				},
				duration: 5000
			});
		}

		// Mostrar mensajes de error
		if ('@TempData["ErrorMessage"]' !== '') {
			window.notyf.open({
				type: 'error',
				message: '@TempData["ErrorMessage"]',
				ripple: true,
				dismissible: true,
				position: {
					x: 'center',
					y: 'top'
				},
				duration: 5000
			});
		}
	});
</script>
