@{
    ViewData["Title"] = "HP REPORT";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="align-middle fas fa-chart-pie"></i> @ViewData["Title"]
        </h1>
    </div>
</div>

<div class="row mb-2 mb-xl-3">
    <div class="col-auto ms-auto text-end mt-n1">
        <div class="dropdown me-2 d-inline-block">
            <a class="btn btn-light bg-white shadow-sm dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-display="static">
                <i class="align-middle mt-n1" data-feather="calendar"></i> Filter
            </a>
            <div class="dropdown-menu dropdown-menu-end">
                <h6 class="dropdown-header">Select...</h6>
                <a class="dropdown-item" href="#">AMBIENTAL</a>
                <a class="dropdown-item" href="#">CALIDAD</a>
                <a class="dropdown-item" href="#">SEGURIDAD</a>
                <a class="dropdown-item" href="#">OTROS</a>
            </div>
        </div>
        <button class="btn btn-primary shadow-sm">
            <i class="align-middle" data-feather="refresh-cw">&nbsp;</i>
        </button>
    </div>
</div>

<div class="row">

    <!-- Donut: Completed vs Pending -->
    <div class="col-12 col-lg-5 col-xl-4 d-flex">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Overall Completion</h5>
            </div>
            <div class="card-body d-flex">
                <div class="align-self-center w-100">
                    <div class="py-3">
                        <div class="chart chart-xs">
                            <canvas id="chartjs-dashboard-pie"></canvas>
                        </div>
                    </div>

                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th class="text-end">Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><i class="fas fa-square-full" style="color:#198754"></i> Completed</td>
                                <td class="text-end text-success">99.20%</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-square-full" style="color:#dc3545"></i> Pending</td>
                                <td class="text-end text-danger">0.80%</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>

    <!-- Tabla: pendientes por departamento -->
    <div class="col-12 col-lg-4 d-flex">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Pending by Department</h5>
            </div>
            <table class="table table-striped my-0">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th class="text-end">Pending</th>
                        <th class="d-none d-xl-table-cell w-75">% Pending</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Calidad</td>
                        <td class="text-end">18</td>
                        <td class="d-none d-xl-table-cell">
                            <div class="progress">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 42.86%;" aria-valuenow="42.86" aria-valuemin="0" aria-valuemax="100">42.86%</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Sistemas</td>
                        <td class="text-end">13</td>
                        <td class="d-none d-xl-table-cell">
                            <div class="progress">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 30.95%;" aria-valuenow="30.95" aria-valuemin="0" aria-valuemax="100">30.95%</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Recursos Humanos</td>
                        <td class="text-end">9</td>
                        <td class="d-none d-xl-table-cell">
                            <div class="progress">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 21.43%;" aria-valuenow="21.43" aria-valuemin="0" aria-valuemax="100">21.43%</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Materiales</td>
                        <td class="text-end">2</td>
                        <td class="d-none d-xl-table-cell">
                            <div class="progress">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 4.76%;" aria-valuenow="4.76" aria-valuemin="0" aria-valuemax="100">4.76%</div>
                            </div>
                        </td>
                    </tr>

                    <!-- Resto con 0% -->
                    <tr><td>Moldes</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Operaciones</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Procesos</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Finanzas</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Ingeniería</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Mantenimiento</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Manufactura</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Aduanas y compras</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Ventas y cotizaciones</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                    <tr><td>Departamento</td><td class="text-end">0</td><td class="d-none d-xl-table-cell"><div class="progress"><div class="progress-bar bg-secondary" style="width:0%;">0%</div></div></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Radar: % Pending por departamento (lado de la tabla) -->
    <div class="col-12 col-lg-3 d-flex">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Pending % (Radar)</h5>
            </div>
            <div class="card-body">
                <div class="chart">
                    <canvas id="chartjs-dashboard-radar"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ==== Scripts de gráficos (solo front, sin BD) ==== -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Solo dos datos: Completed vs Pending (estáticos)
        const completed = 99.20;
        const pending = 0.80;

        new Chart(document.getElementById("chartjs-dashboard-pie"), {
            type: "pie",
            data: {
                labels: ["Completed", "Pending"],
                datasets: [{
                    data: [completed, pending],
                    backgroundColor: ["#198754", "#dc3545"],
                    borderWidth: 5,
                    borderColor: "#ffffff"
                }]
            },
            options: {
                responsive: !window.MSInputMethodContext,
                maintainAspectRatio: false,
                cutoutPercentage: 70, // dona
                legend: { display: true, position: "bottom" },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem, data) {
                            const label = data.labels[tooltipItem.index];
                            const value = data.datasets[0].data[tooltipItem.index];
                            return `${label}: ${Number(value).toFixed(2)}%`;
                        }
                    }
                }
            }
        });
    });
</script>

<script>
    // Radar chart con los mismos % de la tabla "Pending by Department"
    document.addEventListener("DOMContentLoaded", function() {
        const labels = [
            "Aduanas y Compras",
            "Calidad",
            "Finanzas",
            "Ingeniería",
            "Mantenimiento",
            "Manufactura",
            "Materiales",
            "Moldes",
            "Operaciones",
            "Procesos",
            "Recursos Humanos",
            "Sistemas",
            "Ventas y Cotizaciones"
        ];

        // % de pendientes por departamento (mismo orden que la tabla)
        const pendingPercents = [
            0.00,   // Aduanas y Compras
            42.86,  // Calidad
            0.00,   // Finanzas
            0.00,   // Ingeniería
            0.00,   // Mantenimiento
            0.00,   // Manufactura
            4.76,   // Materiales
            0.00,   // Moldes
            0.00,   // Operaciones
            0.00,   // Procesos
            21.43,  // Recursos Humanos
            30.95,  // Sistemas
            0.00    // Ventas y Cotizaciones
        ];

        new Chart(document.getElementById("chartjs-dashboard-radar"), {
            type: "radar",
            data: {
                labels: labels,
                datasets: [{
                    label: "% Pending by Department",
                    backgroundColor: "rgba(220, 53, 69, 0.2)",   // rojo claro translúcido
                    borderColor: "rgba(220, 53, 69, 1)",          // rojo intenso
                    pointBackgroundColor: "rgba(220, 53, 69, 1)", // puntos rojos
                    pointBorderColor: "#fff",
                    pointHoverBackgroundColor: "#fff",
                    pointHoverBorderColor: "rgba(220, 53, 69, 1)",
                    data: pendingPercents
                }]
            },
            options: {
                maintainAspectRatio: false,
                legend: { display: true },
                title: { display: false },
                scale: {
                    ticks: {
                        beginAtZero: true,
                        max: 50,          // escala cómoda para tus % actuales
                        stepSize: 10,
                        callback: function(v){ return v + "%"; },
                        showLabelBackdrop: false
                    }
                },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem, data) {
                            const label = data.labels[tooltipItem.index];
                            const value = data.datasets[0].data[tooltipItem.index];
                            return label + ": " + value + "%";
                        }
                    }
                }
            }
        });
    });
</script>

<!-- (Opcional) DataTables / Notyfs si los usas -->
<script>
    $(document).ready(function () {
        $('#datatables-responsive').DataTable?.({
            responsive: true,
            order: []
        });

        if ('@TempData["SuccessMessage"]' !== '') {
            window.notyf?.open({
                type: 'success',
                message: '@TempData["SuccessMessage"]',
                ripple: true,
                dismissible: true,
                position: { x: 'center', y: 'top' },
                duration: 5000
            });
        }
        if ('@TempData["ErrorMessage"]' !== '') {
            window.notyf?.open({
                type: 'error',
                message: '@TempData["ErrorMessage"]',
                ripple: true,
                dismissible: true,
                position: { x: 'center', y: 'top' },
                duration: 5000
            });
        }
    });
</script>
