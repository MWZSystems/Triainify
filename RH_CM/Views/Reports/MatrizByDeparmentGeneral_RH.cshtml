@model RH_CM.ViewModels.CompletedByDepartmentPageViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Completed by Department";
    ViewData["BodyClass"] = "page-completed-department";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var labels = Model.Rows.Select(r => r.Department).ToList();
    var percCompleted = Model.Rows.Select(r => Math.Round(r.PercentCompleted, 2)).ToList();

    var labelsJson = JsonSerializer.Serialize(labels);
    var percCompletedJson = JsonSerializer.Serialize(percCompleted);

    var overallCompleted = Math.Round(Model.OverallCompletedPct, 2);
    var overallPending = Math.Round(Model.OverallPendingPct, 2);

    string currentMS = (ViewBag.ManagementSystem as string) ?? "";
    string msBadge = string.IsNullOrWhiteSpace(currentMS) ? "All" : currentMS.ToUpperInvariant();
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Completed by Department",
            IconClass = "fa-chart-pie",
            HelpBullets = new List<string>
            {
                "Shows the percentage of required training completed vs. pending, per department.",
                "Use the management-system filter to narrow the chart to a specific system, or leave it on \"All\"."
            }
        })" />
        <p class="text-center text-muted">
            Filter: <span class="badge bg-info">@msBadge</span>
        </p>
    </div>
</div>

<div class="row mb-2 mb-xl-3">
    <div class="col-auto ms-auto text-end mt-n1">
        <div class="dropdown me-2 d-inline-block">
            <a class="btn btn-light bg-white shadow-sm dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-display="static" title="Filter by Management System">
                <i class="align-middle mt-n1" data-feather="filter"></i> Filter by Management System
            </a>
            <div class="dropdown-menu dropdown-menu-end">
                <h6 class="dropdown-header">Select...</h6>
                <a class="dropdown-item" href="@Url.Action("MatrizByDeparmentGeneral_RH", "Reports", new { managementSystem = (string?)null })">All</a>
                <a class="dropdown-item" href="@Url.Action("MatrizByDeparmentGeneral_RH", "Reports", new { managementSystem = "AMBIENTAL" })">AMBIENTAL</a>
                <a class="dropdown-item" href="@Url.Action("MatrizByDeparmentGeneral_RH", "Reports", new { managementSystem = "CALIDAD" })">CALIDAD</a>
                <a class="dropdown-item" href="@Url.Action("MatrizByDeparmentGeneral_RH", "Reports", new { managementSystem = "SEGURIDAD" })">SEGURIDAD</a>
                <a class="dropdown-item" href="@Url.Action("MatrizByDeparmentGeneral_RH", "Reports", new { managementSystem = "OTROS" })">OTROS</a>
            </div>
        </div>
        <a class="btn btn-primary shadow-sm"
           href="@Url.Action("MatrizByDeparmentGeneral_RH", "Reports", new { managementSystem = currentMS })"
           title="Refresh">
            <i class="align-middle" data-feather="refresh-cw">&nbsp;</i>
        </a>
    </div>
</div>

<div class="row">

    <div class="col-12 col-lg-5 col-xl-4 d-flex">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Overall Completion</h5>
            </div>
            <div class="card-body d-flex">
                <div class="align-self-center w-100">
                    <div class="py-3">
                        <div class="chart chart-xs">
                            <canvas id="chartjs-dashboard-pie"></canvas>
                        </div>
                    </div>

                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th class="text-end">Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><i class="fas fa-square-full" style="color:#198754"></i> Completed</td>
                                <td class="text-end text-success">@overallCompleted.ToString("N2")%</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-square-full" style="color:#dc3545"></i> Pending</td>
                                <td class="text-end text-danger">@overallPending.ToString("N2")%</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4 d-flex">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Completed by Department</h5>
            </div>
            <table id="datatables-responsive" class="table table-striped my-0">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th class="text-end">Completed</th>
                        <th class="d-none d-xl-table-cell w-75">% Completed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows.OrderByDescending(x => x.PercentCompleted).ThenBy(x => x.Department))
                    {
                        var width = Math.Clamp((double)r.PercentCompleted, 0, 100);
                        <tr>
                            <td>@r.Department</td>
                            <td class="text-end">@r.TotalCompleted</td>
                            <td class="d-none d-xl-table-cell">
                                <div class="progress">
                                    <div class="progress-bar bg-success"
                                         role="progressbar"
                                         style="width: @width.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;"
                                         aria-valuenow="@r.PercentCompleted.ToString("N2")"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @r.PercentCompleted.ToString("N2")%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-12 col-lg-3 d-flex">
        <div class="card flex-fill w-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Completed % (Radar)</h5>
            </div>
            <div class="card-body">
                <div class="chart">
                    <canvas id="chartjs-dashboard-radar"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const completed = @overallCompleted.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const pending = @overallPending.ToString(System.Globalization.CultureInfo.InvariantCulture);

        new Chart(document.getElementById("chartjs-dashboard-pie"), {
            type: "pie",
            data: {
                labels: ["Completed", "Pending"],
                datasets: [{
                    data: [completed, pending],
                    backgroundColor: ["#198754", "#dc3545"],
                    borderWidth: 5,
                    borderColor: "#ffffff"
                }]
            },
            options: {
                responsive: !window.MSInputMethodContext,
                maintainAspectRatio: false,
                cutoutPercentage: 70,
                legend: { display: true, position: "bottom" },
                tooltips: {
                    callbacks: {
                        label: function (tooltipItem, data) {
                            const label = data.labels[tooltipItem.index];
                            const value = data.datasets[0].data[tooltipItem.index];
                            return `${label}: ${Number(value).toFixed(2)}%`;
                        }
                    }
                }
            }
        });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const labels = @Html.Raw(labelsJson);
        const completedPercents = @Html.Raw(percCompletedJson);

        new Chart(document.getElementById("chartjs-dashboard-radar"), {
            type: "radar",
            data: {
                labels: labels,
                datasets: [{
                    label: "% Completed by Department",
                    backgroundColor: "rgba(25, 135, 84, 0.2)",
                    borderColor: "rgba(25, 135, 84, 1)",
                    pointBackgroundColor: "rgba(25, 135, 84, 1)",
                    pointBorderColor: "#fff",
                    pointHoverBackgroundColor: "#fff",
                    pointHoverBorderColor: "rgba(25, 135, 84, 1)",
                    data: completedPercents
                }]
            },
            options: {
                maintainAspectRatio: false,
                legend: { display: true },
                title: { display: false },
                scale: {
                    ticks: {
                        beginAtZero: true,
                        max: 100,
                        stepSize: 10,
                        callback: function (v) { return v + "%"; },
                        showLabelBackdrop: false
                    }
                },
                tooltips: {
                    callbacks: {
                        label: function (tooltipItem, data) {
                            const label = data.labels[tooltipItem.index];
                            const value = data.datasets[0].data[tooltipItem.index];
                            return label + ": " + Number(value).toFixed(2) + "%";
                        }
                    }
                }
            }
        });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        $('#datatables-responsive').DataTable?.({
            responsive: true,
            order: [],
            stateSave: true,
            dom: window.dtButtonsDom,
            buttons: window.dtExportButtons()
        });
    });
</script>