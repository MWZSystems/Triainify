<style>
    /* Modal backdrop */
    #resultado-modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        align-items: center;
        justify-content: center;
    }

        /* Modal box */
        #resultado-modal .modal-content {
            background: white;
            padding: 30px;
            border-radius: 10px;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
        }

        #resultado-modal button {
            margin-top: 20px;
        }
</style>

<form id="exam-form">
    @foreach (var p in preguntas)
    {
        var nombreInput = p.EsCheckbox ? $"p{p.Num}[]" : $"p{p.Num}";

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@p.Num. @p.Texto</h5>
                @for (int i = 0; i < p.Opciones.Length; i++)
                {
                    var id = $"p{p.Num}_{i}";
                    <div class="form-check">
                        <input class="form-check-input"
                               type="@(p.EsCheckbox ? "checkbox" : "radio")"
                               name="@nombreInput"
                               id="@id"
                               data-correct="@(p.Respuestas[i] ? "1" : "0")" />
                        <label class="form-check-label" for="@id">@p.Opciones[i]</label>
                    </div>
                }
                <div class="feedback mt-2" id="feedback-@p.Num"></div>
            </div>
        </div>
    }
    <div class="text-center">
        <button type="submit" class="btn btn-primary">Enviar respuestas</button>
    </div>
</form>

<!-- Modal -->
<div id="resultado-modal">
    <div class="modal-content">
        <h3>Resultados del examen</h3>
        <p id="resultado-text"></p>
        <button id="cerrar-modal" class="btn btn-success">Cerrar</button>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('exam-form');
        const modal = document.getElementById('resultado-modal');
        const resultadoText = document.getElementById('resultado-text');
        const cerrarModalBtn = document.getElementById('cerrar-modal');

        form.addEventListener('submit', e => {
            e.preventDefault();
            let totalCorrectas = 0;

            for (let i = 1; i <= 10; i++) {
                // Armar selector según si checkbox o radio
                let selector = `input[name="p${i}"]`;
                // Comprobar si checkbox para cambiar selector
                const esCheckbox = document.querySelectorAll(`input[name="p${i}[]"]`).length > 0;
                if (esCheckbox) {
                    selector = `input[name="p${i}[]"]`;
                }

                const inputs = document.querySelectorAll(selector);
                const feedback = document.getElementById(`feedback-${i}`);

                const seleccionadas = Array.from(inputs).filter(input => input.checked);
                if (seleccionadas.length === 0) {
                    feedback.innerHTML = "❌ Debes seleccionar al menos una opción";
                    feedback.style.color = "red";
                    continue;
                }

                let correcta = true;
                inputs.forEach(input => {
                    const marcada = input.checked;
                    const esCorrecta = input.dataset.correct === "1";
                    if ((marcada && !esCorrecta) || (!marcada && esCorrecta)) {
                        correcta = false;
                    }
                });

                feedback.innerHTML = correcta ? "✔️ Correcto" : "❌ Incorrecto";
                feedback.style.color = correcta ? "green" : "red";
                if (correcta) totalCorrectas++;
            }

            resultadoText.textContent = `Obtuviste ${totalCorrectas} de 10 preguntas correctas. Calificación: ${(totalCorrectas * 10).toFixed(2)}`;

            modal.style.display = "flex";
        });

        cerrarModalBtn.addEventListener('click', () => {
            modal.style.display = "none";
        });
    </script>
}
