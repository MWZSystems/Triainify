
@model IEnumerable<RH_CM.Service.DTOs.MaterialExamDTOs>
@{
    ViewData["Title"] = "Material vs Exam Missing";
    ViewData["BodyClass"] = "page-missing-material";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Material vs Exam Missing",
            IconClass = "fa-balance-scale",
            HelpBullets = new List<string>
            {
                "Flags course/level combinations that are missing their study material, their test, or both.",
                "Use this to find gaps before employees run into a course they can't actually complete.",
                "Click \"Export to Excel\" to share the list with whoever needs to upload the missing content."
            }
        })" />
    </div>
    <div class="col-auto">
        <a class="btn btn-success" asp-action="ExportMissingMaterialExamReport" title="Export To Excel">
            <i class="align-middle fas fa-file-excel"></i> EXPORT TO EXCEL
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th>#</th>
                            <th>Course Name</th>
                            <th>Level</th>
                            <th>Material</th>
                            <th>Exam</th>
                        </tr>
                    </thead>

                    <!-- Filtros por columna -->
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Level</th>
                            <th>Material</th>
                            <th>Exam</th>
@*                             <th></th> *@
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CourseID</td>
                                <td>@item.CourseName</td>
                                <td>@item.Level</td>
                                <td>
                                    @if (item.Material == "Falta Material")
                                    {
                                        <span style="color: red; font-weight: bold;">@item.Material</span>
                                    }
                                    else
                                    {
                                        @item.Material
                                    }
                                </td>
                                <td>
                                    @if (item.Exam == "Falta Examen")
                                    {
                                        <span style="color: red; font-weight: bold;">@item.Exam</span>
                                    }
                                    else
                                    {
                                        @item.Exam
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <!-- Mensaje alegre -->
                <div class="text-center my-5">
                    <p class="fw-bold" style="color: green; font-size: 1.3rem;">
                        <i class="fas fa-check-circle"></i> No missing Exam/Material found!
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Initialize DataTable only if there are rows
            if (@(Model != null && Model.Any() ? "true" : "false")) {
                var table = $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    stateSave: true,
                    dom: window.dtButtonsDom,
                    buttons: window.dtExportButtons(),
                    initComplete: function () {
                        var api = this.api();

                        // Inputs de texto: Course, Level, Material
                        [1, 2, 3].forEach(function (colIdx) {
                            $('tfoot th').eq(colIdx).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(colIdx).text() + '" />');
                            $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                                if (api.column(colIdx).search() !== this.value) {
                                    api.column(colIdx).search(this.value).draw();
                                }
                            });
                        });

                        // Mostrar la tabla y ocultar el loader
                        $('#loader').fadeOut(150, function () {
                            $('#tableContainer').fadeIn(150);
                        });
                    }
                });
            } else {
                // If there's no data, simply hide the loader and show the message
                $('#loader').fadeOut(150, function () {
                    $('#tableContainer').fadeIn(150);
                });
            }
        });
    </script>
}


