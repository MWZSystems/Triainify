@model IEnumerable<RH_CM.ViewModels.MatrizBySupervisorViewModel>

@{
    ViewData["Title"] = "Matrix By Supervisor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="fas fa-users-gear"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
        
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <table id="datatables-responsive" class="table table-striped my-0" style="width:100%">
                    <thead>
                        <tr>
                            <th class="text-center">No. Control</th>
                            <th class="text-center">Name</th>
                            <th class="text-center">Position</th>
                            <th class="text-center"><span class="badge bg-success">Completed</span></th>
                            <th class="text-center"><span class="badge bg-danger">Pending</span></th>
                            <th class="text-center"><span class="badge bg-warning text-dark">Expiring Soon</span></th>
                            <th class="text-center"><span class="badge bg-dark">Permanent</span></th>
                            <th class="text-center"><span class="badge bg-primary">Scheduled</span></th>
                            <th class="text-center">Actions</th>
                        </tr>
                        <!-- Filtros por columna (opcionales) -->
                        <tr class="table-light">
                            <th><input class="form-control form-control-sm" placeholder="Control #" /></th>
                            <th><input class="form-control form-control-sm" placeholder="Name" /></th>
                            <th><input class="form-control form-control-sm" placeholder="Position" /></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var r in Model)
                            {
                                <tr>
                                    <td class="text-center">@r.CONTROL_NUMBER</td>
                                    <td class="text-center">@r.FullName</td>
                                    <td class="text-center">@r.NAME_POSITION_ENGLISH</td>
                                    <td class="text-center">@r.Completed</td>
                                    <td class="text-center">@r.Pending</td>
                                    <td class="text-center">@r.ExpiringSoon</td>
                                    <td class="text-center">@r.Permanent</td>
                                    <td class="text-center">@r.Scheduled</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(r.UserName))
                                        {
                                            <a class="btn btn-info btn-sm"
                                               asp-action="MatrizbyEmployeeFromSupervisor"
                                               asp-controller="Reports"
                                               asp-route-userName="@r.UserName"
                                               target="_blank"
                                               title="Open employee matrix">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled title="Sin UserName">
                                                <i class="fas fa-eye-slash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Control #</th>
                            <th>Name</th>
                            <th>Position</th>
                            <th>Completed</th>
                            <th>Pending</th>
                            <th>Expiring Soon</th>
                            <th>Permanent</th>
                            <th>Scheduled</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            const table = $('#datatables-responsive').DataTable({
                responsive: true,
                order: [], // sin orden por defecto
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": { "first": "Primero", "last": "Último", "next": "Siguiente", "previous": "Anterior" }
                },
                initComplete: function () {
                    const api = this.api();
                    // Filtros por texto: Control, Name, Position
                    [0, 1, 2].forEach(function (colIdx) {
                        $('thead tr:eq(1) th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });
                }
            });

            // Notificaciones (solo success y error)
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
