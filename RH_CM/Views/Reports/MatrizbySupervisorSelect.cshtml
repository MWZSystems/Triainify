@model RH_CM.ViewModels.SelectSupervisorViewModel

@{
    ViewData["Title"] = "Matriz By Supervisor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="fas fa-user-tie"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto">
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Choose Supervisor</h5>
                <h6 class="card-subtitle text-muted">Select a supervisor to view the matrix.</h6>
            </div>
            <div class="card-body">
                <form asp-action="MatrizbySupervisorSelect" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- Supervisor -->
                        <div class="mb-3 col-md-8">
                            <label asp-for="SelectedSupervisorId" class="form-label">
                                Supervisor <span class="text-danger">*</span>
                            </label>
                            <select asp-for="SelectedSupervisorId"
                                    class="form-control select2"
                                    data-placeholder="-- Select Supervisor --"
                                    asp-items="Model.Supervisors">
                                <option></option>
                            </select>
                            <span asp-validation-for="SelectedSupervisorId" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="row">
                        <div class="col-12 text-end">
                            <a href="javascript:history.back()" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="align-middle fas fa-check-circle"></i> Continue
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Inicializa Select2
            $(".select2").select2({
                theme: 'bootstrap4',
                allowClear: true,
                width: '100%'
            });

            // Mostrar mensajes de éxito
            if ('@TempData["SuccessMessage"]' !== '') {
                window.notyf.open({
                    type: 'success',
                    message: '@TempData["SuccessMessage"]',
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }

            // Mostrar mensajes de error
            if ('@TempData["ErrorMessage"]' !== '') {
                window.notyf.open({
                    type: 'error',
                    message: '@TempData["ErrorMessage"]',
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
