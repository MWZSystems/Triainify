@model RH_CM.ViewModels.SelectSupervisorViewModel

@{
    ViewData["Title"] = "Select Supervisor";
    ViewData["BodyClass"] = "page-matrix-supervisor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Select Supervisor",
            IconClass = "fa-user-tie",
            HelpBullets = new List<string>
            {
                "Step 1 of the \"Matrix by Supervisor\" report: pick which supervisor's team you want to review.",
                "After choosing a supervisor and clicking Continue, you'll see the training matrix for everyone reporting to them."
            }
        })" />
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Choose Supervisor</h5>
                <h6 class="card-subtitle text-muted">Select a supervisor to view the matrix.</h6>
            </div>
            <div class="card-body">
                <form asp-action="MatrizbySupervisorSelect" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="mb-3 col-md-8">
                            <label asp-for="SelectedSupervisorId" class="form-label">
                                Supervisor <span class="text-danger">*</span>
                            </label>
                            <select asp-for="SelectedSupervisorId"
                                    class="form-control select2"
                                    data-placeholder="-- Select Supervisor --"
                                    asp-items="Model.Supervisors">
                                <option></option>
                            </select>
                            <span asp-validation-for="SelectedSupervisorId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-end">
                            <a href="javascript:history.back()" class="btn btn-secondary" title="Cancel">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" title="Continue">
                                <i class="align-middle fas fa-check-circle"></i> Continue
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $(".select2").select2({
                theme: 'bootstrap4',
                allowClear: true,
                width: '100%'
            });

});
    </script>
}