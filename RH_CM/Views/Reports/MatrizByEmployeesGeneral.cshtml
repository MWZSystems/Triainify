@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Inicializar DataTable con traducción al español y sin orden automático
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [], // Evitar el orden automático por cualquier columna
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 Entradas",
                    "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ Entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            // Mostrar mensajes de éxito y error
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf.open({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }

            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf.open({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: {
                        x: 'center',
                        y: 'top'
                    },
                    duration: 5000
                });
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Pie chart
            new Chart(document.getElementById("chartjs-dashboard-pie"), {
                type: "pie",
                data: {
                    labels: ["Programado", "Permanente", "Vencer", "Falta", "Completo"],
                    datasets: [{
                        data: [2, 3, 4, 5, 6],
                        backgroundColor: [
                            "#0d6efd", // Azul - Programado
                            "#000000", // Negro - Permanente
                            "#ffc107", // Naranja - Vencer
                            "#dc3545", // Rojo - Falta
                            "#198754"  // Verde - Completo
                        ],
                        borderWidth: 5,
                        borderColor: "#ffffff"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "70%", // reemplaza cutoutPercentage
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        });
    </script>


}