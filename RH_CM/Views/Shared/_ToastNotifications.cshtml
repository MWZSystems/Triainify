@using System.Text.Json
@{
    // The only place in the app that reads TempData and fires the SweetAlert2 toasts.
    // Serialized with JsonSerializer so a message with quotes or apostrophes doesn't break
    // the generated script.
    var toasts = new (string? Message, string Type)[]
    {
        (TempData["SuccessMessage"] as string, "success"),
        (TempData["ErrorMessage"] as string, "danger"),
        (TempData["WarningMessage"] as string, "warning"),
        (TempData["InfoMessage"] as string, "default"),
    };
}

@if (toasts.Any(t => !string.IsNullOrWhiteSpace(t.Message)))
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.swalToast) { return; }

            @foreach (var toast in toasts)
            {
                if (!string.IsNullOrWhiteSpace(toast.Message))
                {
                    <text>
                    window.swalToast(@Html.Raw(JsonSerializer.Serialize(toast.Message)), @Html.Raw(JsonSerializer.Serialize(toast.Type)));
                    </text>
                }
            }
        });
    </script>
}
