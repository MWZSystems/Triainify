@model RH_CM.ViewModels.PageHeaderViewModel
@{
    var helpTitle = string.IsNullOrWhiteSpace(Model.HelpTitle) ? Model.Title : Model.HelpTitle;
}

@if (Model.HelpBullets.Any())
{
    <div class="modal fade" id="pageHelpModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-question-circle me-2"></i>@helpTitle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="mb-0">
                        @foreach (var bullet in Model.HelpBullets)
                        {
                            <li>@bullet</li>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" title="Got it">Got it</button>
                </div>
            </div>
        </div>
    </div>
}
