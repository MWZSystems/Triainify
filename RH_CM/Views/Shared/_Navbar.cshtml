@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@* @inject RH_CM.Service.AccessGroups.AccessGroupsService _accessGroups *@

@inject IHttpContextAccessor HttpContextAccessor
@using Newtonsoft.Json
@using RH_CM.Service.DTOs

@{
    GroupsAccessDTOs accesos = null;
    var accesosJson = HttpContextAccessor.HttpContext.Session.GetString("Accesos");
    if (!string.IsNullOrEmpty(accesosJson))
    {
        accesos = JsonConvert.DeserializeObject<GroupsAccessDTOs>(accesosJson);
    }
}

<nav class="navbar navbar-expand navbar-light navbar-bg">
    @* Optional sidebar toggle *@
    @* 
    <a class="sidebar-toggle">
        <i class="hamburger align-self-center"></i>
    </a> 
    *@

    <ul class="navbar-nav">
        <li class="nav-item px-2 dropdown">
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none">
                <img src="~/assets/dist/img/icons/logocm.jpeg"
                     alt="Home"
                     style="width: 60px; height: 30px; margin-right: 8px;">
            </a>

        </li>
        @if (User.Identity.IsAuthenticated)
        {
            // =========================
            // CATALOGS MENU
            // =========================
            @if (accesos.ShowCatalogsMenu) // New method based on Group Role
            {
                <li class="nav-item px-2 dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="servicesDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-haspopup="true"
                       aria-expanded="false">
                        CATALOGS
                    </a>

                    <div class="dropdown-menu dropdown-menu-start dropdown-mega" aria-labelledby="servicesDropdown">
                        <div class="d-md-flex align-items-start justify-content-start">
                            <div class="dropdown-mega-list">

                                @if (accesos.OnBoarding)
                                {
                                    <a class="dropdown-item" asp-controller="HeadCount" asp-action="IndexHeadCount">
                                        <i class="align-middle fas fa-user-plus"></i> Onboarding
                                    </a>
                                }

                                @if (accesos.Offboarding)
                                {
                                    <a class="dropdown-item" asp-controller="HeadCount" asp-action="IndexOFFBoarding">
                                        <i class="align-middle fas fa-user-minus"></i> Offboarding
                                    </a>
                                }

                                @if (accesos.Supervisor)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexSupervisor">
                                        <i class="align-middle fas fa-users-cog"></i> Supervisors
                                    </a>
                                }

                                @if (accesos.Department)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexDepartment">
                                        <i class="align-middle fas fa-store-alt"></i> Departments
                                    </a>
                                }

                                @if (accesos.Position)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexPosition">
                                        <i class="align-middle fas fa-chess-board"></i> Positions
                                    </a>
                                }

                                @if (accesos.Course)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexCourse">
                                        <i class="align-middle fas fa-book"></i> Courses
                                    </a>
                                }

                                @if (accesos.CourseMaterial)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexCourseMaterial">
                                        <i class="align-middle fas fa-file-pdf"></i> Course Materials
                                    </a>
                                }

                                @if (accesos.ThematicArea)
                                {
                                    <a class="dropdown-item" asp-controller="ThematicArea" asp-action="Index">
                                        <i class="align-middle fas fa-warehouse"></i> Thematic Areas
                                    </a>
                                }

                                @if (accesos.Test)
                                {
                                    <!-- Divider -->
                                    <hr class="dropdown-divider" />

                                    <!-- Exams submenu -->
                                    <div class="dropdown-mega-sublist">
                                        <h6 class="dropdown-header">Exams</h6>
                                        <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexTest">
                                            <i class="align-middle fas fa-clipboard-list"></i> Tests
                                        </a>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                </li>
            }

            // =========================
            // ASSIGNMENTS MENU
            // =========================
            @if (accesos.ShowAssignmentsMenu)
            {
                <li class="nav-item px-2 dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="servicesDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-haspopup="true"
                       aria-expanded="false">
                        ASSIGNMENTS
                    </a>

                    <div class="dropdown-menu dropdown-menu-start dropdown-mega" aria-labelledby="servicesDropdown">
                        <div class="d-md-flex align-items-start justify-content-start">
                            <div class="dropdown-mega-list">

                                @if (accesos.CourseAssignments)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexCourseassignments">
                                        <i class="align-middle fas fa-outdent"></i> Course Assignments
                                    </a>
                                }

                                @if (accesos.CourseCompleted)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexCourseCompleted">
                                        <i class="align-middle fas fa-check-circle"></i> Courses Completed
                                    </a>
                                }

                                @if (accesos.CourseLevelMaterial)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexCourseLevelMaterial">
                                        <i class="align-middle fas fa-file-signature"></i> Course–Level Materials
                                    </a>
                                }

                                @if (accesos.ExternalEvidence)
                                {
                                    <a class="dropdown-item" asp-controller="Catalog" asp-action="IndexExternalEvidence">
                                        <i class="align-middle fas fa-receipt"></i> External Evidence
                                    </a>
                                }

                                @if (accesos.OcupationCode)
                                {
                                    <a class="dropdown-item" asp-controller="OcupationKey" asp-action="Index">
                                        <i class="align-middle fas fa-briefcase"></i> Occupation Code
                                    </a>
                                }

                                @if (accesos.ThematicCourse)
                                {
                                    <a class="dropdown-item" asp-controller="ThematicCourse" asp-action="Index">
                                        <i class="align-middle fas fa-map"></i> Thematic – Course
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                </li>
            }

            // =========================
            // REPORTS MENU
            // =========================
            @if (accesos.ShowReportsMenu)
            {
                <li class="nav-item px-2 dropdown">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="servicesDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-haspopup="true"
                       aria-expanded="false">
                        REPORTS
                    </a>

                    <div class="dropdown-menu dropdown-menu-start dropdown-mega" aria-labelledby="servicesDropdown">
                        <div class="d-md-flex align-items-start justify-content-start">
                            <div class="dropdown-mega-list">

                                @if (accesos.MatrixByPosition)
                                {
                                    <a class="dropdown-item" asp-controller="Trainify" asp-action="MatrizbyPositionSelectPosition">
                                        <i class="align-middle fas fa-list-check"></i> Matrix by Position
                                    </a>
                                }

                                @if (accesos.MatrixBySupervisor)
                                {
                                    <a class="dropdown-item" asp-controller="Reports" asp-action="MatrizbySupervisorSelect">
                                        <i class="align-middle fas fa-user-tie"></i> Matrix by Supervisor
                                    </a>
                                }

                                @if (accesos.HRReport)
                                {
                                    <a class="dropdown-item" asp-controller="Reports" asp-action="MatrizByDeparmentGeneral_RH">
                                        <i class="align-middle fas fa-chart-pie"></i> Completed by Department
                                    </a>
                                }

                                @if (accesos.MaterialExamMissing)
                                {
                                    <a class="dropdown-item" asp-controller="Reports" asp-action="MissingMaterialExamReport">
                                        <i class="align-middle fas fa-balance-scale"></i> Missing Material/Exam
                                    </a>
                                }

                                @if (accesos.EvidenceByUser)
                                {
                                    <a class="dropdown-item" asp-controller="UserTestEvidence" asp-action="Index">
                                        <i class="align-middle fas fa-file-archive"></i> Evidence by User
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                </li>
            }

            // =========================
            // TRAINIFY MENU (available to all users)
            // =========================
            <li class="nav-item px-2 dropdown">
                <a class="nav-link dropdown-toggle"
                   href="#"
                   id="servicesDropdown"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-haspopup="true"
                   aria-expanded="false">
                    TRAINIFY
                </a>

                <div class="dropdown-menu dropdown-menu-start dropdown-mega" aria-labelledby="servicesDropdown">
                    <div class="d-md-flex align-items-start justify-content-start">
                        <div class="dropdown-mega-list">

                            <a class="dropdown-item" asp-controller="Trainify" asp-action="MatrizbyEmployee">
                                <i class="align-middle fas fa-id-card-alt"></i> Matrix by Employee
                            </a>

                            <a class="dropdown-item" asp-controller="Trainify" asp-action="LearningTrainify">
                                <i class="align-middle fas fa-graduation-cap"></i> Learning
                            </a>

                        </div>
                    </div>
                </div>
            </li>
        }
    </ul>

    <div class="navbar-collapse collapse">
        <ul class="navbar-nav navbar-align">
            <li class="nav-item dropdown">

                <a class="nav-icon dropdown-toggle d-inline-block d-sm-none" href="#" data-bs-toggle="dropdown">
                    <i class="align-middle" data-feather="settings"></i>
                </a>

                <a class="nav-link dropdown-toggle d-none d-sm-inline-block" href="#" data-bs-toggle="dropdown">
                    <i class="avatar img-fluid rounded-circle me-1" data-feather="user"></i>
                    <span class="text-dark">@UserManager.GetUserName(User)</span>
                </a>

                <div class="dropdown-menu dropdown-menu-end">

                    @if (User.Identity.IsAuthenticated)
                    {
                        var user = await UserManager.GetUserAsync(User);
                        var roles = await UserManager.GetRolesAsync(user);
                        <a class="dropdown-item">
                            <i class="fas fa-id-badge"></i> Role: @roles.FirstOrDefault()
                        </a>
                    }

                    @* User management menu *@
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (accesos.Users)
                        {
                            <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                <i class="align-middle fas fa-users-cog"></i> Users
                            </a>
                        }
                        @* @if (accesos.RegisterNewUser)
                        {
                            <a class="dropdown-item" asp-controller="Cuentas" asp-action="RegistroAdministrador">
                                <i class="fas fa-user-plus"></i> Create User
                            </a>
                        } *@
                        @if (accesos.Roles)
                        {
                            <a class="dropdown-item" asp-controller="Roles" asp-action="Index">
                                <i class="fas fa-user-tag"></i> Roles
                            </a>
                        }
                        @if (accesos.Permissions)
                        {
                            <a class="dropdown-item" asp-controller="Permissions" asp-action="Index">
                                <i class="fas fa-user-shield me-2 text-secondary"></i> Permissions
                            </a>
                        }

                        @if (accesos.Resetpassword)
                        {
                            <a class="dropdown-item" asp-controller="Cuentas" asp-action="ResetPassword">
                                <i class="fas fa-lock-open"></i> Reset Password
                            </a>
                        }

                        <a class="dropdown-item" asp-controller="Cuentas" asp-action="UnlockAccount">
                            <i class="fas fa-retweet"></i> Unlock Account
                        </a>
                    }

                    <form id="logoutForm"
                          method="post"
                          class="form-inline"
                          asp-controller="Cuentas"
                          asp-action="SalirAplicacion">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-sign-out-alt"></i> Log out
                        </button>
                    </form>

                </div>
            </li>
        </ul>
    </div>
</nav>
