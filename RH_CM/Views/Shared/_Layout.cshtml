@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- VERY IMPORTANT for Blazor: pins routes to the site root -->
    <base href="~/" />

    <title>@ViewData["Title"] - RH</title>

    <!-- Base theme styles -->
    <link rel="stylesheet" href="~/Assets/dist/css/light.css" asp-append-version="true" />
    <link rel="shortcut icon" href="~/Assets/favicon.ico" />

    <!-- Typography (visual reference: uupm.cc) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />

    <!-- Select2 (global) -->
    <link rel="stylesheet" href="~/Assets/dist/css/select2.css" asp-append-version="true" />

    <!-- BootstrapBlazor CSS (from NuGet) -->
    @* <link rel="stylesheet" href="~/_content/BootstrapBlazor/css/bootstrap.blazor.bundle.min.css" /> *@

    @RenderSection("head", required: false)

    <!-- Per-page palettes/accents -->
    <link rel="stylesheet" href="~/Assets/dist/css/bodyclass.css" asp-append-version="true" />

    <!-- Brand tokens (primary color, typography, buttons/badges) -->
    <link rel="stylesheet" href="~/Assets/dist/css/theme-uupm.css" asp-append-version="true" />

    <!-- Loading overlay -->
    <link rel="stylesheet" href="~/Assets/dist/css/LoadingOverlay.css" asp-append-version="true" />

    <!-- Barra de botones propia para DataTables (exportar/imprimir/columnas), global para todas las tablas -->
    <link rel="stylesheet" href="~/Assets/dist/css/DatatableExtras.css" asp-append-version="true" />
</head>

<body class="@(ViewData["BodyClass"] as string ?? "")"
      data-theme="default" data-layout="fluid"
      data-sidebar-position="left" data-sidebar-behavior="sticky">

    <div id="pageLoadingOverlay" class="page-loading-overlay" aria-hidden="true">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    @{
        // Read the version from appsettings and expose it to views/partials
        var appVersion = Configuration["AppSettings:ApplicationVersion"];
        ViewBag.AppVersion = appVersion;
    }

    <div class="wrapper">
        @* <partial name="_Sidebar" /> *@
        <main class="main">
            @{
                var hideNavbar = ViewBag.HideNavbar as bool? ?? false; // o ViewData["HideNavbar"]
            }
            @if (!hideNavbar)
            {
                <partial name="_Navbar" />
            }

            <main class="content">
                <div class="container-fluid p-0">
                    @RenderBody()
                </div>
            </main>

            <partial name="_Footer" />
        </main>
    </div>

    <!-- JS de BootstrapBlazor (desde NuGet) -->
    @* <script src="~/_content/BootstrapBlazor/js/bootstrap.blazor.bundle.min.js"></script> *@

    <!-- JSZip: requerido por el botón "Excel" de DataTables Buttons (empaquetado en app.js) -->
    <script src="~/lib/jszip/jszip.min.js" asp-append-version="true"></script>

    <!-- JS base -->
    <script src="~/Assets/dist/js/app.js" asp-append-version="true"></script>

    <!-- Barra de botones propia para DataTables (exportar/imprimir/columnas), global para todas las tablas -->
    <script src="~/Assets/dist/js/datatable-extras.js" asp-append-version="true"></script>

    <!-- Select2 (global) -->
    <script src="~/Assets/dist/js/select2.min.js" asp-append-version="true"></script>

    <!-- Loading overlay (shown on every page navigation and AJAX call) -->
    <script src="~/Assets/dist/js/loading-overlay.js" asp-append-version="true"></script>

    <!-- SweetAlert2 (global messages/confirmations) -->
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/Assets/dist/js/sweetalert-helpers.js" asp-append-version="true"></script>

    <!-- Blazor Server runtime (requerido para componentes interactivos) -->
    <script src="~/_framework/blazor.server.js"></script>

    <!-- Notificaciones estandarizadas (SuccessMessage/ErrorMessage/WarningMessage/InfoMessage) -->
    <partial name="_ToastNotifications" />

    @RenderSection("Scripts", required: false)
</body>
</html>
