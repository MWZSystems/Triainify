@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 👇 MUY IMPORTANTE para Blazor: fija las rutas a la raíz del sitio -->
    <base href="~/" />

    <title>@ViewData["Title"] - RH</title>

    <!-- Estilos base del tema -->
    <link rel="stylesheet" href="~/assets/dist/css/light.css" asp-append-version="true" />
    <link rel="shortcut icon" href="~/assets/favicon.ico" />

    <!-- Select2 (global) -->
    <link rel="stylesheet" href="~/assets/dist/css/select2.css" asp-append-version="true" />

    <!-- CSS de BootstrapBlazor (desde NuGet) -->
    @* <link rel="stylesheet" href="~/_content/BootstrapBlazor/css/bootstrap.blazor.bundle.min.css" /> *@

    @RenderSection("head", required: false)

    <!-- Paletas/acentos por página -->
    <link rel="stylesheet" href="~/assets/dist/css/bodyclass.css" asp-append-version="true" />
</head>

<body class="@((string)ViewData["BodyClass"] ?? "")"
      data-theme="default" data-layout="fluid"
      data-sidebar-position="left" data-sidebar-behavior="sticky">

    @{
        // Leer versión desde appsettings y exponerla a las vistas/partials
        var appVersion = Configuration["AppSettings:ApplicationVersion"];
        ViewBag.AppVersion = appVersion;
    }

    <div class="wrapper">
        @* <partial name="_Sidebar" /> *@
        <main class="main">
            @{
                var hideNavbar = ViewBag.HideNavbar as bool? ?? false; // o ViewData["HideNavbar"]
            }
            @if (!hideNavbar)
            {
                <partial name="_Navbar" />
            }

            <main class="content">
                <div class="container-fluid p-0">
                    @RenderBody()
                </div>
            </main>

            <partial name="_Footer" />
        </main>
    </div>

    <!-- JS de BootstrapBlazor (desde NuGet) -->
    @* <script src="~/_content/BootstrapBlazor/js/bootstrap.blazor.bundle.min.js"></script> *@

    <!-- JS base -->
    <script src="~/assets/dist/js/app.js" asp-append-version="true"></script>
    <!-- Select2 (global) -->
    <script src="~/assets/dist/js/select2.js" asp-append-version="true"></script>

    <!-- Blazor Server runtime (requerido para componentes interactivos) -->
    <script src="~/_framework/blazor.server.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
