@model List<RH_CM.Service.DTOs.ThematicArea.ThematicAreaDTOs>

@{
    ViewData["Title"] = "Thematic Areas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-matrix-position";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center title-accent">
            <i class="fas fa-warehouse"></i> @ViewData["Title"]
        </h1>
    </div>
    @* <div class="col-auto">
        <a asp-action="Index" asp-controller="Permissions" class="btn btn-secondary">
            <i class="fas fa-rotate-left"></i> CHANGE GROUP
        </a>
    </div> *@
</div>


<div id="tableContainer">
    <div class="card">
        @* <div class="card-header">
            <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                <div class="p-3 fw-bold rounded fs-3">
                    Group ID: @Model.GroupId
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Group Name: @Model.GroupName
                </div>
            </div>
        </div> *@
        <div class="card-body">
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addThematicArea">
                    <i class="fas fa-plus"></i> Add Thematic Area
                </button>
            </div>
            @if (Model != null)
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Thematic Name</th>
                            <th>Thematic Code</th>
                            <th>Actions</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model)
                        {
                            <tr>
                                <td>@detail.Id</td>
                                <td>@detail.ThematicName</td>
                                <td>@detail.ThematicCode</td>

                                <td>
                                    <form asp-action="ToggleThematicArea" asp-route-id="@detail.Id" method="post" class="d-inline" onsubmit=" return confirm('Are you sure you want to toggle availability?')">
                                        <button type="submit" class="btn @(detail.Available == 1 ? "btn-success" : "btn-secondary")" title="Toggle availability">
                                            <i class="align-middle fas @(detail.Available == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="EditThematicArea" asp-route-Id="@detail.Id" method="get" class="d-inline">
                                        <button type="submit" class="btn btn-warning">
                                            <i class="align-middle fas fa-edit"></i>
                                        </button>
                                    </form>

                                    <form asp-action="DeleteThematicArea" asp-route-Id="@detail.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Thematic Area?');">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="align-middle fas fa-window-close"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>



<div class="modal fade" id="addThematicArea" tabindex="-1" aria-labelledby="addThematicAreaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddThematicArea" asp-controller="ThematicArea" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addThematicAreaLabel">Add Thematic Area</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @* <input type="hidden" name="GroupId" value="@Model.GroupId" /> *@

                    <div class="row mb-3">
                        <!-- Thematic Area Name -->
                        <div class="col-md-6">
                            <label for="ThematicAreaName" class="form-label">Enter Thematic Area Name</label>
                            <input type="text" id="ThematicAreaName" name="ThematicAreaName"
                                   class="form-control" min="1" required placeholder="Enter Name" />
                        </div>

                        <!-- Thematic Area Code -->
                        <div class="col-md-6">
                            <label for="ThematicAreacode" class="form-label">Enter Area Code</label>
                            <input type="number" id="ThematicAreacode" name="ThematicAreacode"
                                   class="form-control" min="1" required placeholder="Enter code" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 50,
                    lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]]
                });
            }

            // Solo success y error
            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
