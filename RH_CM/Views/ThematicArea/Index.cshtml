@model List<RH_CM.Service.DTOs.ThematicArea.ThematicAreaDTOs>

@{
    ViewData["Title"] = "Thematic Areas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "page-thematic-area";
}

<div class="row">
    <div class="col">
        <partial name="_PageHeader" model="@(new RH_CM.ViewModels.PageHeaderViewModel
        {
            Title = "Thematic Areas",
            IconClass = "fa-warehouse",
            HelpBullets = new List<string>
            {
                "Thematic areas group related courses under a common subject.",
                "Click \"Add Thematic Area\" to create one, or use the row actions to edit or toggle an existing one."
            }
        })" />
    </div>
</div>


<div id="tableContainer">
    <div class="card">
        @* <div class="card-header">
            <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                <div class="p-3 fw-bold rounded fs-3">
                    Group ID: @Model.GroupId
                </div>
                <div class="p-3 fw-bold rounded fs-3">
                    Group Name: @Model.GroupName
                </div>
            </div>
        </div> *@
        <div class="card-body">
            <div class="d-flex justify-content-end gap-2 mb-3">
                <a class="btn btn-outline-success" asp-action="ExportThematicAreaFullData" title="Export the complete database data for this catalog, for validation purposes">
                    <i class="align-middle fas fa-database"></i> EXPORT FULL DATA
                </a>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addThematicArea" title="Add Thematic Area">
                    <i class="align-middle fas fa-plus-square"></i> Add Thematic Area
                </button>
            </div>
            @if (Model != null)
            {
                <table id="datatables-responsive" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th data-orderable="false" class="no-export">Actions</th>
                            <th>ID</th>
                            <th>Thematic Name</th>
                            <th>Thematic Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model)
                        {
                            <tr>
                                <td>
                                    <div class="dropdown row-actions-menu">
                                        <button class="btn btn-sm btn-outline-secondary btn-row-actions dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="fas fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <form asp-action="EditThematicArea" asp-route-Id="@detail.Id" method="get">
                                                    <button type="submit" class="dropdown-item text-warning"><i class="align-middle fas fa-edit me-2"></i>Edit</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="ToggleThematicArea" asp-route-id="@detail.Id" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to toggle availability?">
                                                    <button type="submit" class="dropdown-item @(detail.Available == 1 ? "text-success" : "text-secondary")">
                                                        <i class="align-middle fas @(detail.Available == 1 ? "fa-toggle-on" : "fa-toggle-off") me-2"></i>Toggle availability
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="DeleteThematicArea" asp-route-Id="@detail.Id" method="post" class="js-confirm-submit" data-confirm-message="Are you sure you want to delete this Thematic Area?">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="align-middle fas fa-window-close me-2"></i>Delete</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                                <td>@detail.Id</td>
                                <td>@detail.ThematicName</td>
                                <td>@detail.ThematicCode</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No records found</p>
            }
        </div>
    </div>
</div>



<div class="modal fade" id="addThematicArea" tabindex="-1" aria-labelledby="addThematicAreaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddThematicArea" asp-controller="ThematicArea" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addThematicAreaLabel">Add Thematic Area</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
                </div>
                <div class="modal-body">
                    @* <input type="hidden" name="GroupId" value="@Model.GroupId" /> *@

                    <div class="row mb-3">
                        <!-- Thematic Area Name -->
                        <div class="col-md-6">
                            <label for="ThematicAreaName" class="form-label">Enter Thematic Area Name</label>
                            <input type="text" id="ThematicAreaName" name="ThematicAreaName"
                                   class="form-control" min="1" required placeholder="Enter Name" />
                        </div>

                        <!-- Thematic Area Code -->
                        <div class="col-md-6">
                            <label for="ThematicAreacode" class="form-label">Enter Area Code</label>
                            <input type="number" id="ThematicAreacode" name="ThematicAreacode"
                                   class="form-control" min="1" required placeholder="Enter code" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" title="Add Thematic Area">Add Thematic Area</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(function () {
            const tbl = document.getElementById('datatables-responsive');
            if (tbl) {
                $('#datatables-responsive').DataTable({
                    responsive: true,
                    order: [],
                    pageLength: 50,
                    lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]],
                    stateSave: true,
                    dom: window.dtButtonsDom,
                    buttons: window.dtExportButtons()
                });
            }

            // Solo success y error
});
    </script>
}
