@using RV = RH_CM.ViewModels.ViewModels
@model RV.DiagnosticResultViewModel

@{
    ViewData["Title"] = "Diagnostic Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-2 text-center">Diagnostic Result: @Model.TestName</h1>

        <div class="text-center mb-2">
            @if (Model.NextCourseId > 0)
            {
                <span class="badge bg-primary rounded-pill me-1">Course ID: @Model.NextCourseId</span>
            }
            @if (Model.NextLevelId > 0)
            {
                <span class="badge bg-info rounded-pill">Level ID: @Model.NextLevelId</span>
            }
        </div>

        <p class="text-center text-muted">
            Correct: <strong>@Model.CorrectCount / @Model.TotalQuestions</strong> |
            Score: <strong>@Model.Score</strong>/100
        </p>

        <div class="progress mb-3" style="height: 20px;">
            <div class="progress-bar" role="progressbar"
                 style="width:@Model.Score%;"
                 aria-valuenow="@Model.Score" aria-valuemin="0" aria-valuemax="100">
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-10 offset-md-1">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];

            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="alert @(q.IsCorrect ? "alert-success" : "alert-danger") mb-0 rounded-0 rounded-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@q.QuestionText</strong>
                            @if (q.IsCorrect)
                            {
                                <span class="badge rounded-pill bg-success">Correct</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger">Incorrect</span>
                            }
                        </div>
                    </div>

                    <ul class="list-group list-group-flush">
                        @foreach (var opt in (q.Options ?? Enumerable.Empty<RV.DiagnosticOptionResultViewModel>()))
                        {
                            var liClass =
                            (opt.IsSelected && opt.IsCorrect) ? "list-group-item list-group-item-success" :
                            (opt.IsSelected && !opt.IsCorrect) ? "list-group-item list-group-item-danger" :
                            (!opt.IsSelected && opt.IsCorrect) ? "list-group-item" :
                            "list-group-item";

                            <li class="@liClass">
                                <div class="d-flex align-items-start gap-2">
                                    @if (opt.IsSelected && opt.IsCorrect)
                                    {
                                        <i class="fas fa-check text-success mt-1"></i>
                                    }
                                    else if (opt.IsSelected && !opt.IsCorrect)
                                    {
                                        <i class="fas fa-times text-danger mt-1"></i>
                                    }
                                    else if (!opt.IsSelected && opt.IsCorrect)
                                    {
                                        <i class="fas fa-check text-primary mt-1"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-circle text-muted mt-1"></i>
                                    }

                                    <div class="flex-grow-1">
                                        <span>@opt.OptionText</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="px-3 py-2 small text-muted border-top">
                        <span class="me-3"><strong>Selected IDs:</strong> @string.Join(", ", q.SelectedOptionIds ?? new List<int>())</span>
                        <span><strong>Correct IDs:</strong> @string.Join(", ", q.CorrectOptionIds ?? new List<int>())</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Next step: abrir material del curso en la vista con el visor Blazor -->
<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card border-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">Next step: Course Material</div>
                    <div class="text-muted small">
                        CourseId: @Model.NextCourseId | LevelId: @Model.NextLevelId
                    </div>
                </div>

                @if (Model.HasMaterial && Model.NextCourseId > 0 && Model.NextLevelId > 0)
                {
                    <a class="btn btn-success"
                       href="@Url.Action("OpenPdfCourseMaterialByCourseLevel","Catalog",
                                                       new { courseId = Model.NextCourseId, levelId = Model.NextLevelId })">
                    <i class="fas fa-arrow-right"></i> Continue
                </a>
                                }
                else
                {
                    <button class="btn btn-secondary" type="button" disabled title="Material is not available">
                        <i class="fas fa-ban"></i> Continue
                    </button>
                    <span class="text-danger ms-2 small">
                        Course material is not available. Please contact HR.
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            if ('@TempData["SuccessMessage"]' !== '') {
                window.notyf?.open?.({
                    type: 'success',
                    message: '@TempData["SuccessMessage"]',
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ('@TempData["ErrorMessage"]' !== '') {
                window.notyf?.open?.({
                    type: 'error',
                    message: '@TempData["ErrorMessage"]',
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        })();
    </script>
}
