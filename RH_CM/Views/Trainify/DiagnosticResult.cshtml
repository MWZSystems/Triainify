@using RV = RH_CM.ViewModels.ViewModels
@model RV.DiagnosticResultViewModel

@{
    ViewData["Title"] = "Diagnostic Result";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // AssignmentId from ViewBag (defaults to 0 if not provided)
    var assignmentId = ViewBag.CourseAssignmentId as int? ?? 0;

    // URLs to continue (PDF) and fallback (back to the list)
    var pdfUrl = Url.Action("OpenPdfCourseMaterialByCourseLevel", "Catalog",
        new { courseId = Model.NextCourseId, levelId = Model.NextLevelId, courseAssignmentId = assignmentId }) ?? "#";

    var backUrl = Url.Action("LearningTrainify", "Trainify") ?? "/";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-2 text-center">Diagnostic Result: @Model.TestName</h1>

        <!-- Info: no dismissible -->
        <div class="alert alert-info mb-2" role="alert">
            <div class="alert-message text-center">
                Next step: Course Material. If you want to continue with your course process, please click Continue. Scroll down to the button.
            </div>
        </div>

        <!-- Badges estilo uniforme (igual que en Exam Result) -->
        <div class="text-center mb-2">
            @if (Model.NextCourseId > 0)
            {
                <span class="badge bg-primary rounded-pill me-1">Course ID: @Model.NextCourseId</span>
            }
            @if (Model.NextLevelId > 0)
            {
                <span class="badge bg-info text-dark rounded-pill me-1">Level ID: @Model.NextLevelId</span>
            }
            <span class="badge bg-warning text-dark rounded-pill">
                Assignment ID: @(assignmentId > 0 ? assignmentId.ToString() : "—")
            </span>
        </div>

        <!-- Bloque de score con el mismo look & feel -->
        <div class="text-center mb-3">
            <div class="d-inline-block mb-2">
                <div class="alert alert-secondary alert-outline-coloured mb-0" role="alert">
                    <div class="alert-icon">
                        <i class="far fa-fw fa-bell"></i>
                    </div>
                    <div class="alert-message">
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            <span class="badge bg-success">
                                <i class="fa fa-check-circle me-1"></i>
                                Correct: <strong>@Model.CorrectCount / @Model.TotalQuestions</strong>
                            </span>
                            <span class="badge bg-primary">
                                <i class="fa fa-percent me-1"></i>
                                Score: <strong>@Model.Score</strong>/100
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Detalle por pregunta -->
<div class="row">
    <div class="col-md-10 offset-md-1">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];

            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-body p-0">
                    <!-- Encabezado con color por correcta/incorrecta -->
                    <div class="alert @(q.IsCorrect ? "alert-success" : "alert-danger") mb-0 rounded-0 rounded-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>@q.QuestionText</strong>
                            @if (q.IsCorrect)
                            {
                                <span class="badge rounded-pill bg-success">Correct</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger">Incorrect</span>
                            }
                        </div>
                    </div>

                    <!-- Opciones -->
                    <ul class="list-group list-group-flush">
                        @foreach (var opt in (q.Options ?? Enumerable.Empty<RV.DiagnosticOptionResultViewModel>()))
                        {
                            <li class="list-group-item">
                                <div class="d-flex align-items-start gap-2">
                                    @if (opt.IsSelected && opt.IsCorrect)
                                    {
                                        <i class="fas fa-check text-success mt-1"></i>
                                    }
                                    else if (opt.IsSelected && !opt.IsCorrect)
                                    {
                                        <i class="fas fa-times text-danger mt-1"></i>
                                    }
                                    else if (!opt.IsSelected && opt.IsCorrect)
                                    {
                                        <i class="fas fa-check text-primary mt-1"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-circle text-muted mt-1"></i>
                                    }

                                    <div class="flex-grow-1">
                                        <span>@opt.OptionText</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="px-3 py-2 small text-muted border-top">
                        <span class="me-3"><strong>Selected IDs:</strong> @string.Join(", ", q.SelectedOptionIds ?? new List<int>())</span>
                        <span><strong>Correct IDs:</strong> @string.Join(", ", q.CorrectOptionIds ?? new List<int>())</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Next step: abrir material (PDF) y fallback a lista -->
<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card border-success">
            <div class="card-body d-flex align-items-center">
                @if (Model.HasMaterial && Model.NextCourseId > 0 && Model.NextLevelId > 0)
                {
                    <a id="btn-continue"
                       class="btn btn-success ms-auto"
                       href="@pdfUrl" title="Continue">
                        <i class="fas fa-arrow-right"></i> Continue
                    </a>
                }
                else
                {
                    <div class="d-flex align-items-center ms-auto">
                        <button class="btn btn-secondary" type="button" disabled title="Material is not available">
                            <i class="fas fa-ban"></i> Continue
                        </button>
                        <span class="text-danger ms-2 small">
                            Course material is not available. Please contact HR.
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
})();
    </script>
}
