@{
    ViewData["Title"] = "Bulk Upload - Course Completed";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
    <div class="col d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0"><i class="fas fa-file-upload"></i> @ViewData["Title"]</h1>
        <a asp-action="DownloadTemplate" class="btn btn-outline-primary" title="Download Template">
            <i class="fas fa-download"></i> Download Template
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Excel file (.xlsx)</label>
                <input type="file" name="file" accept=".xlsx" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Allow Upsert</label>
                <select name="allowUpsert" class="form-select">
                    <option value="true" selected>Yes (insert/update)</option>
                    <option value="false">No (only insert)</option>
                </select>
            </div>
            <div class="col-12">
                <button class="btn btn-primary" title="Upload"><i class="fas fa-upload"></i> Upload</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
{
    <div class="alert alert-success mt-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}

@if (!string.IsNullOrEmpty(TempData["ErrorTable"] as string))
{
    <div class="card mt-3">
        <div class="card-header fw-bold">Row Errors</div>
        <div class="card-body">
            @Html.Raw(TempData["ErrorTable"] as string)
        </div>
    </div>
}
