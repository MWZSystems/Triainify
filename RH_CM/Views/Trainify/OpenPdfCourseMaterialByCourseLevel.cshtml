@model RH_CM.ViewModels.CourseMaterialViewerViewModel
@{
    ViewBag.HideNavbar = true;
    ViewData["Title"] = "OpenPdfCourseMaterialByCourseLevel";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string streamUrl = !string.IsNullOrWhiteSpace(Model?.StreamUrl)
        ? Model.StreamUrl!.Trim()
        : (Url.Action(
            "StreamPdfCourseMaterialByCourseLevel",
            "Catalog",
            new { courseId = Model?.CourseId ?? 0, levelId = Model?.LevelId ?? 0 },
            protocol: Context.Request.Scheme   // <<--- ABSOLUTO
        ) ?? string.Empty);

    var examUrl = Url.Action("Exam", "Trainify",
        new { courseId = Model?.CourseId ?? 0, levelId = Model?.LevelId ?? 0 }) ?? "#";
}

@if (string.IsNullOrWhiteSpace(streamUrl))
{
    <div class="alert alert-warning">
        No se pudo construir la URL del material. Contacta a RH.
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="border rounded shadow-sm p-2">
                <component type="typeof(RH_CM.Components.CoursePdfViewer)"
                           render-mode="ServerPrerendered"
                           param-CourseId="Model.CourseId"
                           param-LevelId="Model.LevelId"
                           param-StreamUrl="streamUrl"
                           param-ExamUrl="examUrl"
                           param-HeightCss="@("calc(100vh - 180px)")" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        (function () {
            if ('@TempData["SuccessMessage"]' !== '') {
                window.notyf?.open?.({
                    type: 'success',
                    message: '@TempData["SuccessMessage"]',
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ('@TempData["ErrorMessage"]' !== '') {
                window.notyf?.open?.({
                    type: 'error',
                    message: '@TempData["ErrorMessage"]',
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        })();
    </script>
}
