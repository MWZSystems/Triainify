@model RH_CM.ViewModels.CourseMaterialViewerViewModel
@{
    ViewBag.HideNavbar = true;
    ViewData["Title"] = "Course Material";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isPdf = string.Equals(Model?.MaterialType, "PDF", StringComparison.OrdinalIgnoreCase);
    var isVideo = string.Equals(Model?.MaterialType, "VIDEO", StringComparison.OrdinalIgnoreCase);
    var courseId = Model?.CourseId ?? 0;
    var levelId = Model?.LevelId ?? 0;
    var assignmentId = Model?.CourseAssignmentId ?? 0;

    string streamUrl = isPdf && !string.IsNullOrWhiteSpace(Model?.StreamUrl)
        ? Model.StreamUrl!.Trim()
        : (isPdf
            ? (Url.Action(
                "StreamPdfCourseMaterialByCourseLevel",
                "Catalog",
                new { courseId = Model?.CourseId ?? 0, levelId = Model?.LevelId ?? 0 },
                protocol: Context.Request.Scheme) ?? string.Empty)
            : string.Empty);

    var examUrl = Url.Action("Exam", "Trainify",
        new
        {
            courseId = Model?.CourseId ?? 0,
            levelId = Model?.LevelId ?? 0,
            courseAssignmentId = Model?.CourseAssignmentId ?? 0
        }) ?? "#";
}

<div class="row mb-2">
    <div class="col-12 text-center">
        <span class="badge bg-primary me-1">
            <i class="align-middle fas fa-book me-1"></i> Course ID: @(Model?.CourseId ?? 0)
        </span>
        <span class="badge bg-info text-dark me-1">
            <i class="align-middle fas fa-layer-group me-1"></i> Level ID: @(Model?.LevelId ?? 0)
        </span>
        <span class="badge bg-secondary me-1">
            <i class="align-middle fas fa-tag me-1"></i> @((Model?.MaterialType ?? "—").ToUpperInvariant())
        </span>
        <span class="badge bg-warning text-dark">
            <i class="align-middle fas fa-id-badge me-1"></i> Assignment ID: @(assignmentId > 0 ? assignmentId.ToString() : "—")
        </span>
    </div>
</div>

@if (isPdf)
{
    if (string.IsNullOrWhiteSpace(streamUrl))
    {
        <div class="alert alert-warning">
            <i class="align-middle fas fa-exclamation-triangle me-2"></i>
            No se pudo construir la URL del material PDF. Contacta a RH.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="border rounded shadow-sm p-2">
                    <component type="typeof(RH_CM.Components.CoursePdfViewer)"
                               render-mode="ServerPrerendered"
                               param-CourseId="courseId"
                               param-LevelId="levelId"
                               param-StreamUrl="streamUrl"
                               param-ExamUrl="examUrl"
                               param-CourseAssignmentId="assignmentId"
                               param-HeightCss="@("calc(100vh - 180px)")" />
                </div>
            </div>
        </div>
    }
}
else if (isVideo)
{
    <div class="row">
        <div class="col-12">
            <div class="border rounded shadow-sm p-4">
                <div class="d-flex align-items-center mb-3">
                    <i class="fas fa-film fa-lg text-primary me-2"></i>
                    <h5 class="m-0">Tutorial to open the material (VIDEO)</h5>
                </div>

                @if (string.IsNullOrWhiteSpace(Model?.UrlPath))
                {
                    <div class="alert alert-warning">
                        <i class="align-middle fas fa-exclamation-triangle me-2"></i>
                        The material's path was not found (<code>UrlPath</code>). Please contact HR.
                    </div>
                }
                else
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <ol class="mb-3">
                                <li class="mb-2">
                                    <i class="align-middle fas fa-link text-success me-2"></i>
                                    <strong>Select and copy</strong> the following path:
                                    <button class="btn btn-outline-dark" type="button" onclick="selectUrlPath()" title="Select path">
                                        <i class="align-middle fas fa-i-cursor me-1"></i> Select path
                                    </button>
                                </li>
                            </ol>

                            <div class="input-group mb-3">
                                <span class="input-group-text">
                                    <i class="align-middle fas fa-folder-open"></i>
                                </span>
                                <input id="matUrlPath" class="form-control" readonly value="@Model.UrlPath" onclick="selectUrlPath()" />
                                <button id="btnCopyPath" class="btn btn-outline-primary" type="button" onclick="copyMatUrlPath()" title="Copy">
                                    <i class="align-middle fas fa-clipboard me-1"></i> Copy
                                </button>
                            </div>

                            <ol start="2" class="mb-3">
                                <li class="mb-2">
                                    <i class="align-middle me-2 fab fa-fw fa-windows"></i>Open Windows <strong>File Explorer</strong> (<kbd>Win</kbd> + <kbd>E</kbd>).
                                </li>
                                <li class="mb-2">
                                    <i class="align-middle fas fa-paste me-2"></i>Paste the path in the <strong>address bar</strong> and press <kbd>Enter</kbd>.
                                </li>
                                <li class="mb-2">
                                    <i class="align-middle fas fa-play-circle me-2"></i>Double-click the <strong>.exe</strong> file to run the material.
                                </li>
                            </ol>
                        </div>
                    </div>

                    <div class="alert alert-info d-flex align-items-start">
                        <i class="align-middle fas fa-shield-alt me-2 mt-1"></i>
                        <div>
                            <strong>Security tip:</strong> if Windows shows SmartScreen,
                            click <em>More info</em> &rarr; <em>Run anyway</em> (only if you trust the source).
                        </div>
                    </div>

                    <div class="accordion mt-3" id="helpAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                    <i class="align-middle fas fa-tools me-2"></i> Trouble opening the path?
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    <ul class="mb-0">
                                        <li class="mb-1"><i class="fas fa-network-wired me-2"></i> Check your network/VPN connection if the path is <code>\\server\...</code>.</li>
                                        <li class="mb-1"><i class="fas fa-user-shield me-2"></i> Request read permissions on the folder if needed.</li>
                                        <li class="mb-1"><i class="fas fa-folder me-2"></i> Confirm the <strong>.exe</strong> file exists at the given path.</li>
                                        <li class="mb-1"><i class="fas fa-sitemap me-2"></i> If the path is local to the server, ask IT for a shared UNC path.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <a class="btn btn-outline-secondary" href="@examUrl" title="Go to exam">
                            <i class="align-middle fas fa-check-circle me-1"></i> Go to exam
                        </a>

                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        function selectUrlPath() {
            const el = document.getElementById('matUrlPath');
            el.focus();
            el.select();
            el.setSelectionRange(0, el.value.length);
        }

        function copyMatUrlPath() {
            const el = document.getElementById('matUrlPath');
            selectUrlPath();
            const ok = document.execCommand('copy');
            const btn = document.getElementById('btnCopyPath');
            if (ok) {
                window.swalToast?.('Ruta copiada al portapapeles.', 'success');
                const old = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check me-1"></i> Copiado';
                setTimeout(() => btn.innerHTML = old, 1800);
            } else {
                window.swalToast?.('No se pudo copiar. Selecciona la ruta y presiona Ctrl+C.', 'danger');
            }
        }
    </script>
}
else
{
    <div class="alert alert-warning">
        <i class="align-middle fas fa-question-circle me-2"></i>
        Tipo de material no soportado: <strong>@(Model?.MaterialType ?? "—")</strong>. Contacta a RH.
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
})();
    </script>
}
