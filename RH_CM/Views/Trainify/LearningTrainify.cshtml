@model IEnumerable<RH_CM.ViewModels.LearningCourseToDoViewModel>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "My Learning";
    ViewData["BodyClass"] = "page-learning";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var first = Model?.FirstOrDefault();
    var courseGroups = Model?.GroupBy(m => m.CourseName).ToList()
                     ?? new List<IGrouping<string, RH_CM.ViewModels.LearningCourseToDoViewModel>>();

    string currentFilter = (ViewBag.RequiredFilter as string) ?? "REQUIRED";
    string filterBadge = currentFilter switch
    {
        "NOT_REQUIRED" => "Not Required",
        "ALL" => "All",
        _ => "Required"
    };
    var pageHelp = new RH_CM.ViewModels.PageHeaderViewModel
    {
        Title = "My Learning",
        HelpBullets = new List<string>
        {
            "Lists the courses assigned to you, filtered by Required / Not Required / All using the \"Filter Courses\" button.",
            "Click the play button on a row to start that course — it opens the diagnostic test, the material, and the final exam in order.",
            "The \"Learning information\" panel below explains what each column means in more detail."
        }
    };
}

<div class="row mb-2 mb-xl-3">
    <div class="col-auto ms-auto text-end mt-n1">
        <div class="dropdown me-2 d-inline-block">
            <a class="btn btn-light bg-white shadow-sm dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-display="static" title="Filter Courses">
                <i class="align-middle mt-n1" data-feather="filter"></i> Filter Courses
            </a>
            <div class="dropdown-menu dropdown-menu-end">
                <h6 class="dropdown-header">Select...</h6>
                <a class="dropdown-item" href="@Url.Action("LearningTrainify", new { requiredFilter = "REQUIRED" })">Required</a>
                <a class="dropdown-item" href="@Url.Action("LearningTrainify", new { requiredFilter = "NOT_REQUIRED" })">Not Required</a>
                <a class="dropdown-item" href="@Url.Action("LearningTrainify", new { requiredFilter = "ALL" })">All</a>
            </div>
        </div>

        <a class="btn btn-primary shadow-sm"
           href="@Url.Action("LearningTrainify", new { requiredFilter = currentFilter })"
           title="Refresh">
            <i class="align-middle" data-feather="refresh-cw">&nbsp;</i>
        </a>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">

            <div class="card-header bg-light border-bottom">
                <div class="d-flex align-items-center justify-content-center pt-2">
                    <h4 class="fw-bold title-accent mb-0">
                        <i class="fas fa-graduation-cap me-2"></i>My Learning
                    </h4>
                    <partial name="_PageHelpButton" model="pageHelp" />
                </div>
                @if (first != null)
                {
                    <div class="d-flex flex-column align-items-center text-center py-2">

                        <div class="mb-2">
                            <span class="badge bg-info">@filterBadge</span>
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-3 mt-3">

                            <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                <div class="text-muted fs-6">Control #</div>
                                <div class="fw-bold fs-4">@first.CONTROL_NUMBER</div>
                            </div>

                            <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                <div class="text-muted fs-6">Full Name</div>
                                <div class="fw-bold fs-4">@first.FullName</div>
                            </div>

                            <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                <div class="text-muted fs-6">Position</div>
                                <div class="fw-bold fs-4">@first.NAME_POSITION_ENGLISH</div>
                            </div>

                            <div class="px-3 py-2 border rounded bg-white shadow-sm text-center">
                                <div class="text-muted fs-6">Courses</div>
                                <div class="fw-bold fs-3 mt-2 d-flex justify-content-center">
                                    <div class="bg-primary text-white d-flex align-items-center justify-content-center"
                                         style="width: 90px; height: 60px; font-size: 1.7rem; border-radius: 10px;">
                                        @courseGroups.Count
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>

            <partial name="_PageHelpModal" model="pageHelp" />

            <div class="px-3 pt-2 d-flex justify-content-end">
                <button class="btn btn-outline-info btn-sm"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#learningInfoAlerts"
                        aria-expanded="false"
                        aria-controls="learningInfoAlerts" title="Learning information">
                    <i class="fas fa-info-circle"></i> Learning information
                </button>
            </div>

            <div class="collapse mb-3" id="learningInfoAlerts">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Learning</h5>
                        <h6 class="card-subtitle text-muted">
                            Description of employee information and available actions.
                        </h6>
                    </div>
                    <div class="card-body">

                        <div class="alert alert-success alert-outline alert-dismissible mb-3" role="alert">
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" title="Close"></button>
                            <div class="alert-icon">
                                <i class="fas fa-list-alt"></i>
                            </div>
                            <div class="alert-message">
                                <strong>Courses:</strong>
                                Total number of courses displayed according to the selected filter.
                            </div>
                        </div>

                        <div class="alert alert-primary alert-outline alert-dismissible mb-0" role="alert">
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" title="Close"></button>
                            <div class="alert-icon">
                                <i class="fas fa-play"></i>
                            </div>
                            <div class="alert-message">
                                <strong>Start:</strong>
                                Opens the selected course in a new browser tab using the assigned level and course assignment information.
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="card-body">

                @if (Model != null && Model.Any())
                {
                    <table id="datatables-learning" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                            <tr>
                                <th># Assign.</th>
                                <th># Course</th>
                                <th>Course</th>
                                <th># LevelId</th>
                                <th>Level</th>
                                <th>Delivery</th>
                                <th>Validity (days)</th>
                                <th>Status</th>
                                <th>Last update</th>
                                <th data-orderable="false">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.PK_CourseAssignment</td>
                                    <td>@item.FK_Course</td>
                                    <td>@item.CourseName</td>
                                    <td>@item.FK_RequiredCourseLevels</td>
                                    <td>@item.CourseLevel</td>
                                    <td>@item.DeliveryMode</td>
                                    <td>@(item.CourseValidityDays?.ToString() ?? "—")</td>
                                    <td>@item.CourseStatus</td>
                                    <td>@(item.LastUpdateDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td>
                                        <div class="text-center d-flex gap-1 justify-content-center">
                                            <a class="btn btn-primary"
                                               asp-controller="Catalog"
                                               asp-action="StartCourse"
                                               asp-route-courseId="@item.FK_Course"
                                               asp-route-levelId="@item.FK_RequiredCourseLevels"
                                               asp-route-courseAssignmentId="@item.PK_CourseAssignment"
                                               title="Start course"
                                               target="_blank" rel="noopener">
                                                <i class="fas fa-play"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#datatables-learning').DataTable({
                responsive: true,
                order: [[2, 'asc'], [4, 'asc']],
                columnDefs: [
                    { targets: [0, 1, 3], visible: false, searchable: false }
                ]
            });

});
    </script>
}
