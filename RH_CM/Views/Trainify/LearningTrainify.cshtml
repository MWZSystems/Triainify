@model IEnumerable<RH_CM.ViewModels.LearningCourseToDoViewModel>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Next required courses to do";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var first = Model?.FirstOrDefault();
    // Cuenta de cursos (distinct por nombre; si prefieres por FK_Course, cambia la key)
    var courseGroups = Model?.GroupBy(m => m.CourseName).ToList() ?? new List<IGrouping<string, RH_CM.ViewModels.LearningCourseToDoViewModel>>();
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="align-middle fas fa-graduation-cap"></i> @ViewData["Title"]
        </h1>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">

            <div class="card-header">
                @if (first != null)
                {
                    <div class="mb-3 text-center d-flex flex-wrap justify-content-center gap-3">
                        <div class="p-3 fw-bold rounded fs-3">
                            Control #: @first.CONTROL_NUMBER
                        </div>
                        <div class="p-3 fw-bold rounded fs-3">
                            Full name: @first.FullName
                        </div>
                        <div class="p-3 fw-bold rounded fs-3">
                            Position: @first.NAME_POSITION_ENGLISH
                        </div>
                        <div class="p-3 fw-bold rounded fs-3">
                            Courses: @courseGroups.Count
                        </div>
                    </div>
                }
                @* <h5 class="card-title mb-0">Matrix - @first?.UserName</h5> *@
            </div>

            <div class="card-body">

                @if (Model != null && Model.Any())
                {
                    <table id="datatables-learning" class="table table-striped table-hover" style="width:100%">
                        <thead class="table-primary">
                            <tr>
                                <th># Assign.</th>
                                <th>Course</th>
                                <th>Level</th>
                                <th>Delivery</th>
                                <th>Validity (days)</th>
                                <th>Status</th>
                                <th>Last update</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.PK_CourseAssignment</td>
                                    <td>@item.CourseName</td>
                                    <td>@item.CourseLevel</td>
                                    <td>@item.DeliveryMode</td>
                                    <td>@(item.CourseValidityDays?.ToString() ?? "—")</td>
                                    <td>@item.CourseStatus</td>
                                    <td>@(item.LastUpdateDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                    <td>
                                        <div class="text-center d-flex gap-1">
                                            <!-- Ajusta estas rutas según tus controladores/acciones reales -->
                                            <a class="btn btn-info"
                                               asp-controller="Catalog"
                                               asp-action="ViewCourse"
                                               asp-route-assignmentId="@item.PK_CourseAssignment"
                                               title="View course">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a class="btn btn-primary"
                                               asp-controller="Catalog"
                                               asp-action="StartCourse"
                                               asp-route-assignmentId="@item.PK_CourseAssignment"
                                               title="Start">
                                                <i class="fas fa-play"></i>
                                            </a>

                                            <a class="btn btn-outline-warning"
                                               asp-controller="Catalog"
                                               asp-action="TakeTest"
                                               asp-route-assignmentId="@item.PK_CourseAssignment"
                                               title="Take test">
                                                <i class="fas fa-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No records found</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $('#datatables-learning').DataTable({
                responsive: true,
                order: [[1, 'asc'], [2, 'asc']], // Course, Level
                language: {
                    "decimal": "",
                    "emptyTable": "No hay información",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ entradas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 entradas",
                    "infoFiltered": "(filtrado de _MAX_ entradas)",
                    "thousands": ",",
                    "lengthMenu": "Mostrar _MENU_ entradas",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "search": "Buscar:",
                    "zeroRecords": "Sin resultados encontrados",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });

            if ("@TempData["SuccessMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'success',
                    message: "@TempData["SuccessMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
            if ("@TempData["ErrorMessage"]" !== "") {
                window.notyf?.open?.({
                    type: 'error',
                    message: "@TempData["ErrorMessage"]",
                    ripple: true,
                    dismissible: true,
                    position: { x: 'center', y: 'top' },
                    duration: 5000
                });
            }
        });
    </script>
}
