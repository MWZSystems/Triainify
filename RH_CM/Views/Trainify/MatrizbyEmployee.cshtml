@model IEnumerable<RH_CM.ViewModels.MatrizByEmployeeViewModel>

@{
    ViewData["Title"] = "Matrix by Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Avoid null reference if Model is null
    var data = Model ?? Enumerable.Empty<RH_CM.ViewModels.MatrizByEmployeeViewModel>();

    var first = data.FirstOrDefault();

    var levelMap = data
        .GroupBy(m => m.FK_RequiredCourseLevels)
        .Select(g => new
        {
            Level = g.Key,
            Name = g.Select(x => x.DESCRIPCTION_LEVEL)
                    .FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? $"Level {g.Key}"
        })
        .OrderBy(x => x.Level)
        .ToList();

    var levels = levelMap.Select(x => x.Level).ToList();

    Func<string, string> badgeClass = (statusRaw) =>
    {
        var s = (statusRaw ?? "").Trim().ToUpperInvariant();
        return s switch
        {
            "SCHEDULED" => "bg-primary",
            "PERMANENTLY" => "bg-dark",
            "EXPIRING SOON" => "bg-warning",
            "PENDING" => "bg-danger",
            "COMPLETED" => "bg-success",
            _ => "bg-secondary"
        };
    };

    var courseGroups = data
        .GroupBy(x => new { x.FK_Course, x.CourseName })
        .OrderBy(g => g.Key.CourseName)
        .Select(g => new
        {
            CourseId = g.Key.FK_Course,
            CourseName = g.Key.CourseName,
            Cells = levels.Select(l =>
            {
                var cell = g.FirstOrDefault(r => r.FK_RequiredCourseLevels == l);
                if (cell == null)
                {
                    return new { Level = l, Status = "NO REQUIRED", Class = "bg-secondary" };
                }

                var status = (cell.CourseStatus ?? "").Trim();
                var cls = badgeClass(status);
                return new { Level = l, Status = status, Class = cls };
            }).ToList()
        })
        .ToList();

    var allCells = courseGroups.SelectMany(c => c.Cells).ToList();

    int cntScheduled = allCells.Count(s => s.Status.Equals("SCHEDULED", StringComparison.OrdinalIgnoreCase));
    int cntPermanently = allCells.Count(s => s.Status.Equals("PERMANENTLY", StringComparison.OrdinalIgnoreCase));
    int cntExpiringSoon = allCells.Count(s => s.Status.Equals("EXPIRING SOON", StringComparison.OrdinalIgnoreCase));
    int cntPending = allCells.Count(s => s.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase));
    int cntCompleted = allCells.Count(s => s.Status.Equals("COMPLETED", StringComparison.OrdinalIgnoreCase));
    int cntNoRequired = allCells.Count(s => s.Status.Equals("NO REQUIRED", StringComparison.OrdinalIgnoreCase));

    // Table summary
    int cntPermanentCompleted = cntPermanently + cntCompleted;

    // Chart summary only:
    // PERMANENTLY + COMPLETED + EXPIRING SOON
    // NO REQUIRED is excluded from chart
    int cntPermanentCompletedChart = cntPermanently + cntCompleted + cntExpiringSoon;
}

<div class="row">
    <div class="col-xl-12">
        <div class="row">

            <!-- MATRIX -->
            <div class="col-xl-8">
                <div class="card">
                    <div class="card-header bg-light border-bottom">

                        @if (first != null)
                        {
                            <div class="d-flex flex-column align-items-center text-center py-2">

                                <h4 class="fw-bold text-dark mb-1">
                                    <i class="fas fa-id-card-alt me-2 text-secondary"></i>
                                    MATRIX BY EMPLOYEE
                                </h4>

                                <div class="d-flex flex-wrap justify-content-center gap-3 mt-3">

                                    <!-- Control Number -->
                                    <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                        <div class="text-muted fs-6">Control #</div>
                                        <div class="fw-bold fs-4">@first.CONTROL_NUMBER</div>
                                    </div>

                                    <!-- Full Name -->
                                    <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                        <div class="text-muted fs-6">Full Name</div>
                                        <div class="fw-bold fs-4">
                                            @first.NAMES @first.LAST_NAME @first.SECOND_NAME
                                        </div>
                                    </div>

                                    <!-- Position -->
                                    <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                        <div class="text-muted fs-6">Position</div>
                                        <div class="fw-bold fs-4">@first.NAME_POSITION_ENGLISH</div>
                                    </div>

                                    <!-- Courses -->
                                    <div class="px-3 py-2 border rounded bg-white shadow-sm text-center">
                                        <div class="text-muted fs-6">Courses Required</div>

                                        <div class="fw-bold fs-3 mt-3 d-flex justify-content-center">
                                            <div class="bg-primary text-white d-flex align-items-center justify-content-center"
                                                 style="width: 90px; height: 60px; font-size: 1.7rem; border-radius: 10px;">
                                                @courseGroups.Count
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        @if (data.Any())
                        {
                            <table id="datatables-responsive" class="table table-striped">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Course</th>
                                        @foreach (var lm in levelMap)
                                        {
                                            <th>@lm.Name</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in courseGroups)
                                    {
                                        <tr>
                                            <td>@c.CourseName</td>

                                            @foreach (var cell in c.Cells)
                                            {
                                                <td>
                                                    @if (!cell.Status.Equals("SCHEDULED", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="badge @cell.Class">@cell.Status</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p>No data.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- SUMMARY + CHART + LEGEND -->
            <div class="col-xl-4">

                <!-- COURSE SUMMARY -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Course Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="py-3">
                            <div class="chart chart-xs">
                                <canvas id="chart-employee-summary"></canvas>
                            </div>
                        </div>
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th class="text-end">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <i class="fas fa-square-full text-success"></i> PERMANENTLY / COMPLETED
                                    </td>
                                    <td class="text-end">@cntPermanentCompleted</td>
                                </tr>
                                <tr>
                                    <td>
                                        <i class="fas fa-square-full" style="color:#ffc107;"></i> EXPIRING SOON
                                    </td>
                                    <td class="text-end">@cntExpiringSoon</td>
                                </tr>
                                <tr>
                                    <td>
                                        <i class="fas fa-square-full text-danger"></i> PENDING
                                    </td>
                                    <td class="text-end">@cntPending</td>
                                </tr>
                                <tr>
                                    <td>
                                        <i class="fas fa-square-full text-secondary"></i> NO REQUIRED
                                    </td>
                                    <td class="text-end">@cntNoRequired</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Toggle button for Status Legend -->
                <div class="d-flex justify-content-end mt-3 mb-1">
                    <button class="btn btn-outline-info btn-sm"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#statusLegendAlerts"
                            aria-expanded="false"
                            aria-controls="statusLegendAlerts">
                        <i class="fas fa-info-circle"></i> Status legend
                    </button>
                </div>

                <!-- Status Legend -->
                <div class="collapse mb-3" id="statusLegendAlerts">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Status legend</h5>
                            <h6 class="card-subtitle text-muted">
                                Description of course status colors and how they are grouped in the summary chart.
                            </h6>
                        </div>
                        <div class="card-body">

                            <div class="alert alert-success alert-outline alert-dismissible mb-3" role="alert">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                <div class="alert-icon">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <div class="alert-message">
                                    <strong>PERMANENTLY / COMPLETED:</strong>
                                    In the chart, this group includes <strong>PERMANENTLY</strong>, <strong>COMPLETED</strong>, and <strong>EXPIRING SOON</strong>.
                                </div>
                            </div>

                            <div class="alert alert-danger alert-outline alert-dismissible mb-3" role="alert">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                <div class="alert-icon">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                                <div class="alert-message">
                                    <strong>PENDING:</strong>
                                    The course is overdue or has not been completed yet. Immediate attention is required.
                                </div>
                            </div>

                            <div class="alert alert-warning alert-outline alert-dismissible mb-3" role="alert">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                <div class="alert-icon">
                                    <i class="fas fa-hourglass-half"></i>
                                </div>
                                <div class="alert-message">
                                    <strong>EXPIRING SOON:</strong>
                                    This status remains visible in the table, but it is grouped into <strong>PERMANENTLY / COMPLETED</strong> in the chart.
                                </div>
                            </div>

                            <div class="alert alert-secondary alert-outline alert-dismissible mb-0" role="alert">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                <div class="alert-icon">
                                    <i class="fas fa-minus-circle"></i>
                                </div>
                                <div class="alert-message">
                                    <strong>NO REQUIRED:</strong>
                                    This status is shown in the table, but it is excluded from the chart.
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(function () {
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                pageLength: 50,
                lengthMenu: [[10, 25, 50, 100, -1],
                             [10, 25, 50, 100, "All"]]
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById("chart-employee-summary");
            new Chart(ctx, {
                type: "pie",
                data: {
                    labels: ["PERMANENTLY / COMPLETED", "PENDING"],
                    datasets: [{
                        data: [@cntPermanentCompletedChart, @cntPending],
                        backgroundColor: ["#198754", "#dc3545"],
                        borderWidth: 5,
                        borderColor: "#ffffff"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "70%",
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}