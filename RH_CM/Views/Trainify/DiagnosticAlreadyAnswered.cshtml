@{
    ViewData["Title"] = "Diagnostic already answered today";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var hasMaterial = (bool)(ViewBag.HasMaterial ?? false);
    var courseId = ViewBag.CourseId as int? ?? 0;
    var levelId = ViewBag.LevelId as int? ?? 0;
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="alert alert-info">
            You already answered today's diagnostic for this course/level.
        </div>

        <div class="card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">Next step: Course Material</div>
                    <div class="text-muted small">CourseId: @courseId | LevelId: @levelId</div>
                </div>

                @if (hasMaterial && courseId > 0 && levelId > 0)
                {
                    <!-- IMPORTANTE: ir a la VISTA con el componente Blazor -->
                    <a class="btn btn-success"
                       asp-controller="Catalog"
                       asp-action="OpenPdfCourseMaterialByCourseLevel"
                       asp-route-courseId="@courseId"
                       asp-route-levelId="@levelId">
                        <i class="fas fa-arrow-right"></i> Continue
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary" disabled>
                        <i class="fas fa-ban"></i> Continue
                    </button>
                    <span class="text-danger ms-2 small">
                        Course material is not available. Please contact HR.
                    </span>
                }
            </div>
        </div>
    </div>
</div>
