@{
    ViewData["Title"] = "Diagnostic already answered today";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var hasMaterial = (bool)(ViewBag.HasMaterial ?? false);
    var courseId = ViewBag.CourseId as int? ?? 0;
    var levelId = ViewBag.LevelId as int? ?? 0;
    var assignmentId = ViewBag.CourseAssignmentId as int? ?? 0;
}

<div class="row">
    <div class="col-md-8 offset-md-2">

        <!-- ALERTA: info outline-coloured (sin botón de cerrar) -->
        <div class="alert alert-info alert-outline-coloured" role="alert" aria-live="polite">
            <div class="alert-icon">
                <i class="far fa-fw fa-bell"></i>
            </div>
            <div class="alert-message">
                <strong>Your diagnostic is Ready!</strong> You already answered today's diagnostic for this course/level.
            </div>
        </div>


        <div class="card">
            <div class="card-body d-flex justify-content-between align-items-center">

                <div>
                    <div class="alert alert-info" role="alert">
                        <div class="alert-message">
                            Next step: Course Material. If you want to continue with your course process, please click Continue.
                        </div>
                    </div>

                    <!-- Badges con colores solicitados -->
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-primary me-1">Course ID: @courseId</span>
                        <span class="badge bg-info text-dark me-1">Level ID: @levelId</span>
                        <span class="badge bg-warning text-dark">
                            Assignment ID: @(assignmentId > 0 ? assignmentId.ToString() : "—")
                        </span>
                    </div>

                </div>


                @if (hasMaterial && courseId > 0 && levelId > 0)
                {
                    <!-- IMPORTANTE: ir a la VISTA con el componente Blazor -->
                    <a class="btn btn-success"
                       asp-controller="Catalog"
                       asp-action="OpenPdfCourseMaterialByCourseLevel"
                       asp-route-courseId="@courseId"
                       asp-route-levelId="@levelId"
                       asp-route-courseAssignmentId="@(assignmentId)">
                        <i class="fas fa-arrow-right"></i> Continue
                    </a>
                }
                else
                {
                    <div class="d-flex align-items-center">
                        <button class="btn btn-secondary" disabled>
                            <i class="fas fa-ban"></i> Continue
                        </button>
                        <span class="text-danger ms-2 small">
                            Course material is not available. Please contact HR.
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
