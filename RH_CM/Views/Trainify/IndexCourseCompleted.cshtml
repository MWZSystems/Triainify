@model IEnumerable<dynamic>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Course Completions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row align-items-center mb-3">
    <div class="col">
        <h1 class="h3 mb-0 text-center text-md-start">
            <i class="fas fa-list-check"></i> @ViewData["Title"]
        </h1>
    </div>
    <div class="col-auto d-flex gap-2">
        <a asp-action="CreateCourseCompleted" class="btn btn-primary" title="Create New Course Completed">
            <i class="fas fa-plus"></i> CREATE NEW COURSE COMPLETED
        </a>
    </div>
</div>

<!-- Loader -->
<div id="loader" class="text-center my-5">
    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Tabla envuelta en contenedor oculto -->
<div id="tableContainer" style="display:none;">
    <div class="card">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <table id="tbl-coursecompleted" class="table table-striped table-hover" style="width:100%">
                    <thead class="table-accent">
                        <tr>
                            <th>#</th>
                            <th>Assignment</th>
                            <th>Status</th>
                            <th>Delivery Mode</th>
                            <th>Employee</th>
                            <th>Control #</th>
                            <th>Created</th>
                            <th>Updated</th>
                            <th data-orderable="false">Actions</th>
                        </tr>
                    </thead>

                    <!-- Filtros por columna -->
                    <tfoot>
                        <tr>
                            <th>#</th>
                            <th>Assignment</th>
                            <th>Status</th>
                            <th>Delivery Mode</th>
                            <th>Employee</th>
                            <th>Control #</th>
                            <th>Created</th>
                            <th>Updated</th>
                            <th></th>
                        </tr>
                    </tfoot>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td>@x.PkCourseCompleted</td>
                                <td>@x.FkCourseAssignment</td>
                                <td>@x.StatusName</td>
                                <td>@x.DeliveryName</td>
                                <td>@x.HeadcountName</td>
                                <td>@x.ControlNumber</td>
                                <td>@(((DateTime)x.CreateDate).ToString("yyyy-MM-dd HH:mm"))</td>
                                <td>@(((DateTime)x.LastUpdateDate).ToString("yyyy-MM-dd HH:mm"))</td>
                                <td class="text-nowrap">
                                    <a asp-action="EditCourseCompleted" asp-route-id="@x.PkCourseCompleted" class="btn btn-warning btn-sm" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                                    {
                                        <form asp-action="DeleteCourseCompleted" asp-route-id="@x.PkCourseCompleted" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this course completion?');">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="mb-0">No records found</p>
            }

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Hide the table and show the loader
            $('#tableContainer').hide();
            $('#loader').show();

            // Colocar inputs/selects en el footer ANTES de inicializar DataTable
            // Índices: 0:#, 1:Assignment, 2:Status, 3:Delivery Mode, 4:Employee, 5:Control #, 6:Created, 7:Updated, 8:Actions
            $('#tbl-coursecompleted tfoot th').each(function (i) {
                switch (i) {
                    case 1: // Assignment (text)
                    case 4: // Employee (text)
                    case 5: // Control # (text)
                        $(this).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + $('thead th').eq(i).text() + '" />');
                        break;

                    case 2: // Status (dynamic select)
                        $(this).html('<select id="statusFilter" class="form-select form-select-sm"><option value="">(All)</option></select>');
                        break;

                    case 3: // Delivery Mode (dynamic select)
                        $(this).html('<select id="deliveryFilter" class="form-select form-select-sm"><option value="">(All)</option></select>');
                        break;

                    // Optional: free-text date filters (can be swapped for datepickers if needed)
                    case 6: // Created
                    case 7: // Updated
                        $(this).html('<input type="text" class="form-control form-control-sm" placeholder="YYYY-MM-DD" />');
                        break;

                    default: // # and Actions, no filter
                        $(this).html('');
                        break;
                }
            });

            // Initialize DataTable (English, consistent with the rest of the app)
            var table = $('#tbl-coursecompleted').DataTable({
                responsive: true,
                order: [[0, 'desc']],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1],[10, 25, 50, 100, "All"]],
                initComplete: function () {
                    var api = this.api();

                    // 1) Text inputs (Assignment, Employee, Control #)
                    [1, 4, 5].forEach(function (colIdx) {
                        $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                            if (api.column(colIdx).search() !== this.value) {
                                api.column(colIdx).search(this.value).draw();
                            }
                        });
                    });

                    // 2) Date filters (free text, matches by YYYY-MM-DD prefix)
                    [6, 7].forEach(function (colIdx) {
                        $('tfoot th').eq(colIdx).find('input').on('keyup change clear', function () {
                            var val = this.value;
                            // Simple search by "YYYY-MM-DD" date prefix
                            api.column(colIdx).search(val).draw();
                        });
                    });

                    // 3) Dynamic select for Status (exact match)
                    var statusColumn = api.column(2);
                    var $statusSelect = $('#statusFilter');
                    var statusValues = [];
                    statusColumn.data().each(function (d) {
                        if (d && statusValues.indexOf(d) === -1) statusValues.push(d);
                    });
                    statusValues.sort().forEach(function (val) {
                        var esc = $.fn.dataTable.util.escapeRegex(val);
                        $statusSelect.append('<option value="^' + esc + '$">' + val + '</option>');
                    });
                    $statusSelect.on('change', function () {
                        statusColumn.search(this.value, true, false).draw();
                    });

                    // 4) Dynamic select for Delivery Mode (exact match)
                    var deliveryColumn = api.column(3);
                    var $deliverySelect = $('#deliveryFilter');
                    var deliveryValues = [];
                    deliveryColumn.data().each(function (d) {
                        if (d && deliveryValues.indexOf(d) === -1) deliveryValues.push(d);
                    });
                    deliveryValues.sort().forEach(function (val) {
                        var esc = $.fn.dataTable.util.escapeRegex(val);
                        $deliverySelect.append('<option value="^' + esc + '$">' + val + '</option>');
                    });
                    $deliverySelect.on('change', function () {
                        deliveryColumn.search(this.value, true, false).draw();
                    });

                    // Hide the loader and show the table once DataTable is ready
                    $('#loader').fadeOut(150, function () {
                        $('#tableContainer').fadeIn(150);
                    });
                }
            });

            // Notificaciones
});
    </script>
}
