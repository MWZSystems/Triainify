@model RH_CM.ViewModels.SubmitTestViewModel
@{
    ViewBag.HideNavbar = true;
    ViewData["Title"] = "Answer Exam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">@Model.TestName</h1>
        <p class="text-center text-muted">Please answer the following questions.</p>

        <div class="text-center">
            @if (Model.NextCourseId > 0)
            {
                <span class="badge bg-primary me-1">Course ID: @Model.NextCourseId</span>
            }
            @if (Model.NextLevelId > 0)
            {
                <span class="badge bg-info text-dark me-1">Level ID: @Model.NextLevelId</span>
            }
            <span class="badge bg-warning text-dark">
                Assignment ID: @(Model.CourseAssignmentId > 0 ? Model.CourseAssignmentId.ToString() : "—")
            </span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card border-primary">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Exam</h5>
            </div>
            <div class="card-body">
                <form id="examForm" asp-action="SubmitExam" asp-controller="Trainify" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="FkTest" />
                    <input type="hidden" asp-for="NextCourseId" />
                    <input type="hidden" asp-for="NextLevelId" />
                    <input type="hidden" asp-for="CourseAssignmentId" />

                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var q = Model.Questions[i];
                        var groupName = $"q{i}_single";
                        <div class="card mb-3 shadow-sm question-card" data-q="@i">
                            <div class="card-body">
                                <h5 class="mb-3">
                                    Q@(i + 1). @q.QuestionText
                                    @if (q.IsMultiple)
                                    {
                                        <span class="badge bg-info ms-2">Multiple choice</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-2">Single choice</span>
                                    }
                                </h5>

                                <input type="hidden" name="Questions[@i].FkQuestion" value="@q.FkQuestion" />
                                <input type="hidden" name="Questions[@i].IsMultiple" value="@(q.IsMultiple.ToString().ToLower())" />
                                <input type="hidden" name="Questions[@i].QuestionText" value="@q.QuestionText" />

                                <div class="vstack gap-2">
                                    @for (int j = 0; j < q.Options.Count; j++)
                                    {
                                        var o = q.Options[j];
                                        <div class="form-check d-flex align-items-center p-2 border rounded">
                                            <input type="hidden"
                                                   id="isSel_@(i)_@(j)"
                                                   class="is-sel"
                                                   data-q="@i"
                                                   name="Questions[@i].Options[@j].IsSelected"
                                                   value="false" />
                                            <input type="hidden" name="Questions[@i].Options[@j].FkOption" value="@o.FkOption" />
                                            <input type="hidden" name="Questions[@i].Options[@j].OptionText" value="@o.OptionText" />

                                            @if (q.IsMultiple)
                                            {
                                                <input class="form-check-input me-2 opt-checkbox"
                                                       type="checkbox"
                                                       data-q="@i"
                                                       data-j="@j"
                                                       id="chk_q@(i)_o@(j)" />
                                                <label class="form-check-label w-100" for="chk_q@(i)_o@(j)">@o.OptionText</label>
                                            }
                                            else
                                            {
                                                <input class="form-check-input me-2 opt-radio"
                                                       type="radio"
                                                       name="@groupName"
                                                       data-q="@i"
                                                       data-j="@j"
                                                       id="rad_q@(i)_o@(j)" />
                                                <label class="form-check-label w-100" for="rad_q@(i)_o@(j)">@o.OptionText</label>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Feedback por pregunta -->
                                <div class="invalid-feedback d-block mt-2" style="display:none;">
                                    Please select at least one option for this question.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="text-end">
                        <a asp-action="LearningTrainify" asp-controller="Trainify" class="btn btn-secondary" title="Cancel">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                        <button id="btnSubmit" type="submit" class="btn btn-primary" title="Submit">
                            <i class="fas fa-paper-plane"></i> Submit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Keeps the hidden IsSelected fields in sync (existing logic)
        document.addEventListener('change', function (e) {
            if (e.target && e.target.classList.contains('opt-checkbox')) {
                const q = e.target.getAttribute('data-q');
                const j = e.target.getAttribute('data-j');
                const hidden = document.getElementById(`isSel_${q}_${j}`);
                if (hidden) hidden.value = e.target.checked ? "true" : "false";
            }
        });
        document.addEventListener('change', function (e) {
            if (e.target && e.target.classList.contains('opt-radio')) {
                const q = e.target.getAttribute('data-q');
                const j = e.target.getAttribute('data-j');
                document.querySelectorAll(`input.is-sel[data-q="${q}"]`).forEach(h => h.value = "false");
                const hidden = document.getElementById(`isSel_${q}_${j}`);
                if (hidden) hidden.value = "true";
            }
        });

        // ===== Validation: every question must have at least one selection =====
        (function () {
            const form = document.getElementById('examForm');
            const submitBtn = document.getElementById('btnSubmit');

            function isQuestionAnswered(qIndex) {
                // radios in the group
                const radioChecked = document.querySelector(`input.opt-radio[name="q${qIndex}_single"]:checked`);
                if (radioChecked) return true;
                // checkboxes with data-q
                const anyCheckboxChecked = document.querySelector(`input.opt-checkbox[data-q="${qIndex}"]:checked`);
                if (anyCheckboxChecked) return true;
                return false;
            }

            function clearQuestionError(card) {
                card.classList.remove('border-danger');
                const fb = card.querySelector('.invalid-feedback');
                if (fb) fb.style.display = 'none';
            }

            function setQuestionError(card) {
                card.classList.add('border-danger');
                const fb = card.querySelector('.invalid-feedback');
                if (fb) fb.style.display = 'block';
            }

            // When an option changes, clear that question's error if it's now answered
            document.addEventListener('change', function (e) {
                const card = e.target.closest('.question-card');
                if (!card) return;
                const qIndex = card.getAttribute('data-q');
                if (isQuestionAnswered(qIndex)) {
                    clearQuestionError(card);
                }
            });

            form.addEventListener('submit', function (e) {
                // Recorre todas las preguntas
                const cards = Array.from(document.querySelectorAll('.question-card'));
                let firstInvalid = null;

                cards.forEach(card => {
                    const qIndex = card.getAttribute('data-q');
                    if (!isQuestionAnswered(qIndex)) {
                        setQuestionError(card);
                        if (!firstInvalid) firstInvalid = card;
                    } else {
                        clearQuestionError(card);
                    }
                });

                if (firstInvalid) {
                    e.preventDefault();
                    // Scroll y foco amable
                    firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    const firstInput = firstInvalid.querySelector('input.opt-radio, input.opt-checkbox');
                    if (firstInput) setTimeout(() => firstInput.focus(), 250);

                    // Opcional: toast/alert general
                    window.swalToast?.('Please answer every question before submitting.', 'danger');
                } else {
                    // Prevent accidental double submissions while the atomic server-side save runs.
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Recording...';
                }
            });
        })();
    </script>
}
