@model RH_CM.ViewModels.CourseMaterialViewerViewModel

@{
    ViewData["Title"] = "Course Material";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="fas fa-file-pdf"></i> Course Material
        </h1>

        <div class="text-center mb-2">
            <span class="badge bg-primary me-1">Course ID: @Model.CourseId</span>
            <span class="badge bg-info">Level ID: @Model.LevelId</span>
        </div>

        <div class="text-center mb-3">
            <a class="btn btn-outline-secondary"
               href="@Model.StreamUrl"
               target="_blank" rel="noopener">
                Open in new tab
            </a>
            <a class="btn btn-outline-primary"
               href="@Url.Action("LearningTrainify", "Trainify")">
                Back to Learning
            </a>
        </div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(Model?.StreamUrl))
{
    <div class="alert alert-warning">No se pudo construir la URL del material.</div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="border rounded shadow-sm p-2">
                <!-- Invoca el componente Razor de Blazor desde la vista MVC -->
                <component type="typeof(RH_CM.Components.CoursePdfViewer)"
                           render-mode="ServerPrerendered"
                           param-PdfUrl="@(Model.StreamUrl)" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        if ('@TempData["SuccessMessage"]' !== '') {
            window.notyf?.open({ type: 'success', message: '@TempData["SuccessMessage"]', duration: 5000 });
        }
        if ('@TempData["ErrorMessage"]' !== '') {
            window.notyf?.open({ type: 'error', message: '@TempData["ErrorMessage"]', duration: 5000 });
        }
    </script>
}
