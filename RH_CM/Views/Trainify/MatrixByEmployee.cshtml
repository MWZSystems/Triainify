@model IEnumerable<RH_CM.ViewModels.MatrizByEmployeeViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Matrix";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var data = Model ?? Enumerable.Empty<RH_CM.ViewModels.MatrizByEmployeeViewModel>();
    var first = data.FirstOrDefault();

    string mode = (ViewBag.Mode as string) ?? "EMPLOYEE";
    int? selectedPositionId = ViewBag.SelectedPositionId as int?;
    var positions = (IEnumerable<SelectListItem>)(ViewBag.Positions ?? new List<SelectListItem>());

    var levelMap = data
        .GroupBy(m => m.FK_RequiredCourseLevels)
        .Select(g => new
        {
            Level = g.Key,
            Name = g.Select(x => x.DESCRIPCTION_LEVEL)
                    .FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? $"Level {g.Key}"
        })
        .OrderBy(x => x.Level)
        .ToList();

    var levels = levelMap.Select(x => x.Level).ToList();

    Func<string, string> badgeClass = (statusRaw) =>
    {
        var s = (statusRaw ?? "").Trim().ToUpperInvariant();
        return s switch
        {
            "SCHEDULED" => "bg-primary",
            "PERMANENTLY" => "bg-dark",
            "EXPIRING SOON" => "bg-warning text-dark",
            "PENDING" => "bg-danger",
            "COMPLETED" => "bg-success",
            "NO REQUIRED" => "bg-secondary",
            "NO ASSIGNED" => "bg-light text-dark border",
            _ => "bg-secondary"
        };
    };

    var courseGroups = data
        .GroupBy(x => new { x.FK_Course, x.CourseName })
        .OrderBy(g => g.Key.CourseName)
        .Select(g => new
        {
            CourseId = g.Key.FK_Course,
            CourseName = g.Key.CourseName,
            Cells = levels.Select(l =>
            {
                var cell = g.FirstOrDefault(r => r.FK_RequiredCourseLevels == l);
                if (cell == null)
                {
                    return new { Level = l, Status = "NO ASSIGNED", Class = "bg-light text-dark border" };
                }

                var status = (cell.CourseStatus ?? "").Trim();
                var cls = badgeClass(status);
                return new { Level = l, Status = status, Class = cls };
            }).ToList()
        })
        .ToList();

    var allCells = courseGroups.SelectMany(c => c.Cells).ToList();

    int cntPermanently = allCells.Count(s => s.Status.Equals("PERMANENTLY", StringComparison.OrdinalIgnoreCase));
    int cntExpiringSoon = allCells.Count(s => s.Status.Equals("EXPIRING SOON", StringComparison.OrdinalIgnoreCase));
    int cntPending = allCells.Count(s => s.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase));
    int cntCompleted = allCells.Count(s => s.Status.Equals("COMPLETED", StringComparison.OrdinalIgnoreCase));

    int cntPermanentCompleted = cntPermanently + cntCompleted + cntExpiringSoon;

    int coursesNeedingAttention = courseGroups.Count(c =>
        c.Cells.Any(cell =>
            cell.Status.Equals("PENDING", StringComparison.OrdinalIgnoreCase) ||
            cell.Status.Equals("EXPIRING SOON", StringComparison.OrdinalIgnoreCase)
        )
    );

    string pageTitle = mode == "POSITION" ? "MATRIX BY POSITION" : "MATRIX BY EMPLOYEE";
}

@* <div class="row mb-3">
    <div class="col">
        <h1 class="h3 mb-3 text-center">
            <i class="fas fa-table me-2"></i>@pageTitle
        </h1>
    </div>
</div> *@

<div class="row">
    <div class="col-xl-12">
        <div class="row">

            <div class="col-xl-8">
                <div class="card">
                    <div class="card-header bg-light border-bottom">
                        @if (first != null)
                        {
                            <div class="d-flex flex-column align-items-center text-center py-2">
                                <h4 class="fw-bold text-dark mb-1">
                                    <i class="fas fa-id-card-alt me-2 text-secondary"></i>
                                    @pageTitle
                                </h4>

                                <div class="d-flex flex-wrap justify-content-center gap-3 mt-3">

                                    @if (mode == "EMPLOYEE")
                                    {
                                        <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                            <div class="text-muted fs-6">Control #</div>
                                            <div class="fw-bold fs-4">@first.CONTROL_NUMBER</div>
                                        </div>

                                        <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                            <div class="text-muted fs-6">Full Name</div>
                                            <div class="fw-bold fs-4">
                                                @first.NAMES @first.LAST_NAME @first.SECOND_NAME
                                            </div>
                                        </div>
                                    }

                                    <div class="px-3 py-2 border rounded bg-white shadow-sm text-start">
                                        <div class="text-muted fs-6">Position</div>
                                        <div class="fw-bold fs-4">@first.NAME_POSITION_ENGLISH</div>
                                    </div>

                                    <div class="px-3 py-2 border rounded bg-white shadow-sm text-center">
                                        <div class="text-muted fs-6">Courses Needing Attention</div>
                                        <div class="fw-bold fs-3 mt-3 d-flex justify-content-center">
                                            <div class="bg-danger text-white d-flex align-items-center justify-content-center rounded"
                                                 style="width: 90px; height: 60px;">
                                                @coursesNeedingAttention
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        @if (data.Any())
                        {
                            <table id="datatables-responsive" class="table table-striped">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Course</th>
                                        @foreach (var lm in levelMap)
                                        {
                                            <th>@lm.Name</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in courseGroups)
                                    {
                                        <tr>
                                            <td>@c.CourseName</td>
                                            @foreach (var cell in c.Cells)
                                            {
                                                <td>
                                                    @if (!cell.Status.Equals("SCHEDULED", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="badge @cell.Class">@cell.Status</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p>No data.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Course Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="py-3">
                            <div class="chart chart-xs">
                                <canvas id="chart-employee-summary"></canvas>
                            </div>
                        </div>
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th class="text-end">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><i class="fas fa-square-full text-success"></i> PERMANENTLY / COMPLETED</td>
                                    <td class="text-end">@cntPermanentCompleted</td>
                                </tr>
                                <tr>
                                    <td><i class="fas fa-square-full text-danger"></i> PENDING</td>
                                    <td class="text-end">@cntPending</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrador"))
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">View Options</h5>
                        </div>
                        <div class="card-body">
                            <form method="get" asp-action="MatrixByEmployee" id="matrixViewOptionsForm">
                                <div class="mb-3">
                                    <label class="form-label">Mode</label>
                                    <select class="form-control" name="mode" id="modeSelector">
                                        <option value="EMPLOYEE" selected="@(mode == "EMPLOYEE")">Employee</option>
                                        <option value="POSITION" selected="@(mode == "POSITION")">Position</option>
                                    </select>
                                </div>

                                <div class="mb-3" id="positionContainer" style="display:@(mode == "POSITION" ? "block" : "none")">
                                    <label class="form-label">Position</label>
                                    <select class="form-control select2" name="fkPosition" id="fkPosition">
                                        <option value="">-- Select Position --</option>
                                        @foreach (var p in positions)
                                        {
                                            <option value="@p.Value" selected="@(selectedPositionId?.ToString() == p.Value)">@p.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i> Load
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-end mt-3 mb-1">
                    <button class="btn btn-outline-info btn-sm"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#statusLegendAlerts">
                        <i class="fas fa-info-circle"></i> Status legend
                    </button>
                </div>

                <div class="collapse mb-3" id="statusLegendAlerts">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Status legend</h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-success alert-outline mb-3">
                                <strong>PERMANENTLY / COMPLETED:</strong>
                                Includes PERMANENTLY, COMPLETED, and EXPIRING SOON in the summary and chart.
                            </div>
                            <div class="alert alert-danger alert-outline mb-3">
                                <strong>PENDING:</strong>
                                The course is overdue or has not been completed yet.
                            </div>
                            <div class="alert alert-warning alert-outline mb-3">
                                <strong>EXPIRING SOON:</strong>
                                Visible in the matrix, grouped in summary.
                            </div>
                            <div class="alert alert-secondary alert-outline mb-3">
                                <strong>NO REQUIRED:</strong>
                                Assigned to the employee/position, but not required.
                            </div>
                            <div class="alert alert-light border mb-0">
                                <strong>NO ASSIGNED:</strong>
                                The course level is shown to complete the matrix, but is not assigned.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(function () {
            $('#datatables-responsive').DataTable({
                responsive: true,
                order: [],
                pageLength: 50,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]]
            });

            // Select2
            $('.select2').select2({
                theme: 'bootstrap4',
                placeholder: 'Select an option',
                allowClear: true
            });

            $('#modeSelector').on('change', function () {
                const isPosition = $(this).val() === 'POSITION';
                $('#positionContainer').toggle(isPosition);

                if (!isPosition) {
                    $('#fkPosition').val(null).trigger('change');
                }
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById("chart-employee-summary");
            new Chart(ctx, {
                type: "pie",
                data: {
                    labels: ["PERMANENTLY / COMPLETED", "PENDING"],
                    datasets: [{
                        data: [@cntPermanentCompleted, @cntPending],
                        backgroundColor: ["#198754", "#dc3545"],
                        borderWidth: 5,
                        borderColor: "#ffffff"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "70%",
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}