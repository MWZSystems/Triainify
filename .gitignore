# Carpeta de configuración de Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Salida de compilación
bin/
obj/

# Archivos de depuración y símbolos
*.pdb
*.mdb

# Archivos temporales
*.tmp
*.temp
*.log
*.bak

# Archivos generados por compilación
*.dll
*.exe
*.cache
*.csproj.FileListAbsolute.txt
*.AssemblyReference.cache
*.CoreCompileInputs.cache
*.g.cs
*.g.i.cs
*.GeneratedMSBuildEditorConfig.editorconfig
*.genruntimeconfig.cache
*.assets.cache
*.props
*.nuget.cache
*.dswa.cache.json
*.build.endpoints.json
*.upToDateCheck.txt
*.vsidx
*.json.cache

# Archivos generados por herramientas
*.nupkg
*.snupkg

# Configuraciones locales
appsettings.Development.json
launchSettings.json

# Archivos de Rider/JetBrains (si usas Rider)
.idea/
*.sln.iml

# Archivos generados por Razor
**/obj/**/*.cshtml.cs
**/obj/**/*.razor.g.cs
**/obj/**/*.razor.g.i.cs
