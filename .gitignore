# Archivos y carpetas de usuario de Visual Studio
.vs/
*.user
*.suo

# Archivos de build y publicación
/bin/
/obj/

# Archivos generados por Razor
**/Generated/
**/*.g.cs
**/*.g.i.cs

# Archivos de configuración temporales
appsettings.Development.json
appsettings.*.json

# Archivos de cache y dependencias de NuGet
project.lock.json
project.fragment.lock.json
*.nuget.cache
*.nupkg
*.snupkg

# Archivos temporales del sistema operativo
*.tmp
*.temp
*.log
*.DS_Store
Thumbs.db

# Archivos generados por VS Code
.vscode/

# Archivos de configuración específicos del entorno
launchSettings.json

# Archivos de rastreo de ejecución o debugging
*.pdb

# Archivos generados en tiempo de ejecución
*.vsidx
*.cache
*.db

# Archivos de configuración de WebAssembly y Static Assets
**/staticwebassets.*

# Archivos temporales de análisis de código
*.ide

# Ignorar certificados de desarrollo
*.pem
*.crt
*.key

# Excluir dlls generadas y cualquier archivo ejecutable
*.dll
*.exe
*.ref

# Opcional: si estás usando Rider o JetBrains
.idea/
*.sln.iml
